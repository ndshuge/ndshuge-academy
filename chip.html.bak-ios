<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🐭 鼠哥的芯片战争读书学院 🧠 · 已授 36 章</title>
<style>
:root{
  --bg:#F5EFE4; --card:#FBF7EE; --ink:#2A2622; --ink2:#4A433C; --muted:#6B6158;
  --blue:#537D96; --blue2:#3F6179; --blue-bg:rgba(83,125,150,.08);
  --green:#4A6B4A; --red:#8B2C1F; --orange:#9D5F4D;
  --line:#D8CFBE; --shadow:0 2px 12px rgba(80,70,50,.08);
  --radius:14px;
}
*{box-sizing:border-box; margin:0; padding:0}
html,body{height:100%}
body{
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro SC', 'PingFang SC', 'Segoe UI', 'Microsoft YaHei', sans-serif;
  background: var(--bg);
  color:var(--ink); line-height:1.7; -webkit-font-smoothing:antialiased;
}
#app{display:flex; min-height:100vh}
#side{
  width:300px; flex-shrink:0; background:rgba(251,247,238,.75);
  backdrop-filter:saturate(180%) blur(20px); -webkit-backdrop-filter:saturate(180%) blur(20px);
  color:#2A2622; padding:28px 20px; display:flex; flex-direction:column; gap:16px;
  position:sticky; top:0; height:100vh; overflow-y:auto;
  border-right:1px solid var(--line);
  transition:width .45s cubic-bezier(.4,0,.2,1), padding .45s cubic-bezier(.4,0,.2,1);
  overflow-x:hidden;
}
#side.collapsed{width:42px; padding:16px 6px}
#side.collapsed > *:not(#sideToggle){display:none}
/* 折叠/展开错峰动画：文字显隐与宽度变化分开，避免挤压重排 */
#side.fading-out > *:not(#sideToggle){opacity:0; transition:opacity .15s ease}
#side.hidden > *:not(#sideToggle){opacity:0; transition:none}
#side.fading > *:not(#sideToggle){opacity:1; transition:opacity .25s ease .05s}
#sideToggle{width:30px; height:30px; border-radius:50%; border:none; background:linear-gradient(135deg,#537D96,#3F6179); color:#fff; cursor:pointer; font-size:15px; margin:0 auto; flex-shrink:0; font-family:Georgia,serif; box-shadow:0 3px 8px rgba(83,125,150,.35); transition:.2s; line-height:1}
#sideToggle:hover{transform:scale(1.12); box-shadow:0 5px 16px rgba(83,125,150,.5)}
.side-btn{margin-top:6px; border:1px solid; background:transparent; border-radius:980px; padding:9px 14px; font-family:inherit; font-size:13px; cursor:pointer; letter-spacing:.5px; font-weight:500; transition:.2s}
.side-btn:hover{background:var(--blue-bg); transform:translateY(-1px)}
#side .seal{
  width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#537D96,#3F6179);margin:0 auto 6px;
  display:flex;align-items:center;justify-content:center;font-size:26px;color:#fff;
  box-shadow:0 4px 14px rgba(83,125,150,.35);
}
#side h1{font-family:Georgia,'Songti SC',serif; font-size:23px; text-align:center; letter-spacing:.5px; color:#2A2622; line-height:1.4; font-weight:600}
#side h1 small{display:block; font-size:11px; color:#86868b; letter-spacing:1px; font-weight:500; margin-top:3px}
#side .divider{height:1px; background:var(--line); margin:2px 0}
.nav{display:flex; flex-direction:column; gap:3px}
.nav button{
  background:transparent;border:1px solid transparent;color:#424245;text-align:left;font-family:inherit;
  font-size:13.5px;padding:9px 12px;border-radius:10px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;transition:.18s;font-weight:500;
}
.nav button:hover{background:#eef2f7; color:#2d3a4a; border-color:rgba(83,125,150,.25); transform:translateX(2px)}
.nav button.on{background:linear-gradient(135deg,#537D96,#3F6179); color:#fff; font-weight:600; border-color:#537D96; box-shadow:0 3px 10px rgba(83,125,150,.32)}
.nav .sub{font-size:11px; color:#86868b}
.nav button.on .sub{color:#dfe9f0; font-weight:600}
.nav-sep{font-size:10.5px; letter-spacing:2px; color:#5a6572; margin:10px 0 4px; text-transform:uppercase; font-weight:700; cursor:pointer; display:flex; justify-content:space-between; align-items:center; user-select:none; background:rgba(83,125,150,.08); border:1px solid rgba(83,125,150,.18); border-radius:9px; padding:6px 10px; transition:.2s}
.nav-sep:hover{background:rgba(83,125,150,.16); color:var(--blue)}
.gp-arrow{font-size:10px; width:17px; height:17px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(83,125,150,.18); transition:transform .3s, background .2s; flex-shrink:0}
.nav-group.collapsed .gp-arrow{transform:rotate(-90deg); background:rgba(83,125,150,.38)}
.nav-gp{max-height:600px; overflow:hidden; transition:max-height .45s cubic-bezier(.4,0,.2,1)}
.nav-group.collapsed .nav-gp{max-height:0}
/* 学习进度细分条 */
.subrow{display:flex; align-items:center; gap:8px; font-size:11px; color:#86868b; margin:4px 0}
.subrow .st{width:50px; flex-shrink:0; letter-spacing:1px}
.sbar{flex:1; height:5px; background:rgba(0,0,0,.08); border-radius:3px; overflow:hidden}
.sbar i{display:block; height:100%; background:linear-gradient(90deg,var(--blue),#8fc3de); transition:.4s}
.subrow .sv{width:36px; text-align:right; color:#5a5146; font-family:Consolas,monospace}
.badge-dot{display:inline-block; width:11px; height:11px; border-radius:50%; margin:2px; cursor:pointer; border:1px solid rgba(0,0,0,.12)}
.rank-next{font-size:10.5px; color:#86868b; margin-top:2px; letter-spacing:.5px}
.hw-wall{display:flex; flex-wrap:wrap; gap:8px}
.hw-badge{border:1.5px dashed var(--gold); color:var(--gold); border-radius:980px; padding:4px 12px; font-size:12.5px; opacity:.35; cursor:default}
.hw-badge.got{opacity:1; border-style:solid; background:rgba(184,134,11,.08); color:#8a6d1f}
.nav .done{color:var(--blue); font-size:12px}
#progressBox{background:linear-gradient(160deg,#332f27,#28241d); border:1px solid rgba(212,169,42,.3); border-radius:16px; padding:16px}
.rank-head{display:flex; align-items:center; gap:10px; margin-bottom:10px}
.rank-ic{width:40px; height:40px; border-radius:50%; background:radial-gradient(circle at 35% 30%, #5a4d28, #3a3018); border:1.5px solid #d4a92a; display:flex; align-items:center; justify-content:center; font-size:19px; flex-shrink:0; box-shadow:0 2px 8px rgba(0,0,0,.3)}
.rank-info{flex:1; min-width:0}
.rank-name{font-size:16px; color:#ffd76e; font-weight:600; letter-spacing:1px; line-height:1.3; text-shadow:0 1px 3px rgba(0,0,0,.4)}
.rank-next{font-size:10.5px; color:#a89a78; margin-top:2px}
/* 学习统计模块 */
.side-card{background:linear-gradient(160deg,#332f27,#28241d); border:1px solid rgba(212,169,42,.3); border-radius:16px; padding:14px 16px; margin-top:10px}
.side-card-t{font-size:12px; letter-spacing:1px; color:#a89a78; margin-bottom:10px; font-weight:600}
#statsGrid{display:grid; grid-template-columns:1fr 1fr; gap:8px}
.stat{background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.08); border-radius:10px; padding:8px 10px; text-align:center}
.stat .sv{font-size:15px; font-weight:600; color:#ffd76e; font-variant-numeric:tabular-nums; line-height:1.3}
.stat .sl{font-size:10px; color:#a89a78; margin-top:2px; letter-spacing:.5px}
.rank-bar{height:5px; background:rgba(255,255,255,.1); border-radius:3px; overflow:hidden; margin-bottom:10px}
.rank-bar i{display:block; height:100%; background:linear-gradient(90deg,#8a6d1f,#ffd76e); transition:.4s}
.total-line{display:flex; justify-content:space-between; align-items:baseline; font-size:11px; color:#a89a78; margin-bottom:4px}
.total-line .pct{font-size:14px; color:#ffd76e; font-weight:600; font-variant-numeric:tabular-nums}
#bar{height:6px; background:rgba(255,255,255,.1); border-radius:3px; overflow:hidden}
#bar i{display:block; height:100%; background:linear-gradient(90deg,#537D96,#8fc3de); transition:.4s}
.honor-head{display:flex; justify-content:space-between; align-items:center; font-size:11px; color:#a89a78; margin:12px 0 6px}
.honor-head b{color:#ffd76e}
.honor-go{border:1px solid rgba(212,169,42,.5); background:transparent; color:#ffd76e; border-radius:980px; padding:3px 10px; font-size:11px; cursor:pointer; font-family:inherit}
.honor-go:hover{background:rgba(212,169,42,.15)}
/* 荣誉墙 */
.rank-stairs{display:grid; grid-template-columns:repeat(auto-fill,minmax(148px,1fr)); gap:10px; margin-bottom:6px}
.rank-step{border:1px solid var(--line); border-radius:12px; padding:12px 14px; background:var(--card); text-align:center; opacity:.5; transition:.15s}
.rank-step.done{border-color:var(--green); opacity:1; background:#f0f6ec}
.rank-step.cur{border-color:var(--gold); box-shadow:0 0 0 2px var(--gold), 0 4px 14px rgba(184,134,11,.2); background:linear-gradient(135deg,#fdf6e3,#f6e9c4); opacity:1; transform:scale(1.04)}
.rank-step .rv{font-size:11px; color:var(--muted)}
.rank-step .rn{font-size:14px; font-weight:600; margin-top:2px}
.rank-step.done .rn{color:var(--green)}
.rank-step.cur .rn{color:#8a6d1f}
.badge-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:12px}
.hw-card{border:1px solid var(--line); border-radius:14px; padding:14px 16px; background:var(--card); opacity:.45; transition:.15s}
.hw-card.got{opacity:1; border-color:var(--gold); background:linear-gradient(135deg,#fdf8ec,#f8edd2); box-shadow:0 2px 10px rgba(184,134,11,.15)}
.hw-card .hc{display:flex; align-items:center; gap:10px}
.hw-card .hic{width:34px; height:34px; border-radius:50%; background:#b9b2a4; color:#fff; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0}
.hw-card.got .hic{background:linear-gradient(135deg,#b8860b,#d4a92a)}
.hw-card .hn{font-size:14px; font-weight:600}
.hw-card .hd{font-size:11.5px; color:var(--muted); margin-top:4px}
.hw-card .hst{font-size:11px; margin-top:6px}
.hw-card.got .hst{color:var(--green); font-weight:600}
/* 名人堂 */
.hall-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(235px,1fr)); gap:14px}
.mh-card{border:1px solid var(--line); border-radius:14px; padding:16px; background:var(--card); display:flex; gap:14px; align-items:flex-start; transition:.15s; box-shadow:var(--shadow); opacity:.55; filter:grayscale(.65)}
.mh-card:hover{transform:translateY(-2px); border-color:var(--gold)}
.mh-card.lit{opacity:1; filter:none; border-color:var(--gold); box-shadow:0 3px 14px rgba(184,134,11,.22); background:linear-gradient(135deg,#fdf8ec,#f8edd2)}
.mh-img{width:52px; height:60px; border-radius:8px; object-fit:cover; flex-shrink:0; border:1px solid var(--line)}
.mh-avatar{width:52px; height:52px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px; color:#fff; font-family:Georgia,'Songti SC',serif; box-shadow:0 2px 8px rgba(0,0,0,.18)}
.mh-card.lit{cursor:pointer}
.mh-open{font-size:11px; color:#8a6d1f; margin-top:6px; font-weight:600}
.mh-lock{font-size:10.5px; color:var(--muted); margin-top:6px}
.mh-info{min-width:0}
.mh-name{font-size:14.5px; font-weight:600}
.mh-lit{font-size:10.5px; color:var(--green); border:1px solid var(--green); border-radius:980px; padding:1px 8px; margin-left:6px; font-weight:600; vertical-align:middle}
.mh-era{font-size:11px; color:var(--muted); margin:2px 0 6px}
.mh-quote{font-size:12px; color:var(--ink2); font-style:italic; line-height:1.6; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
#progressBox h3{font-size:12px; letter-spacing:.5px; color:#86868b; margin-bottom:8px; font-weight:600}
#rankBox{margin:8px 0 10px; font-size:12px; color:#a89a78; letter-spacing:1px}
#rankBox b{color:#ffd76e; font-size:14px; letter-spacing:2px; margin-left:4px}
#bar{height:6px; background:rgba(0,0,0,.08); border-radius:3px; overflow:hidden}
#bar i{display:block; height:100%; width:0%; background:linear-gradient(90deg,#537D96,#3F6179); border-radius:3px; transition:.4s}
#progressBox .pct{font-size:13px; color:var(--blue); margin-top:6px; text-align:right; font-weight:600}
#quote{margin-top:auto; font-size:11px; color:#86868b; font-style:italic; border-left:2px solid var(--blue); padding-left:10px; line-height:1.6}
#main{flex:1; padding:48px 56px 80px; max-width:1020px; margin:0 auto}
.page{display:none; animation:fade .3s}
.page.on{display:block}
@keyframes fade{from{opacity:0; transform:translateY(10px)} to{opacity:1; transform:none}}
.page-head{border-bottom:1px solid var(--line); padding-bottom:16px; margin-bottom:28px}
.page-head .kick{font-size:12px; letter-spacing:2px; color:var(--blue); font-weight:600; text-transform:uppercase}
.page-head h2{font-family:Georgia,'Songti SC',serif; font-size:32px; margin-top:4px; letter-spacing:-.5px; font-weight:500}
.page-head p{color:var(--ink2); margin-top:6px; font-size:15px}
.card{background:var(--card); border-radius:var(--radius); padding:24px 28px; margin-bottom:20px; box-shadow:var(--shadow); border:1px solid rgba(0,0,0,.02)}
.card h3{font-size:17px; color:var(--ink); margin-bottom:10px; display:flex; align-items:center; gap:8px; font-weight:600}
.card h3::before{content:''; width:4px; height:16px; background:var(--blue); border-radius:2px}
.ch-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:14px}
.ch-card{border:1px solid var(--line); border-radius:16px; padding:18px; background:var(--card); cursor:pointer; transition:.18s; box-shadow:0 1px 4px rgba(0,0,0,.04)}
.ch-card:hover{transform:translateY(-3px); box-shadow:var(--shadow); border-color:rgba(83,125,150,.35)}
.ch-card.done{border-color:var(--green); box-shadow:0 0 0 1.5px var(--green), 0 3px 12px rgba(58,107,71,.20); background:linear-gradient(135deg,#eef4ea,#fbf6ea)}
.ch-card.done .no{color:var(--green)}
.ch-card.done .t{color:var(--green)}
.ch-card.done .st{color:var(--green); font-weight:bold}
.ch-card .no{font-size:12px; color:var(--blue); letter-spacing:1px; font-weight:600}
.ch-card .t{font-size:16px; margin:6px 0 6px; font-weight:600; letter-spacing:-.2px}
.ch-card .w{font-size:12px; color:var(--ink2)}
.ch-card .st{font-size:12px; margin-top:8px; color:var(--green); font-weight:600}
.ch-card .st.empty{color:var(--ink2); font-weight:400}
.motto{background:linear-gradient(135deg,#2A2622,#4A433C); color:#F5EFE4; border-radius:var(--radius); padding:22px 26px; margin-bottom:20px; font-style:italic; box-shadow:var(--shadow)}
.motto .who{display:block; margin-top:8px; font-size:12.5px; color:#a1a1a6; font-style:normal; letter-spacing:.5px}
.map{display:flex; flex-wrap:wrap; gap:8px; margin:10px 0 4px}
.map span{border:1px solid rgba(83,125,150,.3); color:var(--blue); border-radius:980px; padding:3px 14px; font-size:13px; background:var(--blue-bg); font-weight:500}
.sec{margin-bottom:20px; padding-bottom:18px; border-bottom:1px dashed var(--line)}
.sec:last-of-type{border-bottom:none; padding-bottom:0}
.sec h4{font-family:Georgia,'Songti SC',serif; font-size:17px; color:var(--ink); margin-bottom:8px; font-weight:500; letter-spacing:.3px}
.sec h4 em{font-style:normal; color:var(--blue); font-size:12px; margin-right:10px; font-weight:600; background:var(--blue-bg); padding:2px 10px; border-radius:980px}
.sec p{color:var(--ink2); margin-bottom:6px; line-height:1.9; font-size:14.5px}
.sec .formula{background:linear-gradient(135deg,#FBF7EE,#f6efdf); border:1px solid var(--line); border-radius:12px; padding:12px 16px; margin:10px 0; font-size:16.5px; text-align:center; color:var(--ink); font-family:Georgia,serif; font-style:italic; letter-spacing:.5px}
.example{background:linear-gradient(135deg,#F6F1E5,#f1e8d4); border-left:3px solid var(--ochre); border-radius:0 14px 14px 0; padding:18px 22px; margin:12px 0}
.example .lbl{font-size:11px; letter-spacing:1px; color:var(--ochre); font-weight:600}
.example p{margin:6px 0; color:var(--ink2); line-height:1.9}
.trap{background:#F6EFE3; border:1px solid #E4D5B8; border-radius:14px; padding:14px 18px; margin:8px 0; font-size:14.5px}
.trap b{color:var(--orange)}
.quiz{border:1px solid var(--line); border-radius:16px; padding:20px 22px; margin-bottom:16px; background:var(--card); box-shadow:0 1px 4px rgba(0,0,0,.03)}
.quiz.done{border-color:var(--green); background:#f2f8f0}
.hall-done-tag{font-size:11px; color:var(--green); border:1px solid var(--green); border-radius:980px; padding:1px 8px; margin-right:8px; font-weight:600}
.quiz .q{font-weight:600; margin-bottom:14px; font-size:15.5px}
.quiz .q .qn{color:var(--blue); margin-right:6px}
.opts{display:flex; flex-direction:column; gap:8px}
.opt{border:1px solid var(--line); border-radius:12px; padding:11px 15px; cursor:pointer; background:var(--card); transition:.15s; font-size:14.5px}
.opt:hover{border-color:var(--blue); background:var(--blue-bg)}
.opt.ok{border-color:var(--green); background:#EDF4ED; color:var(--green); font-weight:600}
.opt.bad{border-color:var(--red); background:#F7EAE6; color:var(--red)}
.opt.lock{pointer-events:none}
.fillrow{display:flex; gap:10px; align-items:center; flex-wrap:wrap}
.fillrow input{flex:1; min-width:220px; border:1px solid var(--line); border-radius:980px; padding:10px 18px; font-family:inherit; font-size:15px; background:#fff}
.fillrow input:focus{outline:none; border-color:var(--blue); box-shadow:0 0 0 3px var(--blue-bg)}
.fillrow button{border:none; background:var(--blue); color:#fff; border-radius:980px; padding:10px 24px; font-family:inherit; font-size:14.5px; cursor:pointer; letter-spacing:.5px; font-weight:500; transition:.15s}
.fillrow button:hover{background:var(--blue2)}
.verdict{border-radius:14px; padding:14px 18px; margin-top:12px; font-size:14.5px; display:none}
.verdict.show{display:block}
.verdict.right{background:#EDF4ED; border:1px solid rgba(74,107,74,.3)}
.verdict.wrong{background:#F7EAE6; border:1px solid rgba(139,44,31,.3)}
.verdict .cm{font-style:italic; margin-bottom:6px}
.verdict .ex{font-size:13.5px; color:var(--ink2)}
.dia textarea{width:100%; min-height:100px; border:1px solid var(--line); border-radius:14px; padding:14px 16px; font-family:inherit; font-size:14.5px; background:#fff; resize:vertical; transition:.15s}
.dia textarea:focus{outline:none; border-color:var(--blue); box-shadow:0 0 0 3px var(--blue-bg)}
.dia .act{display:flex; gap:10px; margin-top:10px; flex-wrap:wrap}
.dia button{border:1px solid var(--blue); background:transparent; color:var(--blue); border-radius:980px; padding:8px 20px; font-family:inherit; font-size:14px; cursor:pointer; font-weight:500; transition:.15s}
.dia button.primary{background:var(--blue); color:#fff}
.dia button:hover{background:var(--blue); color:#fff}
.week{display:flex; flex-wrap:wrap; align-items:center; gap:14px; padding:14px 16px; border:1px solid var(--line); border-radius:14px; margin-bottom:10px; background:var(--card); box-shadow:0 1px 3px rgba(0,0,0,.03); transition:.15s}
.week:hover{border-color:rgba(83,125,150,.3)}
.week.checked{background:#EDF4ED; border-color:rgba(74,107,74,.4)}
.week input{width:18px; height:18px; accent-color:var(--green); cursor:pointer}
.week .wk{font-size:13px; color:var(--blue); letter-spacing:.5px; width:70px; flex-shrink:0; font-weight:600}
.week .wd{font-size:15px}
.week .st{margin-left:auto; font-size:12px; color:var(--ink2); flex-shrink:0}
.week .subs{flex-basis:100%; margin-top:8px; padding:8px 4px 2px 22px; border-top:1px dashed var(--line); display:flex; flex-direction:column; gap:3px}
.lesson-row{display:flex; align-items:center; gap:10px; padding:5px 8px; border-radius:8px; font-size:13.5px; color:var(--ink2)}
.lesson-row:hover{background:var(--blue-bg)}
.lesson-row input{width:15px; height:15px; accent-color:var(--blue); cursor:pointer}
.lesson-row.on{color:var(--ink)}
.lesson-row .ls{margin-left:auto; color:var(--green); font-size:12px; font-weight:600}
.badge-row{display:flex; flex-wrap:wrap; gap:10px; margin-top:8px}
.badge{border:1.5px dashed #C9C2B4; color:var(--muted); border-radius:980px; padding:6px 16px; font-size:13px; opacity:.45}
.badge.got{opacity:1; border-style:solid; border-color:var(--blue); color:var(--blue); background:var(--blue-bg)}
.badge.got::before{content:'✦ '}
.btn-back{display:inline-block; margin-bottom:18px; border:1px solid var(--line); background:var(--card); color:var(--ink2); border-radius:980px; padding:8px 18px; font-family:inherit; cursor:pointer; font-size:13.5px; transition:.15s}
.btn-back:hover{border-color:var(--blue); color:var(--blue)}
.hint{font-size:13px; color:var(--ink2); margin-top:6px}
/* 进度管理：备份操作区 */
.pg-actions{display:flex; flex-wrap:wrap; gap:10px}
.pg-btn{border:1px solid var(--line); background:var(--card); color:var(--ink2); border-radius:980px; padding:10px 22px; font-family:inherit; font-size:13.5px; cursor:pointer; transition:.15s}
.pg-btn:hover{border-color:var(--blue); color:var(--blue); background:var(--blue-bg)}
.pg-btn.primary{background:linear-gradient(135deg,#537D96,#3F6179); color:#fff; border-color:transparent}
.pg-btn.primary:hover{color:#fff; background:linear-gradient(135deg,#3F6179,#2c4859)}
.pg-btn.danger{border-color:rgba(139,44,31,.4); color:var(--red)}
.pg-btn.danger:hover{background:#F7EAE6; color:var(--red)}
.pg-hint{font-size:12.5px; color:var(--muted); margin-top:10px; line-height:1.7}
/* 云同步（Supabase） */
.sb-status{font-size:11px; color:var(--muted); border:1px dashed rgba(83,125,150,.4); border-radius:980px; padding:8px 12px; cursor:pointer; text-align:center; transition:.15s; background:rgba(83,125,150,.05)}
.sb-status:hover{background:rgba(83,125,150,.12); color:var(--blue); border-style:solid}
.sb-status.ok{color:#3a6b47; border-color:rgba(58,107,71,.35); background:rgba(58,107,71,.06)}
.sb-status.ok:hover{background:rgba(58,107,71,.12)}
.sb-panel{display:flex; flex-direction:column; gap:8px; margin-top:8px}
.sb-user{font-size:12.5px; color:var(--ink2); line-height:1.7; background:rgba(58,107,71,.06); border:1px solid rgba(58,107,71,.2); border-radius:10px; padding:10px 12px}
.sb-user b{color:#3a6b47}
.sb-input{width:100%; padding:9px 12px; border:1px solid var(--line); border-radius:8px; font-family:inherit; font-size:13px; background:#fff; outline:none; box-sizing:border-box}
.sb-input:focus{border-color:var(--blue)}
.sb-actions{display:flex; gap:8px; margin-top:6px}
.sb-btn{border:1px solid var(--line); background:#fff; border-radius:8px; padding:8px 16px; font-family:inherit; font-size:12.5px; cursor:pointer; color:var(--ink2); transition:.15s; flex:1}
.sb-btn:hover{background:var(--blue-bg); color:var(--blue)}
.sb-btn.primary{border-color:var(--blue); color:var(--blue); font-weight:600}
.sb-btn.primary:hover{background:var(--blue-bg)}
.sb-tip{font-size:10.5px; color:#9a9288; line-height:1.6}
.sb-msg{font-size:12px; min-height:18px; margin-top:4px}
.login-overlay{position:fixed; inset:0; z-index:999; background:linear-gradient(160deg,#F0E8D8,#E5D9C0); display:flex; align-items:center; justify-content:center}
.login-card{background:var(--card); border:1px solid var(--line); border-radius:20px; width:min(380px, 92vw); padding:32px 30px; display:flex; flex-direction:column; gap:12px; box-shadow:0 20px 60px rgba(80,70,50,.25); text-align:center}
.login-logo{width:64px; height:64px; border-radius:50%; margin:0 auto; background:linear-gradient(135deg,#537D96,#3F6179); display:flex; align-items:center; justify-content:center; font-size:30px; box-shadow:0 6px 18px rgba(83,125,150,.35)}
.login-title{font-size:20px; font-weight:700; font-family:Georgia,'Songti SC',serif; color:var(--ink)}
.login-sub{font-size:12.5px; color:var(--muted); margin-bottom:6px}
.login-share{font-size:11.5px; color:#2c5480; background:linear-gradient(90deg,rgba(59,110,165,.16),rgba(83,125,150,.08)); border:1px solid rgba(59,110,165,.45); border-radius:8px; padding:8px 10px; line-height:1.55; text-align:center; font-weight:600}
.login-actions{display:flex; gap:10px; margin-top:4px}
.login-btn{flex:1; border:none; border-radius:10px; padding:11px; font-family:inherit; font-size:14px; font-weight:600; cursor:pointer; transition:.15s; background:var(--blue-bg); color:var(--blue); border:1px solid rgba(83,125,150,.3)}
.login-btn:hover{background:rgba(83,125,150,.15)}
.login-btn.primary{background:linear-gradient(135deg,#537D96,#3F6179); color:#fff; border:none}
.login-btn.primary:hover{filter:brightness(1.08)}
.login-msg{font-size:12px; min-height:18px; color:#8B2C1F}
.login-tip{font-size:11px; color:#9a9288; line-height:1.7; background:rgba(43,37,29,.04); border-radius:8px; padding:9px 11px}
/* ===== 登录 v2（用户名 + 头像）===== */
.login-tabs{display:flex; background:rgba(43,37,29,.06); border-radius:10px; padding:4px; margin-bottom:2px}
.login-tab{flex:1; border:none; background:transparent; border-radius:8px; padding:8px; font-family:inherit; font-size:13.5px; font-weight:600; color:var(--muted); cursor:pointer; transition:.15s}
.login-tab:hover{color:var(--blue)}
.login-tab.on{background:#fff; color:var(--blue); box-shadow:0 2px 8px rgba(0,0,0,.08)}
.avatar-pick{font-size:11px; color:#9a9288; text-align:left; margin:4px 2px -2px}
.avatar-grid{display:grid; grid-template-columns:repeat(6,1fr); gap:8px; justify-items:center; padding:4px 0 2px}
.avatar-opt{width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:19px; cursor:pointer; border:2px solid transparent; transition:.15s}
.avatar-opt:hover{transform:scale(1.14)}
.avatar-opt.sel{border-color:var(--blue); box-shadow:0 0 0 3px rgba(83,125,150,.22); transform:scale(1.1)}
.login-btn.link{background:transparent; border:none; color:var(--muted); font-size:12px; font-weight:400; padding:4px 6px; flex:none; width:auto; text-decoration:underline; cursor:pointer}
.login-btn.link:hover{color:var(--blue)}
.login-forgot-row{display:flex; justify-content:space-between; align-items:center; min-height:20px}
.login-warn{font-size:11px; color:#8a5b00; background:rgba(184,134,11,.14); border:1px solid rgba(184,134,11,.4); border-radius:8px; padding:7px 10px; line-height:1.5; text-align:left; font-weight:600}
.login-hint{font-size:11px; color:var(--blue); background:rgba(83,125,150,.1); border:1px dashed rgba(83,125,150,.35); border-radius:8px; padding:7px 10px; line-height:1.5; text-align:left}
/* ===== 游客模式 ===== */
.guest-entry{display:flex; flex-direction:column; gap:6px; margin-top:2px}
.guest-btn{border:1px dashed rgba(83,125,150,.55); background:rgba(83,125,150,.06); color:var(--blue); border-radius:10px; padding:9px; font-family:inherit; font-size:13px; font-weight:600; cursor:pointer; transition:.15s}
.guest-btn:hover{background:rgba(83,125,150,.16)}
.guest-note{font-size:10.5px; color:#9a9288; line-height:1.6}
.guest-bar{background:linear-gradient(90deg,#f5c542,#e8a020); color:#3a2b00; padding:11px 18px; font-size:13px; font-weight:600; text-align:center; cursor:pointer; z-index:60; position:relative; line-height:1.6}
.guest-bar:hover{filter:brightness(1.05)}
.guest-bar b{text-decoration:underline}
/* ===== 学院社区（侧边栏）===== */
.com-block{display:flex; flex-direction:column; gap:7px; margin-top:12px}
.com-btn{display:flex; align-items:center; gap:8px; border:1px solid rgba(83,125,150,.28); background:rgba(83,125,150,.08); color:var(--blue); border-radius:10px; padding:8px 12px; font-family:inherit; font-size:12px; cursor:pointer; transition:.15s; text-decoration:none; text-align:left}
.com-btn:hover{background:rgba(83,125,150,.2); transform:translateY(-1px); color:var(--blue)}
.com-btn .ic{font-size:14px; flex:none}
.com-btn .go{margin-left:auto; font-size:10px; color:var(--muted)}
.avatar-circle{width:32px; height:32px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:17px; flex:none; vertical-align:middle}
.sb-avatar{width:20px; height:20px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:12px; flex:none; vertical-align:-4px; margin-right:5px}
.sb-statusbar{font-size:11px; color:var(--muted); border:1px dashed rgba(83,125,150,.4); border-radius:980px; padding:8px 12px; cursor:pointer; text-align:center; transition:.15s; background:rgba(83,125,150,.05); margin-top:12px}
.sb-statusbar:hover{background:rgba(83,125,150,.12); color:var(--blue); border-style:solid}
.sb-statusbar.ok{color:#3a6b47; border-color:rgba(58,107,71,.35); background:rgba(58,107,71,.06)}
.sb-statusbar.ok:hover{background:rgba(58,107,71,.12)}
/* ===== 侧边栏用户卡 ===== */
.user-card{background:linear-gradient(135deg,rgba(83,125,150,.16),rgba(83,125,150,.05)); border:1px solid rgba(83,125,150,.35); border-radius:12px; padding:10px 12px; cursor:pointer; display:flex; align-items:center; gap:10px; transition:.15s; margin:0 0 4px}
.user-card:hover{background:rgba(83,125,150,.24); border-style:solid}
.user-card .uc-ic{width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:17px; background:rgba(83,125,150,.22); flex:none}
.user-card .uc-name{font-size:12.5px; font-weight:600; color:var(--ink); line-height:1.4; word-break:break-all}
.user-card .uc-mail{font-size:10.5px; color:var(--muted); line-height:1.4; word-break:break-all; margin-top:1px}
.user-card .uc-hint{font-size:10.5px; color:var(--muted); line-height:1.5}
/* ===== 排行榜弹窗 ===== */
.modal-mask{position:fixed; inset:0; background:rgba(20,18,14,.5); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px); display:flex; align-items:center; justify-content:center; z-index:200}
.modal-card{background:linear-gradient(180deg,#fdfcf9,#f6f1e7); border:1px solid rgba(43,37,29,.12); border-radius:18px; width:min(400px,90vw); box-shadow:0 20px 60px rgba(0,0,0,.35); overflow:hidden}
.modal-head{display:flex; justify-content:space-between; align-items:center; padding:15px 20px; font-size:15px; font-weight:700; color:#2C2A26; border-bottom:1px solid rgba(43,37,29,.1)}
.modal-x{border:none; background:rgba(43,37,29,.06); color:#6B6158; width:26px; height:26px; border-radius:50%; cursor:pointer; font-size:13px; transition:.15s; font-family:inherit}
.modal-x:hover{background:rgba(43,37,29,.14); color:#2C2A26}
.modal-body{padding:18px 20px; display:flex; flex-direction:column; gap:10px}
.modal-btn{display:flex; justify-content:space-between; align-items:center; border:1px solid rgba(59,110,165,.3); background:#fff; color:#2C5480; border-radius:10px; padding:11px 14px; font-size:13.5px; font-weight:600; cursor:pointer; font-family:inherit; transition:.15s}
.modal-btn:hover{background:rgba(59,110,165,.08); transform:translateY(-1px)}
.modal-card.wide{width:min(480px,92vw)}
.rank-wrap{display:flex; flex-direction:column; gap:8px; max-height:62vh; overflow-y:auto}
.rank-row{display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:12px; border:1px solid rgba(43,37,29,.08); background:#fff}
.rank-row.me{border-color:rgba(184,134,11,.5); background:linear-gradient(90deg,rgba(184,134,11,.1),rgba(184,134,11,.03)); box-shadow:0 0 0 1px rgba(184,134,11,.25)}
.rank-no{width:26px; text-align:center; font-weight:700; font-size:14px; color:#9a9288; flex:none}
.rank-no.top{font-size:18px}
.rank-info{flex:1; min-width:0}
.rank-line1{display:flex; align-items:center; gap:6px; font-size:13px; font-weight:600; color:var(--ink2); min-width:0}
.rank-line1 .rn{overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.rank-tag{font-size:9.5px; color:#8a6d1f; background:rgba(184,134,11,.12); border:1px solid rgba(184,134,11,.25); border-radius:980px; padding:1px 7px; font-weight:600; flex:none}
.rank-my{font-size:10.5px; color:#8a6d1f; font-weight:600; margin-left:auto; flex:none}
.rank-pct{font-size:14px; font-weight:700; color:#3a6b47; flex:none}
.rank-pbar{height:5px; background:rgba(43,37,29,.08); border-radius:980px; overflow:hidden; margin-top:5px}
.rank-pbar i{display:block; height:100%; background:linear-gradient(90deg,#537D96,#6fa3bd); border-radius:980px}
.rank-line2{display:flex; gap:12px; font-size:10.5px; color:#9a9288; margin-top:4px}
.rank-empty{text-align:center; color:#9a9288; font-size:13px; padding:26px 0; line-height:1.8}
/* ===== 留言弹窗 ===== */
.fb-text{border:1px solid var(--line); border-radius:10px; padding:10px 12px; font-family:inherit; font-size:13px; background:#fff; resize:vertical; min-height:64px; outline:none; box-sizing:border-box; width:100%}
.fb-text:focus{border-color:var(--blue)}
.fb-send{align-self:flex-end}
.fb-more{justify-content:center; width:100%; margin-top:2px}
.fb-list{display:flex; flex-direction:column; gap:8px; max-height:300px; overflow-y:auto; margin-top:2px}
.fb-item{display:flex; gap:9px; background:#fff; border:1px solid rgba(43,37,29,.08); border-radius:12px; padding:10px 12px}
.fb-body{flex:1; min-width:0}
.fb-head{display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:var(--ink2)}
.fb-time{font-size:10px; color:#b0a89d; font-weight:400; margin-left:auto; flex:none}
.fb-text2{font-size:12.5px; color:var(--ink2); line-height:1.65; margin-top:3px; white-space:pre-wrap; word-break:break-word}
.fb-empty{text-align:center; color:#9a9288; font-size:12.5px; padding:18px 0; line-height:1.8}
.fb-count{font-size:10.5px; color:#9a9288; text-align:center}
/* ===== 分享弹窗 ===== */
.share-intro{font-size:12.5px; color:var(--ink2); margin-bottom:6px}
.share-item{border:1px solid rgba(43,37,29,.1); border-radius:12px; padding:12px; margin-bottom:10px; background:#fff}
.share-name{font-size:13.5px; font-weight:700; color:var(--ink); margin-bottom:8px}
.share-row{display:flex; gap:8px; margin-bottom:6px; align-items:center}
.share-label{font-size:11px; color:var(--muted); flex:none; width:66px}
.share-inp{flex:1; min-width:0; border:1px solid var(--line); background:rgba(43,37,29,.03); border-radius:8px; padding:8px 10px; font-size:12px; color:var(--ink2); font-family:Consolas,monospace; outline:none}
.share-copy{border:1px solid rgba(59,110,165,.4); background:#fff; color:#2C5480; border-radius:8px; padding:7px 14px; font-family:inherit; font-size:12px; font-weight:600; cursor:pointer; flex:none; transition:.15s}
.share-copy:hover{background:rgba(59,110,165,.1)}
.share-copy.done{background:#e8f8ee; border-color:rgba(52,199,89,.5); color:#1d7a3f}
.share-open{border:1px solid rgba(52,199,89,.45); background:#fff; color:#1d7a3f; border-radius:8px; padding:7px 12px; font-family:inherit; font-size:12px; font-weight:600; cursor:pointer; flex:none; text-decoration:none; transition:.15s; text-align:center}
.share-open:hover{background:rgba(52,199,89,.12)}
.share-tip{font-size:11px; color:#9a9288; text-align:center; line-height:1.6}
/* ===== 账号管理 ===== */
.sb-email{display:block; font-size:11px; color:#9a9288; margin-top:2px; word-break:break-all}
.acc-actions{display:flex; flex-wrap:wrap; gap:6px}
.acc-btn{border:1px dashed rgba(83,125,150,.45); background:rgba(83,125,150,.05); color:var(--blue); border-radius:8px; padding:6px 10px; font-family:inherit; font-size:11.5px; cursor:pointer; transition:.15s}
.acc-btn:hover{background:rgba(83,125,150,.16)}
.acc-frow{display:flex; gap:8px}
.acc-frow .sb-input{flex:1}
.acc-msg{font-size:11.5px; min-height:16px}
.acc-tip{font-size:10.5px; color:#9a9288; line-height:1.6}
.acc-avgrid{display:grid; grid-template-columns:repeat(6,1fr); gap:8px; justify-items:center; padding:2px 0}
.acc-avgrid .avatar-opt{width:34px; height:34px; font-size:17px}
/* 学习足迹 */
.trace-day{margin:18px 0 8px; font-size:13.5px; letter-spacing:.5px; color:var(--ink); border-left:3px solid var(--blue); padding-left:10px; font-weight:600}
.trace-item{display:flex; gap:14px; padding:10px 6px; border-bottom:1px dashed var(--line); font-size:14.5px; align-items:baseline}
.trace-item .tm{color:var(--blue); font-size:12.5px; width:118px; flex-shrink:0; font-family:Consolas,monospace}
.trace-item .tt{flex:1}
.trace-item .tag{font-size:11.5px; border:1px solid rgba(83,125,150,.3); color:var(--blue); background:var(--blue-bg); border-radius:980px; padding:1px 12px; margin-left:8px; white-space:nowrap}
footer{margin-top:40px; text-align:center; color:var(--muted); font-size:12px; border-top:1px solid var(--line); padding-top:18px}
/* 主页仪表盘 */
.home-hero{background:linear-gradient(135deg,#2f2a20,#4a412c); border-radius:18px; padding:30px 32px; color:#f0e3c2; box-shadow:var(--shadow); margin-bottom:20px}
.home-hero .greet{font-size:13px; letter-spacing:3px; color:var(--gold2); text-transform:uppercase}
.home-hero h2{font-size:30px; margin:8px 0 4px; letter-spacing:1px}
.home-hero .sub{font-size:14px; color:#cbbd9c}
.home-hero .rank-line{margin-top:16px; display:flex; align-items:center; gap:12px; flex-wrap:wrap}
.home-hero .rank-line .rk{font-size:15px; color:#ffd76e; border:1.5px solid var(--gold2); border-radius:980px; padding:6px 18px; letter-spacing:2px}
.home-hero .rank-line .pct-big{font-size:22px; font-weight:600; color:#fff; font-variant-numeric:tabular-nums}
.home-bar{height:10px; background:rgba(255,255,255,.12); border-radius:6px; overflow:hidden; margin-top:14px}
.home-bar i{display:block; height:100%; background:linear-gradient(90deg,var(--gold),var(--gold2)); transition:.5s}
.home-cards{display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:14px; margin:0 0 20px}
.home-card{border:1px solid var(--line); border-radius:14px; padding:18px; background:var(--card); cursor:pointer; transition:.18s; box-shadow:var(--shadow)}
.home-card:hover{transform:translateY(-3px); border-color:var(--gold)}
.home-card .ic{font-size:22px}
.home-card .t{font-size:15.5px; font-weight:600; margin:6px 0 2px}
.home-card .v{font-size:22px; font-weight:600; color:var(--blue); font-variant-numeric:tabular-nums}
.home-card .d{font-size:12px; color:var(--muted); margin-top:4px}
.home-next{background:#f2ead4; border:1px solid var(--gold); border-left:4px solid var(--gold); border-radius:12px; padding:16px 20px; margin-bottom:20px}
.home-next .lbl{font-size:11px; letter-spacing:2px; color:var(--gold); font-weight:600}
.home-next .tx{font-size:15px; margin:6px 0 10px; color:var(--ink)}
.home-next button{border:none; background:linear-gradient(135deg,#537D96,#3F6179); color:#fff; border-radius:980px; padding:8px 22px; font-family:inherit; font-size:13.5px; cursor:pointer; letter-spacing:1px}
.home-trace{font-size:13px; color:var(--ink2)}
.home-trace .row{display:flex; gap:10px; padding:6px 0; border-bottom:1px dashed var(--line); align-items:baseline}
.home-trace .tm{color:var(--gold); font-family:Consolas,monospace; font-size:11.5px; width:100px; flex-shrink:0}
/* 数学史话卡片 */
.story-card{background:linear-gradient(135deg,#FBF7EE,#f6efdf)}
.story-head{display:flex;align-items:center;gap:14px;margin-bottom:12px}
.story-name{font-family:Georgia,'Songti SC',serif;font-size:17px;font-weight:500;color:var(--ink)}
.story-era{font-size:12px;color:var(--muted);margin-top:2px}
.story-fact{font-size:14.5px;color:var(--ink2);line-height:1.8;border-left:2px solid var(--blue);padding-left:12px;margin-bottom:10px}
.story-quote{font-family:Georgia,serif;font-style:italic;color:var(--ochre);font-size:14px;margin-bottom:10px}
.story-anecdote{background:rgba(157,95,77,.07);border:1px solid rgba(157,95,77,.2);border-radius:8px;padding:10px 14px;font-size:13.5px;color:var(--ink2);line-height:1.7}
.story-anecdote b{color:var(--ochre);font-weight:500}
.status{font-size:12px;color:var(--ink2);margin-top:6px;font-family:Consolas,monospace}
canvas{width:100%;background:#fffdf7;border:1px solid var(--line);border-radius:10px;display:block}
/* 悬浮导航（不随滚动） */
.fab-nav{position:fixed;right:18px;bottom:22px;display:flex;flex-direction:column;gap:10px;z-index:9998}
.fab-nav button{width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--blue);font-size:17px;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.15);display:flex;align-items:center;justify-content:center;transition:.15s}
.fab-nav button:hover{background:var(--blue-bg);transform:translateY(-2px)}
.fab-nav button .fab-tip{position:absolute;right:56px;background:var(--ink);color:#F5EFE4;font-size:12px;padding:4px 10px;border-radius:6px;white-space:nowrap;opacity:0;pointer-events:none;transition:.15s}
.fab-nav button:hover .fab-tip{opacity:1}
.fab-nav button{position:relative}
@media (max-width:860px){
  #app{flex-direction:column}
  #side{width:100%; height:auto; position:static; border-right:none; border-bottom:1px solid var(--line)}
  #main{padding:24px 18px 60px}
  #side.collapsed{display:none}
}
/* ===== 四院统一：退出学院 ===== */
.exit-academy{display:flex;align-items:center;justify-content:center;gap:6px;margin:0 0 2px;border:1.5px solid var(--line);border-radius:980px;padding:8px 12px;font-size:12.5px;color:var(--ink2);text-decoration:none;cursor:pointer;transition:.18s;letter-spacing:.5px;background:transparent;flex-shrink:0}
.exit-academy:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-bg)}
.side-fab,.exit-fab{position:fixed;bottom:18px;height:42px;border-radius:980px;border:1px solid var(--line);background:var(--card);color:var(--blue);font-size:13.5px;font-weight:600;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.18);z-index:9997;align-items:center;justify-content:center;display:none;transition:transform .15s;gap:5px;padding:0 16px;line-height:1;text-decoration:none}
.side-fab{left:12px}
.exit-fab{left:12px;right:auto;bottom:78px}
.side-fab:hover,.exit-fab:hover{transform:scale(1.1)}
.interact-card{border:1px solid rgba(83,125,150,.3)}
.interact-desc{font-size:13.5px;color:var(--ink2);margin-bottom:10px}
.controls{display:flex;flex-wrap:wrap;gap:14px;align-items:center;font-size:13.5px;color:var(--ink2);margin-bottom:8px}
.controls .val{color:var(--blue);font-weight:600;min-width:44px}
.controls input[type=range]{width:230px;accent-color:var(--blue)}
.status{margin-top:10px;font-size:13px;color:var(--ink2);background:var(--blue-bg);border:1px solid rgba(83,125,150,.2);border-radius:10px;padding:8px 12px}
</style>
</head>
<body>
<div id="guestBar" class="guest-bar" style="display:none" onclick="showLogin()">🎮 游客模式：数据保存在本浏览器，登录账号后自动并入进度；未登录不跨设备同步，清理浏览器数据可能丢失。点这里 <b>注册账号</b> 保存进度</div>
<div id="app">
  <aside id="side">
    <button id="sideToggle" title="折叠/展开侧栏">«</button>
    <h1>🐭 鼠哥的芯片战争读书学院 🧠<small>CHIP WAR ACADEMY · 米勒读本 · 36 章已授</small></h1>
    <a class="exit-academy" href="https://ndshuge.github.io/ndshuge-academy/" title="回到四学院门户">🚪 退出学院</a>
    <div class="divider"></div>
    <div id="userCard" class="user-card" onclick="userCardClick()">
      <div class="uc-ic">👤</div>
      <div>
        <div class="uc-name">未登录</div>
        <div class="uc-hint">点击登录 · 管理账号与进度</div>
      </div>
    </div>
    <div class="divider"></div>
    <nav class="nav">
      <div class="nav-group collapsed">
        <div class="nav-sep" data-gp="learn">学习 <span class="gp-arrow">▾</span></div>
        <div class="nav-gp" id="gp-learn">
          <button data-page="home" class="on"><span>🏠 主页</span></button>
          <button data-page="plan"><span>📜 学习计划</span><span class="sub" id="planCnt">0/17</span></button>
          <button data-page="lesson"><span>🎓 章节课堂</span><span class="sub" id="chCnt">0/4</span></button>
          <button data-page="hall"><span>🏛 练习大厅</span></button>
          <button data-page="exam"><span>📝 小卷练习</span><span class="sub" id="examCnt"></span></button>
        </div>
      </div>
      <div class="nav-group collapsed">
        <div class="nav-sep" data-gp="state">状态 <span class="gp-arrow">▾</span></div>
        <div class="nav-gp" id="gp-state">
          <button data-page="honor"><span>🏆 荣誉墙</span></button>
          <button data-page="wrong"><span>📕 错题集</span><span class="sub" id="wrongCnt"></span></button>
          <button data-page="fixed"><span>✅ 已订正</span><span class="sub" id="fixedCnt"></span></button>
          <button data-page="trace"><span>🗂 管理账号与进度</span><span class="sub" id="traceCnt"></span></button>
          <button data-page="ask"><span>✍️ 问答批改</span></button>
          <button data-page="lab"><span>🔬 芯片实验室</span></button>
                    <button data-page="about"><span>✒️ 关于导师</span></button>
        </div>
      </div>
    </nav>
    <div class="divider"></div>
    <div id="progressBox">
      <div class="rank-head">
        <div class="rank-ic">👑</div>
        <div class="rank-info">
          <div class="rank-name" id="rankName">初入书院</div>
          <div class="rank-next" id="rankNext"></div>
        </div>
      </div>
      <div class="rank-bar"><i id="rankBar"></i></div>
      <div class="total-line"><span>总进度</span><span class="pct" id="pctTxt">0%</span></div>
      <div id="bar"><i></i></div>
      <div class="total-line" style="margin-top:10px"><span>📈 学习进度</span></div>
      <div id="progSub"></div>
      <div class="honor-head">
        <span>荣誉徽章 <b id="badgeCnt">0/14</b></span>
        <button class="honor-go" onclick="goPage('honor')">荣誉墙 →</button>
      </div>
      <div id="badges" class="badge-row"></div>
    </div>
    <div id="quote">「芯片是新的钢铁，战争换了材料。」—— 正在给你导读芯片史的米勒</div>
    <div class="com-block">
      <a class="com-btn" href="https://github.com/ndshuge/ndshuge-academy" target="_blank" rel="noopener"><span class="ic">📦</span>GitHub 仓库<span class="go">↗</span></a>
      <button class="com-btn" onclick="openRank()"><span class="ic">🏆</span>学习排行榜<span class="go">→</span></button>
      <button class="com-btn" onclick="openFeedback()"><span class="ic">💬</span>给作者留言<span class="go">→</span></button>
      <button class="com-btn" onclick="openShare()"><span class="ic">📤</span>分享学院<span class="go">→</span></button>
      <button class="com-btn" onclick="openCalendar()"><span class="ic">📅</span>打卡日历<span class="go">→</span></button>
      <button class="com-btn" onclick="openAuthor()"><span class="ic">👨‍💻</span>关于作者<span class="go">→</span></button>
    </div>
  </aside>
  <main id="main">
    <!-- 荣誉墙页 -->
    <section class="page" id="page-honor">
      <div class="page-head">
        <div class="kick">THE HALL OF HONOR</div>
        <h2>荣誉墙</h2>
        <p>称号阶梯 · 徽章墙 · 数学家名人堂——你的每一次进步，都有人见证。</p>
      </div>
      <div id="honorBox"></div>
    </section>
    <!-- 主页 -->
    <section class="page on" id="page-home">
      <div id="homeBox"></div>
    </section>
    <!-- 计划页 -->
    <section class="page on" id="page-plan">
      <div class="page-head">
        <div class="kick">THE CAMPAIGN PLAN</div>
        <h2>八部芯片编年史</h2>
        <p>本书八大部分，按顺序攻下。当前已开放 36 章：第一部分「芯片冷战」6 章 + 第二部分「美国电路」3 章，其余部分随内容补全。</p>
      </div>
      <div id="planList"></div>
      <div class="card">
        <h3>三条铁律</h3>
        <p>① <b>不跳章</b>：从钢到硅没通，别急着读台湾困境。链条比速度重要。</p>
        <p>② <b>不裸奔</b>：做完立刻批改（本学院即时批改 + 把灵魂拷问交给对话里的米勒），错题 48 小时内重做，7 天后再测第三遍。</p>
        <p>③ <b>不贪多</b>：每天新题不超过 8 道，但每道都想透「为什么这样解」。</p>
      </div>
    </section>
    <!-- 课堂页 -->
    <section class="page" id="page-lesson">
      <div class="page-head">
        <div class="kick">THE LECTURES</div>
        <h2>章节课堂</h2>
        <p>每章：开讲词 → 知识地图 → 讲义 → 例题 → 易错 → 练习（即时批改）→ 灵魂拷问。已授 36 章，后续部分随内容补全。</p>
      </div>
      <div id="chSelect" class="ch-grid"></div>
      <div id="chDetail"></div>
    </section>
    <!-- 大厅页 -->
    <section class="page" id="page-hall">
      <div class="page-head">
        <div class="kick">THE PRACTICE HALL</div>
        <h2>练习大厅</h2>
        <p>全书精选习题，按章刷题。全部选择题，点选作答，史实与因果不用自己猜。</p>
      </div>
      <div id="hallNav" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px"></div>
      <div id="hallList"></div>
    </section>
    <!-- 小卷页 -->
    <section class="page" id="page-exam">
      <div class="page-head">
        <div class="kick">THE MINI EXAMS</div>
        <h2>小卷练习</h2>
        <p>每章一份 15 题小卷，覆盖本章核心史实与因果链条。即时批改，错题自动进错题集。全对即「满分」，卷子完成。</p>
      </div>
      <div id="examNav" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px"></div>
      <div id="examList"></div>
    </section>
    <!-- 错题集页 -->
    <section class="page" id="page-wrong">
      <div class="page-head">
        <div class="kick">THE CORRECTION DESK</div>
        <h2>错题集</h2>
        <p>做错的题自动收集到这里。在错题集里做对 → 归档到「已订正」；每次进入都是未作答的干净状态。</p>
      </div>
      <div id="wrongList"></div>
    </section>
    <!-- 已订正页 -->
    <section class="page" id="page-fixed">
      <div class="page-head">
        <div class="kick">THE FIXED POOL</div>
        <h2>已订正</h2>
        <p>从错题集毕业的题都归档在这里。可随时重做巩固；做错会被打回错题集。</p>
      </div>
      <div id="fixedList"></div>
    </section>
    <!-- 进度管理页（足迹 + 备份） -->
    <section class="page" id="page-trace">
      <div class="page-head">
        <div class="kick">PROGRESS MANAGER</div>
        <h2>管理账号与进度</h2>
        <p>学习足迹自动记录每一次开课与答题。可随时导出备份，换设备、换浏览器也能无缝续学。</p>
      </div>
      <div class="card">
        <h3>📦 进度备份</h3>
        <div class="pg-actions">
          <button id="btnExport" class="pg-btn primary">📤 导出进度</button>
          <button id="btnImport" class="pg-btn">📥 导入进度</button>
          <button id="btnClean" class="pg-btn danger">🗑 清除所有记录</button>
        </div>
        <p class="pg-hint">导出会生成一串备份码（含全部学习数据），妥善保存；导入粘贴备份码即可恢复。清除会<b>永久抹掉全部学习数据</b>（章节进度、徽章、名人堂、错题、足迹），学院回到初始状态，需输入「清除记录」确认。</p>
      </div>
      <div class="card">
        <h3>👤 账号管理 · 云同步</h3>
        <div id="sbStatus" class="sb-status" onclick="showLogin()">☁️ 登录后可多设备同步进度</div>
        <div id="sbPanel" class="sb-panel"></div>
        <div id="sbMsg" class="sb-msg"></div>
        <p class="pg-hint">登录后学习进度自动同步到云端，换设备、换浏览器登录同一账号即恢复。</p>
      </div>
    </section>
    <!-- 问答页 -->
    <section class="page" id="page-ask">
      <div class="page-head">
        <div class="kick">THE INTERROGATION</div>
        <h2>问答批改</h2>
        <p>把每章的「灵魂拷问」答案写在这里，先让本学院做关键词初判，再把完整答案贴给对话里的米勒，他会认真批改你的论证。</p>
      </div>
      <div class="card">
        <h3>灵魂拷问清单</h3>
        <div id="askList"></div>
      </div>
    </section>
    <!-- 实验室 -->
    <section class="page" id="page-lab">
      <div class="page-head">
        <div class="kick">THE CHIP LAB</div>
        <h2>芯片实验室</h2>
        <p>不是看，是动手。每个滑块都对应书里的真实工艺逻辑：掺杂、光刻、良率、摩尔定律。</p>
      </div>
      <div class="card">
        <h3>实验一 · 掺杂：给硅调味</h3>
        <p class="interact-desc">拖动<b>杂质浓度</b>：纯硅像玻璃一样堵住电流，掺入杂质后电流开始流动——这就是「掺杂（doping）」，晶体管可控性的来源（第 2 章）。</p>
        <div class="controls"><label>杂质浓度 = <span class="val" id="dopeV">0</span></label><input type="range" id="dopeS" min="0" max="10" step="1" value="0"></div>
        <canvas id="cvDope" width="720" height="190"></canvas><div class="status" id="stDope"></div>
      </div>
      <div class="card">
        <h3>实验二 · 光刻：用光印刷电路</h3>
        <p class="interact-desc">掩模挡住光，光从窗口透过照到晶圆上的<b>光刻胶</b>。拖动<b>曝光进度</b>：被光照到的胶溶解，掩模图案被「印」上晶圆（第 5 章）。</p>
        <div class="controls"><label>曝光进度 = <span class="val" id="lithoV">0</span>%</label><input type="range" id="lithoS" min="0" max="100" step="5" value="0"></div>
        <canvas id="cvLitho" width="720" height="210"></canvas><div class="status" id="stLitho"></div>
      </div>
      <div class="card">
        <h3>实验三 · 良率：一粒灰尘毁一片</h3>
        <p class="interact-desc">拖动<b>灰尘密度</b>：每粒随机落下的灰尘都可能砸坏一颗芯片。这就是为什么芯片厂要有无尘室，也是 mesa 时代良率低的原因（第 3、5 章）。</p>
        <div class="controls"><label>灰尘密度 = <span class="val" id="yieldV">0</span>%</label><input type="range" id="yieldS" min="0" max="100" step="5" value="0"></div>
        <canvas id="cvYield" width="720" height="330"></canvas><div class="status" id="stYield"></div>
      </div>
      <div class="card">
        <h3>实验四 · 摩尔定律：指数增长的震撼</h3>
        <p class="interact-desc">拖动<b>年份</b>看晶体管数量沿对数轴爬升。1965 年的一个预测，跑了半个世纪（第 6 章）。</p>
        <div class="controls"><label>年份 = <span class="val" id="mooreV">1965</span></label><input type="range" id="mooreS" min="1965" max="2020" step="5" value="1965"></div>
        <canvas id="cvMoore" width="720" height="240"></canvas><div class="status" id="stMoore"></div>
      </div>
    </section>
    <!-- 关于 -->
    <section class="page" id="page-about">
      <div class="page-head">
        <div class="kick">ABOUT THE GUIDE</div>
        <h2>关于你的导读人</h2>
      </div>
      <div class="card">
        <h3>克里斯·米勒（Chris Miller）</h3>
        <p>美国经济史学家，塔夫茨大学弗莱彻法律与外交学院教授。2022 年，他出版《芯片战争》（Chip War），把半导体七十年的历史写成一部大国权力的争夺史：从硅谷的实验室，到台湾的晶圆厂，再到华盛顿的出口管制清单。</p>
        <p>他写这本书，不是为了让读者记住几个发明家，而是让你看见：芯片是新的钢铁，谁控制它，谁就控制现代世界的命脉。而你正在做的每一道题，都是在帮你把这条权力地图装进脑子。</p>
        <div class="motto" style="margin-top:16px">「芯片是新的钢铁，战争换了材料。」<span class="who">—— 克里斯·米勒，《芯片战争》</span></div>
        <p style="margin-top:12px">他的四条读书规则，翻译成读这本书的方法就是：</p>
        <p>① <b>材料即权力</b>——每读一章先问：这一章的关键材料/技术是什么，谁在控制它。</p>
        <p>② <b>把人物放进棋盘</b>——诺伊斯、张忠谋、格鲁夫不是发明家列传，是权力棋盘上的棋手。</p>
        <p>③ <b>从实验室到战场</b>——每个技术突破，都要追问它被谁买走、用在哪场博弈里。</p>
        <p>④ <b>往回看因果</b>——今天的中美芯片战，因果链埋在四十年前的每一章里。</p>
      </div>
    </section>
    <footer>🐭 鼠哥的芯片战争读书学院 🧠 · 以米勒《芯片战争》为蓝本 · 进度存于本地浏览器</footer>
  </main>
</div>

  <div id="fabNav" class="fab-nav" style="display:none">
    <button id="fabHome" title="回主页"><span class="fab-tip">回主页</span>⌂</button>
    <button id="fabBack" title="返回章节列表"><span class="fab-tip">返回</span>←</button>
  </div>
  <button id="sideFab" class="side-fab" onclick="toggleSide()" title="展开侧栏">☰ 菜单</button>
<a class="exit-fab" id="exitFab" href="https://ndshuge.github.io/ndshuge-academy/" title="回到四学院门户">🚪 退出学院</a>

<script>
/* ================= 工具 ================= */
function $(s){return document.querySelector(s)}
function pick(a){return a[Math.floor(Math.random()*a.length)]}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function store(k,v){try{localStorage.setItem((k==='sb_session'?'academy_':'chip_')+k, JSON.stringify(v))}catch(e){}}
function load(k,d){try{var v=JSON.parse(localStorage.getItem((k==='sb_session'?'academy_':'chip_')+k)); return v===null?d:v}catch(e){return d}}
/* 每日目标登记（全站共享键 daily_goal，以 4:00 为界）：act='l' 学完一章 / act='e' 做完一份卷 */
function dailyGoal(act){
  try{
    var t = new Date(); if(t.getHours() < 4) t.setDate(t.getDate()-1);
    var d = t.getFullYear()+'-'+(t.getMonth()+1)+'-'+t.getDate();
    var g = JSON.parse(localStorage.getItem('daily_goal')||'{}');
    g[d] = g[d]||{}; g[d]['chip'] = g[d]['chip']||{};
    g[d]['chip'][act] = Date.now();
    localStorage.setItem('daily_goal', JSON.stringify(g));
  }catch(e){}
}

/* ================= 公式渲染（迷你 LaTeX，离线可用） ================= */
function parseMath(s){
  if(s===undefined||s===null) return '';
  s=String(s); var i=0, out='';
  function readGroup(){
    var depth=0, j=i;
    while(j<s.length){ if(s[j]==='{')depth++; if(s[j]==='}'){depth--; if(depth===0)break;} j++; }
    var g=s.slice(i+1,j); i=Math.min(j+1,s.length); return g;
  }
  while(i<s.length){
    var c=s[i];
    if(c==='\\'){
      if(s[i+1]==="'"||s[i+1]==='′'){out+='′'; i+=2; continue;}
      var m=/^[a-zA-Z]+/.exec(s.slice(i+1));
      if(m){
        var cmd=m[0]; i+=1+cmd.length;
        switch(cmd){
          case 'frac': {var a=readGroup(),b=readGroup(); out+='<span class="fr" style="display:inline-block;vertical-align:middle;text-align:center;margin:0 2px"><span style="display:block;border-bottom:1px solid currentColor;padding:0 4px">'+parseMath(a)+'</span><span style="display:block;padding:0 4px">'+parseMath(b)+'</span></span>'; break;}
          case 'lim': {var sub=''; if(s[i]==='_'){i++; sub=s[i]==='{'?readGroup():(s[i++]||'');} out+='<i>lim</i>'+(sub?'<sub>'+parseMath(sub)+'</sub>':''); break;}
          case 'int': {var lw='',up=''; if(s[i]==='_'){i++; lw=s[i]==='{'?readGroup():(s[i++]||'');} if(s[i]==='^'){i++; up=s[i]==='{'?readGroup():(s[i++]||'');} out+='<span style="font-size:1.35em">∫</span>'+(up?'<sup>'+parseMath(up)+'</sup>':'')+(lw?'<sub>'+parseMath(lw)+'</sub>':''); break;}
          case 'sum': {var lw2='',up2=''; if(s[i]==='_'){i++; lw2=s[i]==='{'?readGroup():(s[i++]||'');} if(s[i]==='^'){i++; up2=s[i]==='{'?readGroup():(s[i++]||'');} out+='<span style="font-size:1.25em">Σ</span>'+(up2?'<sup>'+parseMath(up2)+'</sup>':'')+(lw2?'<sub>'+parseMath(lw2)+'</sub>':''); break;}
          case 'sqrt': {var r=readGroup(); out+='√<span style="border-top:1px solid currentColor;padding:0 3px">'+parseMath(r)+'</span>'; break;}
          case 'pi': out+='π'; break;
          case 'theta': out+='θ'; break;
          case 'alpha': out+='α'; break;
          case 'beta': out+='β'; break;
          case 'gamma': out+='γ'; break;
          case 'delta': out+='δ'; break;
          case 'epsilon': out+='ε'; break;
          case 'varepsilon': out+='ε'; break;
          case 'xi': out+='ξ'; break;
          case 'phi': out+='φ'; break;
          case 'text': { var t=readGroup(); out+='<span>'+parseMath(t)+'</span>'; break; }
          case 'circ': out+='∘'; break;
          case 'deg': out+='°'; break;
          case 'iff': out+='⇔'; break;
          case 'cdots': out+='⋯'; break;
          case 'dots': out+='…'; break;
          case 'prime': out+='′'; break;
          case 'quad': out+='　'; break;
          case 'qquad': out+='　　'; break;
          case 'mathbb': { var b=readGroup(); out+=b; break; }
          case 'overline': { var o=readGroup(); out+='<span style="border-top:1px solid currentColor">'+parseMath(o)+'</span>'; break; }
          case 'left': case 'right': case 'big': case 'Big': case 'bigg': case 'Bigg': i++; break;
          case 'infty': out+='∞'; break;
          case 'to': out+='→'; break;
          case 'Rightarrow': out+='⇒'; break;
          case 'cdot': out+='·'; break;
          case 'times': out+='×'; break;
          case 'pm': out+='±'; break;
          case 'ne': out+='≠'; break;
          case 'le': out+='≤'; break;
          case 'ge': out+='≥'; break;
          case 'approx': out+='≈'; break;
          case 'in': out+='∈'; break;
          case 'sin': out+='<i>sin</i>'; break;
          case 'cos': out+='<i>cos</i>'; break;
          case 'tan': out+='<i>tan</i>'; break;
          case 'cot': out+='<i>cot</i>'; break;
          case 'sec': out+='<i>sec</i>'; break;
          case 'csc': out+='<i>csc</i>'; break;
          case 'ln': out+='<i>ln</i>'; break;
          case 'log': out+='<i>log</i>'; break;
          case 'exp': out+='<i>exp</i>'; break;
          case 'arcsin': out+='<i>arcsin</i>'; break;
          case 'arccos': out+='<i>arccos</i>'; break;
          case 'arctan': out+='<i>arctan</i>'; break;
          case 'sinh': out+='<i>sinh</i>'; break;
          case 'cosh': out+='<i>cosh</i>'; break;
          case 'tanh': out+='<i>tanh</i>'; break;
          default: out+=cmd;
        }
        continue;
      }
      out+=s[i+1]||''; i+=2; continue;
    }
    if(c==='^'){ i++; var su = s[i]==='{'?readGroup():(s[i++]||''); out+='<sup>'+parseMath(su)+'</sup>'; continue; }
    if(c==='_'){ i++; var sb = s[i]==='{'?readGroup():(s[i++]||''); out+='<sub>'+parseMath(sb)+'</sub>'; continue; }
    if(c==='<'){ out+='&lt;'; i++; continue; }
    if(c==='>'){ out+='&gt;'; i++; continue; }
    out+=c; i++;
  }
  return out;
}

