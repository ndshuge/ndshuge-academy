(function(){ PLAN = CHAPTERS.map(function(c){
  var ls = [];
  var n = Math.min(4, (c.map||[]).length);
  for(var i=1;i<=n;i++){ ls.push({k:c.id+'_'+i, t:(c.map[i-1]||('第'+i+'节'))}); }
  return {wk:'第 '+c.id+' 周', title:'第'+c.id+'章 '+c.title, lessons:ls};
}); })();

/* ================= 状态 ================= */
var lessonsDone = load('lessons', null);
if(lessonsDone === null){ lessonsDone = []; }
var chDone = load('ch', []);
var hallDone = load('hall', []);
var TOTAL_LESSONS = PLAN.reduce(function(s,w){ return s + w.lessons.length; }, 0);

/* ===== 错题集与已订正（两道闸门） ===== */
var wrongPool = load('wrong', null);
var fixedPool = load('fixed', []);
if(wrongPool === null){
  // 首次：从 quizStat 回溯历史错题（最近一次做错的）
  wrongPool = [];
  try{
    var qs0 = load('quizStat', {});
    Object.keys(qs0).forEach(function(k){ if(qs0[k] === 0) wrongPool.push(k); });
  }catch(e){}
  store('wrong', wrongPool);
}
function poolMove(key, correct){
  var inWrong = wrongPool.indexOf(key);
  var inFixed = fixedPool.indexOf(key);
  var moved = false;
  if(correct){
    if(inWrong > -1){ wrongPool.splice(inWrong, 1); fixedPool.push(key); moved = true; }
  } else {
    if(inFixed > -1){ fixedPool.splice(inFixed, 1); wrongPool.push(key); moved = true; }
    else if(inWrong === -1){ wrongPool.push(key); }
  }
  store('wrong', wrongPool); store('fixed', fixedPool);
  return moved;
}

/* 学习足迹：30 分钟内同一章的连续活动并作一次学习 */
var studyLog = load('log', []);
function logStudy(type, chId, chTitle){
  var now = Date.now();
  var _d = new Date(now), _p = function(x){ return (x<10?'0':'')+x; };
  var cat = _d.getFullYear()+'-'+_p(_d.getMonth()+1)+'-'+_p(_d.getDate())+' '+_p(_d.getHours())+':'+_p(_d.getMinutes())+':'+_p(_d.getSeconds());
  var last = studyLog.length ? studyLog[studyLog.length-1] : null;
  if(last && now - last.end < 30*60*1000 && last.ch === chId){
    last.end = now;
    last.completed_at = cat;
    if(type === 'lesson') last.lessonN = (last.lessonN||0) + 1;
    else last.quizN = (last.quizN||0) + 1;
  } else {
    studyLog.push({start: now, end: now, ch: chId, title: chTitle, lessonN: type==='lesson'?1:0, quizN: type==='quiz'?1:0, completed_at: cat});
  }
  if(studyLog.length > 3000) studyLog = studyLog.slice(-3000);
  store('log', studyLog);
}
/* ===== 统一学习记录：一课/一卷一条（30 分钟内同课连续做题自动合并）===== */
function sessionAcc(qs){
  var c2 = 0, n = 0;
  qs.forEach(function(k){ var v = quizStat[k]; if(v !== undefined){ n++; if(v === 1) c2++; } });
  return n ? Math.round(c2/n*100) : null;
}
function sessionLog(ty, c, key, ok){
  var now = Date.now();
  var last = studyLog.length ? studyLog[studyLog.length-1] : null;
  if(last && last.questions && last.ty === ty && last.ch === c.id && (now - last.end) < 30*60*1000){
    if(last.questions.indexOf(key) === -1) last.questions.push(key);
    last.end = now; last.ms = last.end - last.start;
    last.acc = sessionAcc(last.questions);
  } else {
    studyLog.push({ ty: ty, ch: c.id, title: c.title, questions: [key], start: now, end: now, ms: 0, acc: null });
    if(studyLog.length > 3000) studyLog = studyLog.slice(-3000);
  }
  store('log', studyLog);
}
function fmtMs(ms){
  if(!ms) return '0秒';
  var s = Math.round(ms/1000);
  if(s < 60) return s + '秒';
  if(s < 3600) return Math.round(s/60) + '分钟';
  return Math.floor(s/3600) + '时' + Math.round((s%3600)/60) + '分';
}
/* ===== 旧记录迁移：按课聚合转新格式（一章一条），旧题数保留 ===== */
function migrateLog(){
  // 净化：只保留规范的新格式记录（有 questions 且非空），不符合规范的直接删除（本地和云端拉取后都调用）
  if(!studyLog.length) return;
  var clean = studyLog.filter(function(l){
    if(!l || typeof l !== 'object') return false;
    if(l.questions && l.questions.length > 0) return true;          // 新做题记录：有真实题目
    if(l._n && l.ms && l.ms > 0 && l.ms < 24*3600*1000) return true; // 旧聚合条：有题数且用时合理（<24h，排除跨天坏条）
    return false;
  });
  if(clean.length !== studyLog.length){
    studyLog = clean;
    store('log', studyLog);
  }
}



/* 章节完成判定：本章所有随堂练习都做过 = 已学 */
function chQuizCount(c){ return c.quiz ? c.quiz.length : 0; }
function chQuizDone(c){ return c.quiz ? c.quiz.filter(function(q,i){ return quizStat[c.id+'_'+i] !== undefined; }).length : 0; }
function chIsDone(c){ return c.full && chQuizCount(c) > 0 && chQuizDone(c) === chQuizCount(c); }

/* 课 → 所属章节映射（用于做题自动跟进） */
var WEEK2CH = (function(){ var w={}; CHAPTERS.forEach(function(c){ w[c.id]=c.id; }); return w; })();
function lessonChapter(k){
  var p = String(k).split('_'), w = +p[0], n = +p[1];
  if(w === 16) return n <= 2 ? 15 : 16;
  if(w === 27) return n <= 2 ? 27 : 28;
  if(w === 28) return n <= 2 ? 29 : (n === 3 ? 30 : 0);
  return WEEK2CH[w];
}
/* 自动跟进：某章练习全做完 → 该章所有课自动标完成（做题即打卡，无需手动勾选） */
function autoSyncLessons(){
  var changed = false;
  CHAPTERS.forEach(function(c){
    if(!chIsDone(c)) return;
    PLAN.forEach(function(w){
      w.lessons.forEach(function(l){
        if(lessonChapter(l.k) === c.id && lessonsDone.indexOf(l.k) === -1){
          lessonsDone.push(l.k); changed = true;
        }
      });
    });
  });
  if(changed){ store('lessons', lessonsDone); dailyGoal('l'); renderPlan(); }
}

/* ================= 渲染：计划页 ================= */
function renderPlan(){
  var el = $('#planList');
  el.innerHTML = PLAN.map(function(w, wi){
    var doneN = w.lessons.filter(function(l){ return lessonsDone.indexOf(l.k) > -1; }).length;
    var allDone = doneN === w.lessons.length;
    var rows = w.lessons.map(function(l){
      var ck = lessonsDone.indexOf(l.k) > -1;
      return '<div class="lesson-row'+(ck?' on':'')+'" title="'+(ck?'已学完':'未学')+'">'+(ck?'<span class="ls">✓</span>':'')+'<span>'+esc(l.t)+'</span></div>';
    }).join('');
    return '<div class="week'+(allDone?' checked':'')+'" title="进度自动跟随学习"><span class="wk">'+w.wk+'</span><span class="wd">'+esc(w.title)+'</span><span class="st">'+doneN+'/'+w.lessons.length+' 课'+(allDone?' · 周完成':'')+'</span><div class="subs">'+rows+'</div></div>';
  }).join('');
  $('#planCnt').textContent = lessonsDone.length + '/' + TOTAL_LESSONS;
}
/* 学习计划只读：进度自动跟随学习，学到哪亮到哪，不支持手动勾选 */

/* ================= 渲染：课堂页 ================= */
var curCh = null;
function renderChSelect(){
  var el = $('#chSelect');
  el.innerHTML = CHAPTERS.map(function(c){
    var done = chIsDone(c);
    var st = done ? '✓ 已学' : (c.full ? '🎓 讲义已就位（'+chQuizDone(c)+'/'+chQuizCount(c)+' 题）' : '📚 待米勒开讲');
    return '<div class="ch-card'+(done?' done':'')+'" data-c="'+c.id+'"><div class="no">第 '+c.id+' 章</div><div class="t">'+c.title+'</div><div class="w">'+c.weeks+' · '+c.diff+(c.full?' · 已授':'')+'</div><div class="st'+(done?'':' empty')+'">'+st+'</div></div>';
  }).join('');
  el.querySelectorAll('.ch-card').forEach(function(card){
    card.addEventListener('click', function(){ openCh(+card.dataset.c); });
  });
}
function openCh(id){
  var c = CHAPTERS.filter(function(x){return x.id===id})[0];
  if(!c) return;
  curCh = c;
  var el = $('#chDetail');
  var h = '<button class="btn-back" onclick="closeCh()">← 返回章节列表</button>';
  h += '<div class="motto">'+esc(c.motto)+'<span class="who">—— '+esc(c.mottoWho)+'</span></div>';
  if(chIsDone(c)) h += '<div class="trap" style="background:#e8f8ee;border-color:rgba(52,199,89,.4)"><b>✦ 本章已学完</b>　随堂练习全部通关。回列表看看战果，或去练习大厅再巩固一遍。</div>';
  h += '<div class="card"><h3>知识地图</h3><div class="map">'+c.map.map(function(m){return '<span>'+esc(m)+'</span>'}).join('')+'</div></div>';
  if(c.story){
    h += '<div class="card story-card"><h3>芯片史话 · 这一章的来处</h3>';
    h += '<div class="story-head">'+((c.story.img && PORTRAITS[c.story.img]) ? '<img src="'+PORTRAITS[c.story.img]+'" alt="'+esc(c.story.tutor)+'画像" style="width:64px;height:80px;border-radius:6px;border:1px solid #537D96;object-fit:cover;flex-shrink:0">' : '<span style="width:64px;height:80px;border-radius:6px;border:1px solid #537D96;background:#F1E8D4;display:flex;align-items:center;justify-content:center;color:#3F6179;font-family:Georgia,serif;font-size:20px;flex-shrink:0">'+esc(c.story.tutor[0])+'</span>')+'</div>';
    h += '<div><div class="story-name">'+esc(c.story.tutor)+'</div><div class="story-era">'+esc(c.story.era)+'</div></div></div>';
    h += '<div class="story-fact">'+parseMath(c.story.fact)+'</div>';
    h += '<div class="story-quote">'+esc(c.story.quote)+'</div>';
    h += '<div class="story-anecdote"><b>轶事</b>　'+parseMath(c.story.story)+'</div>';
    h += '</div>';
  }
  if(c.story && c.story.interact){
    var it = c.story.interact;
    var ix0 = (it.xmin!=null)?it.xmin:-4, ix1 = (it.xmax!=null)?it.xmax:4;
    h += '<div class="card interact-card"><h3>👆 上手试试 · '+esc(it.title)+'</h3>';
    h += '<p class="interact-desc">'+esc(it.desc)+'</p>';
    h += '<div class="controls">x = <span class="val" id="fnXV">0.00</span>　<span class="val" style="color:var(--ochre)">f(x) = <span id="fnYV">—</span></span>';
    h += '<input type="range" id="fnXS" min="'+ix0+'" max="'+ix1+'" step="0.1" value="0"></div>';
    h += '<canvas id="cvFn" width="860" height="280"></canvas><div class="status" id="stFn"></div></div>';
  }
  if(c.full){
    c.sections.forEach(function(sec, s){
      h += '<div class="sec"><h4><em>§'+(s+1)+'</em>'+esc(sec.t)+'</h4><p>'+parseMath(sec.p)+'</p>'+(sec.formula?'<div class="formula">'+parseMath(sec.formula)+'</div>':'')+'</div>';
    });
    if(c.example){
      h += '<div class="card"><h3>例题 · 米勒式内心独白</h3><div class="example"><div class="lbl">SOLVE WITH YOUR INNER MONOLOGUE</div><p><b>'+parseMath(c.example.q)+'</b></p><p>'+parseMath(c.example.s)+'</p><p style="font-size:13px;color:var(--ink2);margin-top:8px">米勒的原话：看求解过程教不会你思考。先挡住解答自己试做，再对照这段「内心独白」——注意看我是怎么想出来的，而不是只看我写了什么。</p></div></div>';
    }
    h += '<div class="card"><h3>易错陷阱</h3>'+(c.traps.map(function(t,i){return '<div class="trap"><b>陷阱'+(i+1)+'</b>　'+parseMath(t)+'</div>'}).join(''))+'</div>';
    h += '<div class="card"><h3>随堂练习（即时批改）</h3><div class="quizwrap"></div></div>';
    h += '<div class="card dia"><h3>灵魂拷问（米勒的追问）</h3><p style="margin-bottom:8px">'+parseMath(c.dialogue.q)+'</p><textarea id="diaInput" placeholder="把你的想法写在这里……"></textarea><div class="act"><button id="diaBtn" class="primary">交给我自检</button><button id="diaSend">发给米勒精批</button></div><div id="diaResult"></div></div>';
    h += '<div style="text-align:center;margin-top:26px"><button id="btnSettle" style="border:none;background:linear-gradient(135deg,#537D96,#3F6179);color:#fff;border-radius:980px;padding:14px 44px;font-family:inherit;font-size:17px;cursor:pointer;font-weight:500;letter-spacing:2px;box-shadow:0 4px 16px rgba(83,125,150,.35)">🎓 结算本章</button><div style="font-size:12px;color:var(--muted);margin-top:8px">全部题目做完后，可结算一次；结算结果保存在下方</div><div id="settleResult" style="margin-top:16px"></div></div>';
  } else {
    h += '<div class="card"><p style="margin:6px 0">'+esc(c.note)+'</p><p style="color:var(--ink2);font-size:14px">在那之前，你可以先读教材本章，挡住解答做例题，把卡住的地方记下来问我。</p></div>';
  }
  el.innerHTML = h;
  el.style.display = 'block';
  $('#chSelect').style.display = 'none';
  setFabVisible(true);
  if(c.story && c.story.interact){
    drawFnInteract();
    var fs = document.getElementById('fnXS');
    if(fs) fs.addEventListener('input', drawFnInteract);
  }
  if(c.full){
    renderQuiz(c, el.querySelector('.quizwrap'));
    updateSummary(c, el.querySelector('.quizwrap'));
    var settleBtn = el.querySelector('#btnSettle');
    if(settleBtn) settleBtn.addEventListener('click', function(){ settleChapter(c, el); });
    renderSettleResult(c, el);
    var btn = el.querySelector('#diaBtn'), inp = el.querySelector('#diaInput'), res = el.querySelector('#diaResult');
    btn.addEventListener('click', function(){
      var txt = inp.value.trim();
      if(!txt){ res.innerHTML = '<div class="verdict show" style="display:block;background:#fff4e6;border:1px solid #ffd9a8"><div class="cm">你一个字都没写，我怎么给你批？怀疑可以，沉默不行。</div></div>'; return; }
      var hit = c.dialogue.keys.filter(function(k){ return txt.indexOf(k) > -1; });
      var pct = c.dialogue.keys.length ? Math.round(hit.length / c.dialogue.keys.length * 100) : 0;
      var grade = pct >= 70 ? '优秀' : pct >= 40 ? '及格' : '需补';
      var cm = pct >= 70 ? '思路已上路，关键词基本都踩中了。去把完整论证写顺，然后发给米勒精批。' : pct >= 40 ? '方向有了，但关键概念还没说透。看看「参考思路」，再补一遍。' : '这把没押中要害。先看参考思路，然后用自己的话重新写一遍。';
      res.innerHTML = '<div class="verdict show" style="display:block;background:var(--blue-bg);border:1px solid rgba(83,125,150,.3)"><div class="cm">关键词命中 '+hit.length+'/'+c.dialogue.keys.length+'，评级：'+grade+'。'+cm+'</div><div class="ex"><b>参考思路：</b>'+parseMath(c.dialogue.model)+'</div></div>';
    });
    el.querySelector('#diaSend').addEventListener('click', function(){
      var txt = inp.value.trim();
      res.innerHTML = '<div class="verdict show" style="display:block;background:#e8f8ee;border:1px solid rgba(52,199,89,.3)"><div class="cm">好，把你的这段话连同题目，复制到对话里发给潇湘（米勒会借她的嘴说话）。他会逐句批改你的论证，追问漏洞，再给你一道变式题练手。</div></div>';
    });
  }
}
function closeCh(){ curCh = null; $('#chDetail').innerHTML=''; $('#chDetail').style.display='none'; $('#chSelect').style.display=''; renderChSelect(); }

/* ================= 章节互动图（函数描点引擎，支持任意函数，讲义与实验室共用） ================= */
function drawFnInteract(){
  var it = (curCh && curCh.story && curCh.story.interact) ? curCh.story.interact : null;
  drawFnCard('cvFn', it, 'fnXV', 'fnYV', 'fnXS', 'stFn');
}
function drawFnCard(cvId, it, xvId, yvId, sliderId, stId){
  var cv = document.getElementById(cvId);
  if(!cv) return;
  var fnStr = (it && it.fn) ? it.fn : 'x*x/4+1';
  var xmin=(it&&it.xmin!=null)?it.xmin:-4, xmax=(it&&it.xmax!=null)?it.xmax:4;
  var ymin=(it&&it.ymin!=null)?it.ymin:-1, ymax=(it&&it.ymax!=null)?it.ymax:7;
  var label=(it&&it.label)?it.label:'y = f(x)';
  var fn;
  try{ fn = new Function('x','return ('+fnStr+');'); }catch(e){ fn = function(x){return x*x/4+1;}; }
  var W=860,H=280, PADL=45,PADR=20,PADT=20,PADB=28;
  cv.width=W; cv.height=H;
  var g=cv.getContext('2d');
  g.clearRect(0,0,W,H);
  function px(x){return PADL+(x-xmin)/(xmax-xmin)*(W-PADL-PADR);}
  function py(y){return PADT+(ymax-y)/(ymax-ymin)*(H-PADT-PADB);}
  g.strokeStyle='#D8CFBE';g.lineWidth=1;
  g.beginPath();g.moveTo(PADL,py(0));g.lineTo(W-PADR,py(0));g.stroke();
  g.beginPath();g.moveTo(px(0),PADT);g.lineTo(px(0),H-PADB);g.stroke();
  g.fillStyle='#6B6158';g.font='12px Georgia';
  g.fillText('x',W-PADR+2,py(0)+14);g.fillText('y',px(0)-14,PADT+4);
  for(var i=0;i<=8;i++){var x=xmin+(xmax-xmin)*i/8,pxx=px(x);g.beginPath();g.moveTo(pxx,py(0)-3);g.lineTo(pxx,py(0)+3);g.stroke();if(Math.abs(x)>1e-9)g.fillText(String(Math.round(x*10)/10),pxx-6,py(0)+14);}
  g.strokeStyle='#537D96';g.lineWidth=2;g.beginPath();
  var N=200,first=true;
  for(var j=0;j<=N;j++){var xv=xmin+(xmax-xmin)*j/N, yv=fn(xv);
    if(yv==null||!isFinite(yv)){first=true;continue;}
    if(yv<ymin-1||yv>ymax+1){first=true;continue;}
    var pxv=px(xv),pyv=py(yv);
    if(first){g.moveTo(pxv,pyv);first=false;}else g.lineTo(pxv,pyv);}
  g.stroke();
  // 第二条曲线（it.fn2，用于泰勒逼近、极限目标线等）
  if(it && it.fn2){
    var fn2;
    try{ fn2 = new Function('x','return ('+it.fn2+');'); }catch(e){ fn2 = null; }
    if(fn2){
      g.strokeStyle='#B07C46'; g.lineWidth=1.6; g.setLineDash([6,4]);
      g.beginPath(); var first2=true;
      for(var j2=0;j2<=N;j2++){
        var xv3=xmin+(xmax-xmin)*j2/N, yv3=fn2(xv3);
        if(yv3==null||!isFinite(yv3)||yv3<ymin-1||yv3>ymax+1){first2=true;continue;}
        var pxv3=px(xv3),pyv3=py(yv3);
        if(first2){g.moveTo(pxv3,pyv3);first2=false;}else g.lineTo(pxv3,pyv3);
      }
      g.stroke(); g.setLineDash([]);
    }
  }
  var sEl=document.getElementById(sliderId);
  var xv2 = sEl ? +sEl.value : 0;
  var yv2=fn(xv2);
  var finite = yv2 != null && isFinite(yv2);
  if(finite){
    g.fillStyle='#9D5F4D';g.beginPath();g.arc(px(xv2),py(yv2),5,0,6.283);g.fill();
    g.strokeStyle='#9D5F4D';g.lineWidth=1.2;g.setLineDash([3,3]);
    g.beginPath();g.moveTo(px(xv2),py(yv2));g.lineTo(px(xv2),py(0));g.stroke();
    g.beginPath();g.moveTo(px(xv2),py(yv2));g.lineTo(px(0),py(yv2));g.stroke();
    g.setLineDash([]);
    // 切线（it.tangent 时，数值差分求斜率）
    if(it && it.tangent){
      var h2 = Math.max((xmax-xmin)/400, 1e-6);
      var ya1 = fn(xv2-h2), ya2 = fn(xv2+h2);
      if(isFinite(ya1) && isFinite(ya2)){
        var m = (ya2-ya1)/(2*h2);
        g.strokeStyle='#B8860B'; g.lineWidth=1.6; g.setLineDash([]);
        g.beginPath();
        g.moveTo(px(xmin), py(yv2 + m*(xmin-xv2)));
        g.lineTo(px(xmax), py(yv2 + m*(xmax-xv2)));
        g.stroke();
        g.fillStyle='#B8860B'; g.font='12px Georgia';
        g.fillText('切线斜率 m ≈ '+m.toFixed(3), px(xv2)+8, py(yv2)+18);
      }
    }
    g.fillStyle='#3F6179';g.font='13px Georgia';
    g.fillText('('+xv2.toFixed(2)+', '+yv2.toFixed(2)+')',px(xv2)+8,py(yv2)-6);
  } else {
    // 该点无定义：画一条竖直标记提示
    g.strokeStyle='#9D5F4D';g.lineWidth=1.2;g.setLineDash([4,4]);
    g.beginPath();g.moveTo(px(xv2),PADT);g.lineTo(px(xv2),H-PADB);g.stroke();
    g.setLineDash([]);
    g.fillStyle='#9D5F4D';g.font='13px Georgia';
    g.fillText('此处函数无定义（0/0 或根号内为负等）', px(xv2)+8, PADT+16);
  }
  g.fillStyle='#6B6158';g.font='12px Georgia';
  g.fillText(label,px((xmin+xmax)/2),py(ymax-1));
  var xvEl=document.getElementById(xvId); if(xvEl) xvEl.textContent=xv2.toFixed(2);
  var yvEl=document.getElementById(yvId); if(yvEl) yvEl.textContent = finite ? yv2.toFixed(2) : '—';
  var st=document.getElementById(stId);
  if(st){
    if(finite){
      st.innerHTML = '<span style="color:var(--green)">✓ 自检通过</span> 点 ('+xv2.toFixed(2)+', '+yv2.toFixed(2)+') 由 '+label+' 算出，精确落在曲线上。'+(it && it.tangent ? ' 金色虚线即该点切线。' : '');
    } else {
      st.innerHTML = '<span style="color:var(--ochre)">⚠ 注意</span> x='+xv2.toFixed(2)+' 处 '+label+' 无定义（分母为零/根号内为负等）。这在芯片史里常常正是「极限」要讨论的地方。';
    }
  }
}

/* ================= 渲染：练习（即时批改） ================= */
function renderQuiz(c, container, mode){
  if(!c.quiz || !c.quiz.length){ if(container) container.innerHTML='<p style="color:var(--ink2)">本章练习待米勒出题。</p>'; return; }
  var html = c.quiz.map(function(q, i){
    var key = c.id + '_' + i;
    var isHall = mode === 'hall';
    var doneCls = (quizStat[key] !== undefined) ? ' done' : '';
    var doneTag = (quizStat[key] !== undefined) ? '<span class="hall-done-tag">✓ 已做</span>' : '';
    var qh = '<div class="quiz'+doneCls+'" data-k="'+key+'" data-mode="'+(mode||'lesson')+'"><div class="q"><span class="qn">Q'+(i+1)+'</span>'+doneTag+parseMath(q.q)+'</div>';
    if(q.type === 'choice'){
      qh += '<div class="opts">'+q.options.map(function(o, oi){
        return '<div class="opt" data-o="'+oi+'">'+String.fromCharCode(65+oi)+'. '+parseMath(o)+'</div>';
      }).join('')+'</div>';
    } else {
      var pvC = quizPick[key];
      var doneInC = mode !== 'hall' && quizStat[key] !== undefined && pvC !== undefined;
      qh += '<div class="fillrow"><input placeholder="输入答案（备用）" value="'+esc(pvC||'')+'"'+(doneInC?' disabled':'')+'><button'+(doneInC?' disabled':'')+'>批改</button></div>';
    }
    qh += '<div class="verdict"></div></div>';
    return qh;
  }).join('');
  if(container) container.innerHTML = html;
  var scope = container;
  scope.querySelectorAll('.quiz').forEach(function(qz){
    var key = qz.dataset.k, idx = key.split('_').map(Number);
    var q = CHAPTERS[idx[0]-1].quiz[idx[1]];
    var inLesson = mode !== 'hall';
    // 讲义：只有对错已存档（quizStat 有记录）的题才锁定显示上次结果；没存档的可以随时做
    var prevPick = quizStat[key];
    var done = inLesson && prevPick !== undefined;
    if(done){
      // 讲义：保留原样——做过就显示上次结果
      qz.dataset.lock = '1';
      if(q.type === 'choice'){
        qz.querySelectorAll('.opt').forEach(function(o){o.classList.add('lock')});
        var wasCorrect = prevPick === 1;
        // 如果有历史选择（存了选的选项），标出错选
        var pick = quizPick[key];
        if(prevPick !== undefined){
          if(pick !== undefined && !wasCorrect){
            qz.querySelectorAll('.opt')[pick].classList.add('bad');
            qz.querySelectorAll('.opt')[q.answer].classList.add('ok');
            mark2(qz, q, false, '上次答错，正确答案已标出，重学后去练习大厅再战。');
          } else {
            qz.querySelectorAll('.opt')[q.answer].classList.add('ok');
            mark2(qz, q, true, '已答对，保持住！');
          }
        } else {
          // 旧数据：hallDone 有但 quizStat 无，对错未存档
          mark2(qz, q, false, '旧记录：这题做过但对错未存档。去练习大厅重做一遍，结算才能计入。');
        }
      }
    }
    if(q.type === 'choice'){
      qz.querySelectorAll('.opt').forEach(function(opt){
        opt.addEventListener('click', function(){
          if(qz.dataset.lock) return;
          var oi = +opt.dataset.o;
          qz.dataset.lock = '1';
          opt.classList.add(oi === q.answer ? 'ok' : 'bad');
          if(oi !== q.answer) qz.querySelectorAll('.opt')[q.answer].classList.add('ok');
          qz.querySelectorAll('.opt').forEach(function(o){o.classList.add('lock')});
          storePick(key, oi);
          storeCorrect(key, oi === q.answer);
          poolMove(key, oi === q.answer);
          todayRecord(oi === q.answer);
          statRecordQ(oi === q.answer);
          if(inLesson && hallDone.indexOf(key) === -1){ hallDone.push(key); store('hall', hallDone); }
          sessionLog('lesson', c, key, oi === q.answer);
          mark(qz, q, oi === q.answer);
          if(inLesson){ updateSummary(c, container); }
          renderHallNav(); renderAll(); renderStats(); sbNotify();
          if(!inLesson) updateHallHistory(c, container);
        });
      });
    } else {
      var btn = qz.querySelector('button'), inp = qz.querySelector('input');
      btn.addEventListener('click', function(){
        if(qz.dataset.lock) return;
        var val = inp.value.trim();
        if(!val) return;
        qz.dataset.lock = '1';
        var ok = q.accept.some(function(a){ return numEq(a, val); });
        storeCorrect(key, ok);
        storePick(key, val);
        poolMove(key, ok);
        todayRecord(ok);
        statRecordQ(ok);
        if(inLesson && hallDone.indexOf(key) === -1){ hallDone.push(key); store('hall', hallDone); }
        sessionLog('lesson', c, key, ok);
        mark(qz, q, ok);
        if(inLesson){ updateSummary(c, container); }
        renderHallNav(); renderAll(); renderStats(); sbNotify();
        if(!inLesson) updateHallHistory(c, container);
      });
      inp.addEventListener('keydown', function(e){ if(e.key==='Enter') btn.click(); });
    }
  });
}
function numEq(a, b){
  function val(x){
    if(typeof x === 'number') return x;
    var s = String(x).replace(/×/g,'*').replace(/π/g,'Math.PI').replace(/pi/g,'Math.PI').replace(/sqrt/g,'Math.sqrt').replace(/√/g,'Math.sqrt(').trim();
    s = s.replace(/(^|[^A-Za-z])e(?=[\^0-9(\-]|$)/g, '$1Math.E');
    s = s.replace(/Math\.E\^/g,'Math.E**');
    if(/[a-zA-Z]/.test(s.replace(/Math\.|PI|sqrt|E|e/g,''))) return NaN;
    try{ return eval(s); }catch(e){ return NaN; }
  }
  var A = val(a), B = val(b);
  if(isNaN(A) || isNaN(B)) return String(a).replace(/\s/g,'').toLowerCase() === String(b).replace(/\s/g,'').toLowerCase();
  return Math.abs(A-B) < 1e-6;
}
function mark(qz, q, ok){
  var v = qz.querySelector('.verdict');
  v.className = 'verdict show ' + (ok ? 'right' : 'wrong');
  v.innerHTML = '<div class="cm">'+(ok ? pick(RIGHT_CM) : pick(WRONG_CM))+'</div><div class="ex">'+parseMath(q.explain)+'</div>';
}

/* ================= 做题小结结算 ================= */
function updateSummary(c, container){
  if(!container) return;
  var total = c.quiz ? c.quiz.length : 0;
  if(!total) return;
  var answered = 0, correct = 0;
  c.quiz.forEach(function(q, i){
    var st = quizStat[c.id+'_'+i];
    if(st !== undefined){ answered++; if(st === 1) correct++; }
  });
  var pct = answered ? Math.round(correct/answered*100) : 0;
  var allDone = answered >= total;
  var allCorrect = allDone && correct >= total;
  var enc = allCorrect ? '全通！' : (pct >= 80 ? '状态极佳' : (pct >= 60 ? '渐入佳境' : (answered ? '继续加练' : '等你开答')));
  var el = container.querySelector('.summary-card');
  if(!el){
    el = document.createElement('div');
    el.className = 'card summary-card';
    container.appendChild(el);
  }
  el.innerHTML = '<h3>📊 本章小结</h3>'+
    '<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">'+
      '<div><div style="font-size:12px;color:var(--muted)">已答</div><div style="font-size:22px;font-weight:600;color:var(--blue);font-variant-numeric:tabular-nums">'+answered+'/'+total+'</div></div>'+
      '<div><div style="font-size:12px;color:var(--muted)">答对</div><div style="font-size:22px;font-weight:600;color:var(--green);font-variant-numeric:tabular-nums">'+correct+'</div></div>'+
      '<div><div style="font-size:12px;color:var(--muted)">正确率</div><div style="font-size:22px;font-weight:600;color:'+(pct>=80?'var(--green)':(pct>=60?'var(--ochre)':'var(--red)'))+';font-variant-numeric:tabular-nums">'+pct+'%</div></div>'+
    '</div>'+
    '<div style="margin-top:10px;font-size:14px;color:var(--ink2)">'+enc+
    (allCorrect ? '　👑 本章全部通关，徽章已点亮，可以放心进入下一章。' : '　继续把剩下的题答完，小结会实时更新。')+'</div>';
  if(allCorrect && !(chDone||[]).includes(c.id)){
    chDone.push(c.id); store('ch', chDone);
    renderAll(); renderChSelect();
  }
}
function qzStatusCorrect(c, i){
  // 从 DOM 判断该题是否答对（优先），否则从 hallDone 无法判断对错，回退用 DOM
  var qz = document.querySelector('.quiz[data-k="'+c.id+'_'+i+'"]');
  if(qz){
    var okOpt = qz.querySelector('.opt.ok');
    var badOpt = qz.querySelector('.opt.bad');
    if(badOpt) return false;
    if(okOpt) return true;
  }
  return false;
}

/* ================= 答题对错持久化 + 章节结算 ================= */
var quizStat = load('quizStat', {});
var quizPick = load('quizPick', {});
function storeCorrect(key, ok){
  quizStat[key] = ok ? 1 : 0;
  store('quizStat', quizStat);
}
function storePick(key, oi){
  quizPick[key] = oi;
  store('quizPick', quizPick);
}
function mark2(qz, q, ok, custom){
  var v = qz.querySelector('.verdict');
  v.className = 'verdict show ' + (ok ? 'right' : 'wrong');
  v.innerHTML = '<div class="cm">'+(custom || (ok ? pick(RIGHT_CM) : pick(WRONG_CM)))+'</div><div class="ex">'+parseMath(q.explain)+'</div>';
}
function updateHallHistory(c, container){
  // 大厅历史：错哪道/错几道/错误率（简洁）
  if(!container || !c.quiz) return;
  var wrong = [], answered = 0;
  c.quiz.forEach(function(q, i){
    var k = c.id+'_'+i;
    if(quizStat[k] !== undefined){ answered++; if(quizStat[k] !== 1) wrong.push(i+1); }
  });
  if(!answered) return;
  var pct = Math.round((answered-wrong.length)/answered*100);
  var el = container.querySelector('.hall-history');
  if(!el){
    el = document.createElement('div');
    el.className = 'hall-history';
    el.style.cssText = 'background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin-bottom:12px;font-size:13px;color:var(--ink2)';
    container.insertBefore(el, container.firstChild);
  }
  el.innerHTML = '<b style="color:var(--blue)">📜 历史记录</b>　已做 '+answered+'/'+c.quiz.length+' 题 · 错 '+(wrong.length?'第 '+wrong.join('、')+' 题':'无')+' · 错误率 '+pct+'%';
}
function chTotalSeconds(c){
  // 从学习足迹汇总本章累计用时（毫秒→秒）
  var ms = 0;
  studyLog.forEach(function(s){
    if(s.ch === c.id) ms += Math.max(0, (s.end||s.start) - s.start);
  });
  return Math.round(ms/1000);
}
function fmtDur(sec){
  if(sec < 60) return sec+' 秒';
  if(sec < 3600) return Math.floor(sec/60)+' 分 '+(sec%60)+' 秒';
  return Math.floor(sec/3600)+' 时 '+Math.floor((sec%3600)/60)+' 分';
}
function settleChapter(c, pageEl){
  // 检查是否全部做完（quizStat 优先，缺失时尝试从当前讲义 DOM 补判）
  var total = c.quiz ? c.quiz.length : 0;
  var answered = 0;
  var dirty = false;
  c.quiz.forEach(function(q, i){
    var k = c.id+'_'+i;
    var st = quizStat[k];
    if(st === undefined && pageEl){
      // 从讲义 DOM 读该题对错（如果页面开着且已答）
      var qz = pageEl.querySelector('.quiz[data-k="'+k+'"]');
      if(qz && qz.dataset.lock === '1'){
        if(qz.querySelector('.opt.bad')) st = 0;
        else if(qz.querySelector('.opt.ok')) st = 1;
        if(st !== undefined){ quizStat[k] = st; dirty = true; }
      }
    }
    if(st !== undefined) answered++;
  });
  if(dirty) store('quizStat', quizStat);
  if(answered < total){
    alert('还有 '+(total-answered)+' 题没做完（或对错未存档）。把题做完，才能结算本章。');
    return;
  }
  var correct = 0;
  c.quiz.forEach(function(q, i){ if(quizStat[c.id+'_'+i] === 1) correct++; });
  var pct = Math.round(correct/total*100);
  var dur = chTotalSeconds(c);
  var allCorrect = correct >= total;
  var doneL = lessonsDone.length, totalL = TOTAL_LESSONS;
  var doneC = CHAPTERS.filter(chIsDone).length, totalC = CHAPTERS.length;
  var overall = Math.round((doneL/totalL*0.6 + doneC/totalC*0.4)*100);
  var settle = { pct:pct, correct:correct, total:total, dur:dur, allCorrect:allCorrect, overall:overall, ts:Date.now() };
  var settleKey = 'settle_'+c.id;
  settleStore[settleKey] = settle;
  store('settle', settleStore);
  doCheckin();
  // 全做完点亮徽章（不再要求全对）
  if(chDone.indexOf(c.id) === -1){
    chDone.push(c.id); store('ch', chDone);
    renderAll(); renderChSelect();
  }
  renderSettleResult(c, pageEl);
  showSettlePanel(c, settle);
}
var settleStore = load('settle', {});
function renderSettleResult(c, pageEl){
  var box = pageEl ? pageEl.querySelector('#settleResult') : document.getElementById('settleResult');
  if(!box) return;
  var s = settleStore['settle_'+c.id];
  if(!s){ box.innerHTML=''; return; }
  var outdated = s.total !== c.quiz.length;
  var dt = new Date(s.ts);
  var dateStr = (dt.getMonth()+1)+'月'+(dt.getDate())+'日 '+dt.getHours()+':'+(dt.getMinutes()<10?'0':'')+dt.getMinutes();
  box.innerHTML = '<div style="background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 20px;box-shadow:var(--shadow)">' +
    '<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px"><b style="font-size:15px;color:var(--ink)">📜 已结算</b><span style="font-size:12px;color:var(--muted)">'+dateStr+(outdated ? ' · 旧版（'+s.total+' 题）' : ' · 仅结算一次，结果已存档')+'</span></div>' +
    (outdated ? '<div style="background:rgba(212,169,42,.12);border:1px solid rgba(212,169,42,.4);border-radius:8px;padding:8px 12px;margin-bottom:10px;font-size:13px;color:var(--ink2)">⚠️ 本章题目已更新（'+s.total+' → '+c.quiz.length+' 题），点下方按钮重新结算。</div>' : '') +
    '<div style="display:flex;flex-wrap:wrap;gap:18px;font-size:14px">' +
      '<span>正确率 <b style="color:'+(s.pct>=80?'var(--green)':(s.pct>=60?'var(--ochre)':'var(--red)'))+'">'+s.pct+'%</b>（'+s.correct+'/'+s.total+'）</span>' +
      '<span>用时 <b style="color:var(--blue)">'+fmtDur(s.dur)+'</b></span>' +
      '<span>里程碑 <b style="color:var(--blue)">总进度 '+s.overall+'%</b></span>' +
      (s.allCorrect ? '<span style="color:var(--green)">👑 全通</span>' : '') +
    '</div></div>';
  var btn = pageEl ? pageEl.querySelector('#btnSettle') : document.getElementById('btnSettle');
  if(btn){
    if(outdated){
      btn.textContent = '🎓 重新结算（题目已更新）';
      btn.style.background = 'linear-gradient(135deg,#537D96,#3F6179)';
      btn.style.cursor = 'pointer';
      btn.style.boxShadow = '0 4px 16px rgba(83,125,150,.35)';
      btn.style.pointerEvents = 'auto';
    } else {
      btn.textContent = '✅ 本章已结算';
      btn.style.background = '#C9C2B4';
      btn.style.cursor = 'default';
      btn.style.boxShadow = 'none';
      btn.style.pointerEvents = 'none';
    }
  }
}
function showSettlePanel(c, settle){
  var pct = settle.pct, correct = settle.correct, total = settle.total, dur = settle.dur, allCorrect = settle.allCorrect, overall = settle.overall;
  var enc;
  if(allCorrect) enc = '完美收官！你的每一步都有据可依，这正是米勒最想看到的。「怀疑一切，但你已经用正确率证明了自己。」';
  else if(pct >= 80) enc = '状态极佳！错的那几道，正是下次要盯紧的猎物。复习一遍错题，你就圆满了。';
  else if(pct >= 60) enc = '渐入佳境。数学是肌肉记忆，练到条件反射，你就是下一个过关的人。';
  else enc = '不丢人，这一章确实硬。回去把错题重做一遍，48 小时内再来，你会看到自己长高。';
  var mile = '已攻克 '+CHAPTERS.filter(chIsDone).length+'/'+CHAPTERS.length+' 章 · 总进度 '+overall+'%';
  if(allCorrect) mile += ' · 👑 本章全通徽章已点亮';
  var wrap = document.createElement('div');
  wrap.style.cssText = 'position:fixed;inset:0;background:rgba(42,38,34,.55);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;overflow:auto';
  var box = document.createElement('div');
  box.style.cssText = 'background:#FBF7EE;border-radius:16px;padding:26px 30px;max-width:560px;width:100%;box-shadow:0 16px 60px rgba(0,0,0,.3);border:1px solid var(--line);max-height:90vh;overflow:auto';
  var html = '<div style="font-size:11px;letter-spacing:2px;color:var(--blue);font-weight:600;text-transform:uppercase">CHAPTER SETTLEMENT</div>' +
    '<h2 style="font-family:Georgia,\'Songti SC\',serif;font-size:24px;font-weight:500;color:var(--ink);margin:4px 0 2px">第 '+c.id+' 章 · 结算报告</h2>' +
    '<div style="font-size:14px;color:var(--muted);margin-bottom:16px">'+esc(c.title)+'</div>' +
    '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px">' +
      '<div style="background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center"><div style="font-size:11px;color:var(--muted)">正确率</div><div style="font-size:26px;font-weight:600;color:'+(pct>=80?'var(--green)':(pct>=60?'var(--ochre)':'var(--red)'))+'">'+pct+'%</div><div style="font-size:12px;color:var(--muted)">'+correct+'/'+total+' 对</div></div>' +
      '<div style="background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center"><div style="font-size:11px;color:var(--muted)">本章用时</div><div style="font-size:20px;font-weight:600;color:var(--blue)">'+fmtDur(dur)+'</div><div style="font-size:12px;color:var(--muted)">累计学习时长</div></div>' +
      '<div style="background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center"><div style="font-size:11px;color:var(--muted)">本章题量</div><div style="font-size:26px;font-weight:600;color:var(--ink)">'+total+'</div><div style="font-size:12px;color:var(--muted)">全部完成</div></div>' +
    '</div>' +
    '<div style="font-size:13px;color:var(--muted);margin-bottom:8px">本章内容</div>' +
    '<div class="map" style="margin-bottom:16px">'+(c.map||[]).map(function(m){return '<span>'+esc(m)+'</span>'}).join('')+'</div>' +
    '<div style="background:var(--blue-bg);border:1px solid rgba(83,125,150,.25);border-radius:10px;padding:12px 14px;margin-bottom:12px;font-size:13.5px;color:var(--ink2)"><b style="color:var(--blue)">里程碑</b>　'+mile+'</div>' +
    '<div style="background:rgba(157,95,77,.07);border:1px solid rgba(157,95,77,.2);border-radius:10px;padding:14px 16px;font-size:14px;color:var(--ink2);line-height:1.8"><b style="color:var(--ochre)">米勒说</b>　'+enc+'</div>';
  var close = document.createElement('button');
  close.textContent = '收下这份结算';
  close.style.cssText = 'display:block;margin:18px auto 0;border:none;background:var(--blue);color:#fff;border-radius:980px;padding:10px 28px;font-family:inherit;font-size:15px;cursor:pointer;font-weight:500';
  close.addEventListener('click', function(){ wrap.remove(); });
  box.innerHTML = html;
  box.appendChild(close);
  wrap.appendChild(box);
  document.body.appendChild(wrap);
}

/* ================= 渲染：大厅 ================= */
var hallCh = 0;
function renderHallNav(){
  var nav = $('#hallNav');
  var hallUnique = [];
  hallDone.forEach(function(k){ if(k.charAt(0) !== 'e' && hallUnique.indexOf(k) === -1) hallUnique.push(k); });
  var cnts = CHAPTERS.map(function(c){ return hallUnique.filter(function(k){ return k.split('_')[0] == c.id; }).length; });
  var total = CHAPTERS.reduce(function(s,c){ return s + (c.quiz?c.quiz.length:0); }, 0);
  nav.innerHTML = '<button class="opt" style="border:1px solid var(--blue);background:'+(hallCh===0?'var(--blue-bg)':'transparent')+'" data-c="0">全部 ('+hallUnique.length+'/'+total+')</button>' +
    CHAPTERS.filter(function(c){return c.quiz && c.quiz.length}).map(function(c){
      return '<button class="opt" style="border:1px solid var(--blue);background:'+(hallCh===c.id?'var(--blue-bg)':'transparent')+'" data-c="'+c.id+'">第'+c.id+'章 ('+cnts[c.id-1]+'/'+c.quiz.length+')</button>';
    }).join('');
  nav.querySelectorAll('button').forEach(function(b){
    b.addEventListener('click', function(){
      hallCh = +b.dataset.c;
      renderHall();
    });
  });
}
function renderHall(){
  renderHallNav();
  var list = CHAPTERS.filter(function(c){ return hallCh === 0 || c.id === hallCh; });
  var container = $('#hallList');
  container.innerHTML = '';
  var wraps = [];
  list.forEach(function(c){
    if(!c.quiz || !c.quiz.length) return;
    container.innerHTML += '<div class="card" style="padding:16px 20px"><h3 style="margin-bottom:4px">第'+c.id+'章 · '+c.title+'</h3><div class="quizwrap"></div></div>';
    var all = container.querySelectorAll('.quizwrap');
    wraps.push(all[all.length-1]);
  });
  list.forEach(function(c, ci){ if(c.quiz && c.quiz.length){ renderQuiz(c, wraps[ci], 'hall'); updateHallHistory(c, wraps[ci]); } });
}

/* ================= 渲染：问答页 ================= */
function renderAsk(){
  var el = $('#askList');
  el.innerHTML = CHAPTERS.filter(function(c){ return c.full && c.dialogue.q; }).map(function(c){
    return '<div class="trap" style="background:var(--blue-bg);border-color:rgba(83,125,150,.25);margin:10px 0"><b>第'+c.id+'章 · '+c.title+'</b><br>'+parseMath(c.dialogue.q)+'<br><span style="font-size:13px;color:var(--ink2)">→ 去「章节课堂」该章底部作答，或直接复制题目来对话里考自己。</span></div>';
  }).join('');
}

/* ================= 渲染：学习足迹 ================= */
function fmtDT(ts){
  var d = new Date(ts), p = function(x){ return (x<10?'0':'')+x; };
  return p(d.getMonth()+1)+'-'+p(d.getDate())+' '+p(d.getHours())+':'+p(d.getMinutes());
}
function traceTodayCount(){
  var t0 = new Date(); t0.setHours(0,0,0,0);
  return studyLog.filter(function(s){ return s.start >= t0.getTime(); }).length;
}
function renderTrace(){
  var el = $('#traceList');
  if(!el) return;
  if(!studyLog.length){
    el.innerHTML = '<div class="card"><p style="color:var(--ink2)">还没有学习记录。去「章节课堂」打开一课，或做几道题，足迹会自动生成。</p></div>';
    return;
  }
  var today = new Date(); today.setHours(0,0,0,0);
  var yest = today.getTime() - 86400000;
  var groups = [];
  studyLog.slice().reverse().forEach(function(s2){
    var st = s2.start || s2.t || Date.now();
    var d = new Date(st); d.setHours(0,0,0,0);
    var g = groups.length ? groups[groups.length-1] : null;
    if(!g || g.key !== d.getTime()) groups.push({key: d.getTime(), items:[s2]});
    else g.items.push(s2);
  });
  var htm = groups.map(function(g){
    var d = new Date(g.key);
    var todayK = g.key === today.getTime();
    var yestK = g.key === yest;
    var head = todayK ? '今天' : (yestK ? '昨天' : (d.getMonth()+1)+'月'+d.getDate()+'日');
    var items = g.items.map(function(s3){
      if(s3.questions){
        var d1 = new Date(s3.start), d2 = new Date(s3.end);
        var t1 = ('0'+d1.getHours()).slice(-2)+':'+('0'+d1.getMinutes()).slice(-2);
        var t2 = ('0'+d2.getHours()).slice(-2)+':'+('0'+d2.getMinutes()).slice(-2);
        var ic = s3.ty==='exam' ? '📝' : '📖';
        var accTxt = (s3.acc===null||s3.acc===undefined) ? '' : ' · 正确率 '+s3.acc+'%';
        var msTxt = ' · 用时 '+fmtMs(s3.ms);
        var qn = s3.questions.length || s3._n || 0;
        return '<div class="trace-item"><span class="tm">'+t1+'</span><span class="tt">'+ic+' '+esc(s3.title)+' · '+qn+' 题'+accTxt+msTxt+'<br><span style="font-size:10.5px;color:var(--muted)">'+t1+' - '+t2+'</span></span></div>';
      }
      var d3 = new Date(s3.start || s3.t);
      var t3 = ('0'+d3.getHours()).slice(-2)+':'+('0'+d3.getMinutes()).slice(-2);
      return '<div class="trace-item"><span class="tm">'+t3+'</span><span class="tt">'+esc(s3.title || s3.x || '')+'</span></div>';
    }).join('');
    return '<div class="trace-day">'+head+'</div>'+items;
  }).join('');
  el.innerHTML = htm;
}

/* ================= 渲染：错题集与订正 ================= */
function renderWrongNav(){
  var w = $('#wrongCnt'); if(w) w.textContent = wrongPool.length ? ('待订正 '+wrongPool.length) : '';
  var f = $('#fixedCnt'); if(f) f.textContent = fixedPool.length ? ('已订正 '+fixedPool.length) : '';
}
/* 荣誉称号 16 档 */
var RANKS = [[0,'初入晶圆厂'],[10,'材料学徒'],[18,'开关手'],[25,'集成匠'],[32,'光刻学徒'],[40,'代工学徒'],[48,'海峡观察员'],[58,'断供老兵'],[70,'芯片战争史官'],[85,'晶圆领主'],[100,'芯片传人']];
function curRank(pct){
  var name = RANKS[0][1], next = null, nextAt = null;
  for(var i=0;i<RANKS.length;i++){
    if(pct >= RANKS[i][0]){ name = RANKS[i][1]; nextAt = (i+1<RANKS.length) ? RANKS[i+1][0] : null; next = (i+1<RANKS.length) ? RANKS[i+1][1] : null; }
  }
  return {name:name, next:next, nextAt:nextAt, remain: nextAt!==null ? (nextAt-pct) : 0};
}
/* 统一统计（总进度 = 课0.35 + 章0.25 + 卷0.2 + 错题订正0.2，任何活动都推动） */
function calcStats(){
  var doneL = lessonsDone.length, totalL = TOTAL_LESSONS;
  var doneC = CHAPTERS.filter(chIsDone).length, totalC = CHAPTERS.length;
  var doneW = PLAN.filter(function(w){ return w.lessons.every(function(l){ return lessonsDone.indexOf(l.k) > -1; }); }).length;
  var examTotal = CHAPTERS.filter(function(c){ return c.exam; }).length;
  var examFull = CHAPTERS.filter(function(c){ return c.exam && examStatus(c).full; }).length;
  var wrongN = fixedPool.length + wrongPool.length;
  var base = doneL/totalL*0.35 + doneC/totalC*0.25 + (examTotal ? examFull/examTotal*0.2 : 0);
  var pct;
  if(wrongN){
    // 有错题：四维全算（错题订正 = 已订正/总错题）
    pct = Math.round((base + fixedPool.length/wrongN*0.2)*100);
  } else {
    // 无错题：错题维度不参与，其余三维权重归一，避免白送 20 分
    pct = Math.round(base/0.8*100);
  }
  return {doneL:doneL,totalL:totalL,doneC:doneC,totalC:totalC,doneW:doneW,examTotal:examTotal,examFull:examFull,wrongN:wrongN,fixedPool:fixedPool.length,wrongPool:wrongPool.length,pct:pct,todayCount:traceTodayCount(),studyCount:studyLog.length};
}
/* 徽章 14 枚（战役 8 + 动态 6） */
var BADGES = [
  {n:'材料学徒', d:'完成第一部分（第 5 周 光刻战役）', c:function(s){ return s.doneW>=5; }},
  {n:'开关手', d:'完成第二部分（第 10 周 美国电路）', c:function(s){ return s.doneW>=10; }},
  {n:'集成匠', d:'完成第三部分（第 15 周 领导力丧失）', c:function(s){ return s.doneW>=15; }},
  {n:'起飞乘客', d:'完成第四部分（第 20 周 美国复苏）', c:function(s){ return s.doneW>=20; }},
  {n:'光刻学徒', d:'完成第五部分（第 25 周 集成世界）', c:function(s){ return s.doneW>=25; }},
  {n:'代工学徒', d:'完成第六部分（第 30 周 离岸创新）', c:function(s){ return s.doneW>=30; }},
  {n:'断供老兵', d:'完成第七部分（第 35 周 中国的挑战）', c:function(s){ return s.doneW>=35; }},
  {n:'芯片史官', d:'完成第八部分（第 40 周 芯片扼流圈）', c:function(s){ return s.doneW>=40; }},
  {n:'卷子初满', d:'任意一章小卷满分', c:function(s){ return s.examFull>=1; }},
  {n:'卷子全满', d:'全部小卷满分', c:function(s){ return s.examTotal>0 && s.examFull>=s.examTotal; }},
  {n:'错题清零', d:'错题全部订正', c:function(s){ return s.wrongPool===0 && s.fixedPool>0; }},
  {n:'学习启航', d:'累计学习 5 次', c:function(s){ return s.studyCount>=5; }},
  {n:'今日打卡', d:'今日完成一章练习或一份卷（四院共通）', c:function(s){ try{ var g=JSON.parse(localStorage.getItem('daily_goal')||'{}'); var t=new Date(); if(t.getHours()<4) t.setDate(t.getDate()-1); var k=t.getFullYear()+'-'+(t.getMonth()+1)+'-'+t.getDate(); var d0=g[k]; return !!(d0 && d0.chip && (d0.chip.l||d0.chip.e)); }catch(e){ return false; } }},
  {n:'毕业学士', d:'全册通关（全书章节全通）', c:function(s){ return s.doneL>=s.totalL && s.doneC>=s.totalC; }}
];
function badgeState(s){ return BADGES.map(function(b){ return {n:b.n, d:b.d, got:b.c(s)}; }); }
/* 今日答题统计（跨天自动重置） */
var todayStat = load('tstat', {d:'', done:0, correct:0});
/* ===== 统计体系 v2：题数做一题+1 / 时长只算做题界面 / 正确率=对÷总 ===== */
var stat = load('stat', null);
function statTodayKey(){ return new Date().toDateString(); }
function initStat(){
  var k = statTodayKey();
  if(!stat || stat.day !== k){
    // 跨天或首次：今日数据重置，总量保留
    var base = stat || {};
    stat = {
      totalQ: base.totalQ || 0, totalCorrect: base.totalCorrect || 0,
      totalMs: base.totalMs || 0,
      todayQ: 0, todayCorrect: 0, todayMs: 0, todayReal: 0, accQ: 0, accC: 0, day: k
    };
  }
  // 首次初始化：从历史 quizStat 迁移总量（过去做过的题算进累计）
  if(!stat._migrated){
    // 真实数据：按题去重的做题记录（quizStat）
    var qkeys = Object.keys(quizStat || {});
    stat.totalQ = qkeys.length;
    stat.accQ = qkeys.length;
    var cc = 0; qkeys.forEach(function(kk){ if(quizStat[kk] === 1) cc++; });
    stat.accC = cc;
    stat.totalCorrect = cc;
    stat._migrated = true;
  }
  // 今日题数/时长从启用时刻起真实累计，不迁移历史（历史无法真实恢复）
  storeStat();
}function storeStat(){ store('stat', stat); }
function statRecordQ(ok){
  if(!stat) return;
  stat.totalQ++; stat.todayQ++; stat.todayReal++;
  stat.accQ++; if(ok) stat.accC++;
  if(ok){ stat.totalCorrect++; stat.todayCorrect++; }
  storeStat();
}
/* ===== 连续打卡：结算一章算打卡一天 ===== */
function todayStr(){ var d = new Date(); if(d.getHours() < 4) d.setDate(d.getDate()-1); return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate(); }
/* 打卡数据源统一：全站 daily_goal（四院任一「整章练习完成 l / 整卷完成 e」都计当天打卡，跨院连续不断签） */
function acadDaySet(){
  try{
    var g = JSON.parse(localStorage.getItem('daily_goal')||'{}'), out = {};
    Object.keys(g).forEach(function(d){ if(g[d] && Object.keys(g[d]).length) out[d] = 1; });
    var leg = load('checkin', []);
    if(leg && leg.length) leg.forEach(function(x){ out[x] = 1; });
    return out;
  }catch(e){ return {}; }
}
function doCheckin(){ /* 打卡已由 daily_goal 统一记录（整章练习完成 l / 整卷完成 e），保留调用点兼容 */ }
function calcStreak(){
  var set = acadDaySet();
  var streak = 0, d = new Date();
  if(!set[todayStr()]) d.setDate(d.getDate()-1);
  while(set[d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate()]){ streak++; d.setDate(d.getDate()-1); }
  return streak;
}
function checkinBanner(){
  var st = calcStreak();
  var doneToday = !!acadDaySet()[todayStr()];
  var base = 'background:linear-gradient(135deg,#FDF6E3,#FBF7EE);border:1px solid #D9A441;border-radius:14px;padding:16px 20px;box-shadow:0 3px 14px rgba(217,164,65,.22);margin-bottom:16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap';
  if(doneToday){
    return '<div style="'+base+'">' +
      '<span style="font-size:26px">🔥</span>' +
      '<span style="font-size:16px;font-weight:700;color:#8a6d1f">今日打卡 ✓ · 连续 <b style="font-size:22px;color:#B8860B">'+st+'</b> 天</span>' +
      '<span style="font-size:13px;color:#a08a5a">'+(st>=7?'一周以上了，这火苗旺得可以烤肉了。':'明天继续，别让小火苗断咯。')+'</span></div>';
  }
  if(st > 0){
    return '<div style="'+base+'">' +
      '<span style="font-size:26px">⏳</span>' +
      '<span style="font-size:16px;font-weight:700;color:#8a6d1f">已连续 <b style="font-size:22px;color:#B8860B">'+st+'</b> 天 · 今天还没完成</span>' +
      '<span style="font-size:13px;color:#a08a5a">学完一章练习或做完一份卷，点亮今日打卡。</span></div>';
  }
  return '<div style="'+base+'">' +
    '<span style="font-size:26px">🔥</span>' +
    '<span style="font-size:16px;font-weight:700;color:#8a6d1f">今天还没打卡</span>' +
    '<span style="font-size:13px;color:#a08a5a">学完一章练习或做完一份卷，点亮今日打卡。四院共通，跨学院不断签。</span></div>';
}
var studyTimerStart = null;
function studyTimerEnter(){ if(studyTimerStart === null) studyTimerStart = Date.now(); }
function studyTimerLeave(){
  if(studyTimerStart !== null){
    var ms = Date.now() - studyTimerStart;
    if(stat){ stat.totalMs += ms; stat.todayMs += ms; storeStat(); }
    studyTimerStart = null;
  }
}
function todayRecord(ok){
  var d = new Date().toDateString();
  if(todayStat.d !== d){ todayStat = {d:d, done:0, correct:0}; }
  todayStat.done++; if(ok) todayStat.correct++;
  store('tstat', todayStat);
}
function fmtDurCn(sec){
  if(sec < 60) return sec+'秒';
  if(sec < 3600) return Math.round(sec/60)+'分';
  return Math.round(sec/3600)+'时'+(Math.round((sec%3600)/60))+'分';
}
function renderStats(){
  if(!stat) initStat();
  var box = $('#statsGrid'); if(!box) return;
  var t0 = new Date(); t0.setHours(0,0,0,0);
  var totalMs = 0, dayMs = 0, dayCh = {}, dayQ = 0;
  studyLog.forEach(function(s){
    var d = Math.max(0, (s.end||s.start) - s.start);
    totalMs += d;
    if(s.start >= t0.getTime()){
      dayMs += d;
      dayCh[s.ch] = 1;
      // 题数兼容三种记录：新记录(questions) / 聚合旧记录(_n) / 旧记录(quizN)
      dayQ += (s.questions ? s.questions.length : 0) || s._n || (s.quizN||0) || 0;
    }
  });
  var acc = stat.accQ ? Math.round(stat.accC/stat.accQ*100) : null;
  var dayAcc = stat.todayReal ? Math.round(stat.todayCorrect/stat.todayReal*100) : null;
  var cells = [
    ['累计时长', fmtDurCn(stat.totalMs/1000)],
    ['累计题数', stat.totalQ],
    ['正确率', acc===null ? '—' : acc+'%'],
    ['今日章节', Object.keys(dayCh).length],
    ['今日题数', stat.todayQ],
    ['今日时长', fmtDurCn(stat.todayMs/1000)],
    ['今日正确率', dayAcc===null ? '—' : dayAcc+'%']
  ];
  box.innerHTML = cells.map(function(c){
    return '<div class="stat"><div class="sv">'+c[1]+'</div><div class="sl">'+c[0]+'</div></div>';
  }).join('');
}
function wrongItems(keys){
  if(!keys.length) return '<p style="color:var(--ink2);font-size:13.5px">这里还空着。做错的题会自动进来。</p>';
  return keys.map(function(key){
    var p = key.split('_'), c = CHAPTERS[+p[0]-1], q = c.quiz[+p[1]];
    if(!c || !q) return '';
    var h = '<div class="quiz" data-wk="'+key+'"><div class="q"><span class="qn">第'+c.id+'章 Q'+(+p[1]+1)+'</span>'+parseMath(q.q)+'</div>';
    if(q.type === 'choice'){
      h += '<div class="opts">'+q.options.map(function(o, oi){ return '<div class="opt" data-o="'+oi+'">'+String.fromCharCode(65+oi)+'. '+parseMath(o)+'</div>'; }).join('')+'</div>';
    } else {
      h += '<div class="fillrow"><input placeholder="输入答案"><button>批改</button></div>';
    }
    h += '<div class="verdict"></div></div>';
    return h;
  }).join('');
}
function bindWrongEvents(scope){
  scope.querySelectorAll('.quiz[data-wk]').forEach(function(qz){
    var key = qz.dataset.wk, p = key.split('_');
    var c = CHAPTERS[+p[0]-1], q = c.quiz[+p[1]];
    if(!q) return;
    if(q.type === 'choice'){
      qz.querySelectorAll('.opt').forEach(function(opt){
        opt.addEventListener('click', function(){
          if(qz.dataset.lock) return;
          var oi = +opt.dataset.o, ok = (oi === q.answer);
          qz.dataset.lock = '1';
          opt.classList.add(ok?'ok':'bad');
          if(!ok) qz.querySelectorAll('.opt')[q.answer].classList.add('ok');
          qz.querySelectorAll('.opt').forEach(function(o){o.classList.add('lock')});
          var inWrong = wrongPool.indexOf(key) > -1;
          var v = qz.querySelector('.verdict');
          v.className = 'verdict show ' + (ok?'right':'wrong');
          v.innerHTML = '<div class="cm">'+(ok ? ('✓ 做对了！' + (inWrong ? ' 已订正，归档到已订正板块。' : ' 保持住！')) : pick(WRONG_CM))+'</div><div class="ex">'+parseMath(q.explain)+'</div>';
          todayRecord(ok);
          var moved = poolMove(key, ok);
          if(moved) setTimeout(function(){ var on = document.querySelector('.nav button.on'); var pg = on ? on.dataset.page : ''; if(pg==='fixed') renderFixed(); else renderWrong(); }, 1300);
          renderWrongNav(); renderAll();
        });
      });
    } else {
      var btn = qz.querySelector('button'), inp = qz.querySelector('input');
      btn.addEventListener('click', function(){
        if(qz.dataset.lock) return;
        var val = inp.value.trim(); if(!val) return;
        qz.dataset.lock = '1';
        var ok = q.accept.some(function(a){ return numEq(a, val); });
        storePick(key, val);
        var inWrong = wrongPool.indexOf(key) > -1;
        var v = qz.querySelector('.verdict');
        v.className = 'verdict show ' + (ok?'right':'wrong');
        v.innerHTML = '<div class="cm">'+(ok ? ('✓ 做对了！' + (inWrong ? ' 已订正，归档到已订正板块。' : ' 保持住！')) : pick(WRONG_CM))+'</div><div class="ex">'+parseMath(q.explain)+'</div>';
        todayRecord(ok);
        var moved = poolMove(key, ok);
        if(moved) setTimeout(function(){ var on = document.querySelector('.nav button.on'); var pg = on ? on.dataset.page : ''; if(pg==='fixed') renderFixed(); else renderWrong(); }, 1300);
        renderWrongNav(); renderAll();
      });
    }
  });
}
function renderWrong(){
  renderWrongNav();
  var el = $('#wrongList');
  if(!wrongPool.length){
    el.innerHTML = fixedPool.length
      ? '<div class="trap" style="background:#eaf3ec;border-color:var(--green);font-weight:bold;color:var(--green);font-size:15px">✅ 错题已清空！全部订正完毕（已订正 '+fixedPool.length+' 题）。保持住，去小卷或大厅巩固。</div>'
      : '<div class="card"><p style="color:var(--ink2)">还没有错题。去练习大厅、章节课堂或小卷练习做题，做错的会自动进错题集。</p></div>';
    return;
  }
  var html = '<div class="card" style="border-color:#d8a48f"><h3>📕 错题集 · 待订正（'+wrongPool.length+' 题）</h3><p class="hint">做对即归档到「已订正」板块；做错继续留在这里磨。</p><div class="quizwrap">'+wrongItems(wrongPool)+'</div></div>';
  el.innerHTML = html;
  bindWrongEvents(el);
}
function renderFixed(){
  renderWrongNav();
  var el = $('#fixedList');
  if(!fixedPool.length){ el.innerHTML = '<div class="card"><p style="color:var(--ink2)">还没有已订正的题。错题在「错题集」里做对后，会自动归档到这里。</p></div>'; return; }
  var html = '<div class="card" style="border-color:#a8c9a8"><h3>✅ 已订正（'+fixedPool.length+' 题）</h3><p class="hint">曾经做错、如今订正过。重做巩固；做错会被打回错题集。</p><div class="quizwrap">'+wrongItems(fixedPool)+'</div></div>';
  el.innerHTML = html;
  bindWrongEvents(el);
}
/* 荣誉墙 */
function renderHonor(){
  var el = $('#honorBox');
  var s = calcStats();
  var pct = s.pct;
  var curIdx = 0;
  for(var i=0;i<RANKS.length;i++){ if(pct >= RANKS[i][0]) curIdx = i; }
  var stairs = RANKS.map(function(r, i){
    var cls = i < curIdx ? 'done' : (i === curIdx ? 'cur' : '');
    var mark = i < curIdx ? '✓' : (i === curIdx ? '👑' : '');
    return '<div class="rank-step '+cls+'"><div class="rv">'+mark+' '+r[0]+'%</div><div class="rn">'+r[1]+'</div></div>';
  }).join('');
  var icons = ['📜','🔺','🌀','⚔️','🖋️','🧮','∑','🎓','📝','🏅','🧹','🚀','📆','👑'];
  var bd = badgeState(s);
  var bcards = bd.map(function(b, i){
    return '<div class="hw-card'+(b.got?' got':'')+'"><div class="hc"><div class="hic">'+(icons[i]||'⭐')+'</div><div class="hn">'+b.n+'</div></div><div class="hd">'+b.d+'</div><div class="hst">'+(b.got?'✦ 已解锁':'未解锁')+'</div></div>';
  }).join('');
  var palette = [['#537D96','#3F6179'],['#8a6d1f','#5c4714'],['#9D5F4D','#6e3f31'],['#3a6b47','#264a30'],['#6b5b8e','#463a5e'],['#a8733a','#6e4a1f']];
  var hall = CHAPTERS.filter(function(c){ return c.story && c.story.tutor; }).map(function(c, i){
    var p = palette[i % palette.length];
    var nm = c.story.tutor.replace(/（.*/,'').trim();
    var first = nm.charAt(0);
    var quote = (c.story.quote || '').replace(/^「/,'').replace(/」.*$/,'').trim();
    var lit = chIsDone(c);
    var portrait = (c.story.img && PORTRAITS[c.story.img])
      ? '<img src="'+PORTRAITS[c.story.img]+'" alt="'+esc(nm)+'" class="mh-img">'
      : '<div class="mh-avatar" style="background:linear-gradient(135deg,'+p[0]+','+p[1]+')">'+first+'</div>';
    return '<div class="mh-card'+(lit?' lit':'')+'" data-c="'+c.id+'"'+(lit?' title="点击查看 '+esc(nm)+' 的资料卡"':' title="学完本章点亮并解锁资料卡"')+'>'+portrait+'<div class="mh-info"><div class="mh-name">'+esc(nm)+(lit?' <span class="mh-lit">✦ 已学</span>':'')+'</div><div class="mh-era">'+esc(c.story.era||'')+' · 第 '+c.id+' 章</div><div class="mh-quote">'+esc(quote)+'</div>'+(lit?'<div class="mh-open">点击查看资料卡 →</div>':'<div class="mh-lock">🔒 学完本章解锁</div>')+'</div></div>';
  }).join('');
  el.innerHTML =
    '<div class="card"><h3>👑 称号阶梯</h3><p class="hint">当前称号：<b style="color:#8a6d1f">'+RANKS[curIdx][1]+'</b> · 总进度 '+pct+'%'+(curIdx<RANKS.length-1 ? ' · 距「'+RANKS[curIdx+1][1]+'」还差 '+(RANKS[curIdx+1][0]-pct)+'%' : ' · 已达最高荣誉')+'</p><div class="rank-stairs">'+stairs+'</div></div>'+
    '<div class="card"><h3>🏅 徽章墙</h3><div class="badge-grid">'+bcards+'</div></div>'+
    '<div class="card"><h3>📜 芯片人物名人堂</h3><p class="hint">学完本章点亮对应芯片人物，点亮后可点击查看资料卡。学完的越多，名人堂越亮。</p><div class="hall-grid">'+hall+'</div></div>';
  el.querySelectorAll('.mh-card.lit').forEach(function(card){
    card.addEventListener('click', function(){ showMathematician(CHAPTERS[+card.dataset.c-1]); });
  });
}
/* 名人资料卡 */
function showMathematician(c){
  if(!c || !c.story) return;
  var nm = c.story.tutor.replace(/（.*/,'').trim();
  var first = nm.charAt(0);
  var palette = [['#537D96','#3F6179'],['#8a6d1f','#5c4714'],['#9D5F4D','#6e3f31'],['#3a6b47','#264a30'],['#6b5b8e','#463a5e'],['#a8733a','#6e4a1f']];
  var p = palette[(c.id-1) % palette.length];
  var portrait = (c.story.img && PORTRAITS[c.story.img])
    ? '<img src="'+PORTRAITS[c.story.img]+'" style="width:110px;height:130px;border-radius:14px;object-fit:cover;border:2px solid #d4a92a;box-shadow:0 8px 24px rgba(0,0,0,.35)">'
    : '<div style="width:110px;height:110px;border-radius:50%;background:linear-gradient(135deg,'+p[0]+','+p[1]+');display:flex;align-items:center;justify-content:center;font-size:50px;color:#fff;font-family:Georgia,serif;box-shadow:0 8px 24px rgba(0,0,0,.35)">'+first+'</div>';
  var wrap = document.createElement('div');
  wrap.style.cssText = 'position:fixed;inset:0;background:rgba(30,26,20,.72);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(3px)';
  wrap.addEventListener('click', function(e){ if(e.target === wrap) wrap.remove(); });
  var box = document.createElement('div');
  box.style.cssText = 'background:linear-gradient(160deg,#fbf6ea,#f3e7c9);border-radius:22px;padding:30px 34px;max-width:660px;width:100%;border:2px solid #d4a92a;box-shadow:0 24px 80px rgba(0,0,0,.45);max-height:90vh;overflow:auto';
  box.innerHTML =
    '<div style="text-align:center;margin-bottom:16px">'+portrait+'</div>'+
    '<div style="text-align:center"><div style="font-size:25px;font-weight:600;letter-spacing:2px;color:#2d2a26">'+esc(nm)+'</div>'+
    '<div style="font-size:13px;color:var(--muted);margin-top:5px">'+esc(c.story.era||'')+' · 第 '+c.id+' 章「'+esc(c.title)+'」</div></div>'+
    '<div style="background:#fffdf6;border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-top:16px;font-size:14px;line-height:1.85;color:var(--ink2);border-left:3px solid #b8860b">'+parseMath(c.story.fact||'')+'</div>'+
    (c.story.quote ? '<div style="font-style:italic;color:#8a6d1f;text-align:center;margin:16px 0 4px;font-size:15px">'+esc(c.story.quote)+'</div>' : '')+
    (c.story.story ? '<div style="background:rgba(157,95,77,.07);border:1px solid rgba(157,95,77,.2);border-radius:12px;padding:13px 16px;margin-top:12px;font-size:13.5px;color:var(--ink2);line-height:1.75"><b style="color:var(--ochre)">📖 轶事</b>　'+parseMath(c.story.story)+'</div>' : '')+
    '<div style="text-align:center;margin-top:20px"><button class="mh-close" style="border:none;background:linear-gradient(135deg,#b8860b,#d4a92a);color:#fff;border-radius:980px;padding:10px 34px;font-family:inherit;font-size:15px;cursor:pointer;letter-spacing:1px;box-shadow:0 4px 14px rgba(184,134,11,.35)">收下这张名片</button></div>';
  box.querySelector('.mh-close').addEventListener('click', function(){ wrap.remove(); });
  wrap.appendChild(box);
  document.body.appendChild(wrap);
}
/* 主页仪表盘 */
function renderHome(){
  var el = $('#homeBox');
  var now = new Date(), hh = now.getHours();
  var greet = hh<6 ? '夜深了，米勒还在备课' : hh<12 ? '早上好，学徒' : hh<18 ? '下午好，学徒' : '晚上好，学徒';
  var banner = checkinBanner();
  var s = calcStats();
  var pct = s.pct;
  var rank = curRank(pct);
  var doneL = s.doneL, totalL = s.totalL, doneC = s.doneC, totalC = s.totalC;
  var examTotal = s.examTotal, examFull = s.examFull;
  var cards = [
    {ic:'📜', t:'学习计划', v:doneL+'/'+totalL, d:'课程进度', go:'plan'},
    {ic:'🎓', t:'章节课堂', v:doneC+'/'+totalC, d:'章节已学', go:'lesson'},
    {ic:'📝', t:'小卷练习', v:'满分 '+examFull+'/'+examTotal, d:'卷子通关', go:'exam'},
    {ic:'📕', t:'错题集', v:s.wrongPool ? s.wrongPool+' 题' : '✅ 已清空', d:'待订正 · 已订正 '+s.fixedPool, go:'wrong'}
  ];
  var next;
  if(s.wrongPool){
    next = {tx:'错题集里有 '+s.wrongPool+' 题待订正。趁热打铁，订正一题少一题。', go:'wrong', btn:'去订正'};
  } else if(doneC < totalC){
    var nc = CHAPTERS[doneC];
    next = {tx:'下一站：第 '+(doneC+1)+' 章「'+(nc ? nc.title : '')+'」。打开讲义，做题结算。', go:'lesson', btn:'去上课'};
  } else if(examFull < examTotal){
    next = {tx:'讲义全通！还有小卷等着你——每章 15 题，全对拿满分。', go:'exam', btn:'去刷卷'};
  } else {
    next = {tx:'全册通关、错题清零、卷子满分——你已可以来找米勒领毕业答辩。', go:'about', btn:'毕业答辩'};
  }
  var bd = badgeState(s);
  var wall = bd.map(function(b){
    return '<span class="hw-badge'+(b.got?' got':'')+'" title="'+b.d+'">'+(b.got?'✦ ':'')+b.n+'</span>';
  }).join('');
  var traceRows = studyLog.slice(-3).reverse().map(function(x){
    return '<div class="row"><span class="tm">'+fmtDT(x.start)+'</span><span>第 '+x.ch+' 章 · '+esc(x.title)+'</span></div>';
  }).join('');
  el.innerHTML =
    '<div class="home-hero">'+
      '<div class="greet">'+greet+'</div>'+
      '<h2>🐭 鼠哥的芯片战争读书学院 🧠</h2>'+
      '<div class="sub">已修 '+doneL+'/'+totalL+' 课 · 已攻下 '+doneC+'/'+totalC+' 章</div>'+
      '<div class="rank-line"><span class="rk">'+rank.name+'</span><span class="pct-big">总进度 '+pct+'%</span></div>'+
      '<div class="rank-line" style="margin-top:6px;font-size:12.5px;color:#cbbd9c">'+(rank.next ? '距「'+rank.next+'」还差 '+rank.remain+'%' : '已达最高荣誉')+'</div>'+
      '<div class="home-bar"><i style="width:'+pct+'%"></i></div>'+
    '</div>'+
    banner +
    '<div class="home-cards">'+cards.map(function(c){
      return '<div class="home-card" data-go="'+c.go+'"><div class="ic">'+c.ic+'</div><div class="t">'+c.t+'</div><div class="v">'+c.v+'</div><div class="d">'+c.d+'</div></div>';
    }).join('')+'</div>'+
    '<div class="home-next"><div class="lbl">NEXT STEP</div><div class="tx">'+next.tx+'</div><button data-go="'+next.go+'">'+next.btn+'</button></div>'+
    '<div class="card"><h3>🏆 荣誉墙</h3><div class="hw-wall">'+wall+'</div></div>'+
    '<div class="card"><h3>最近足迹</h3>'+(traceRows || '<p style="color:var(--muted);font-size:13px">还没开始学习。去章节课堂开第一课。</p>')+'</div>';
  el.querySelectorAll('[data-go]').forEach(function(b){
    b.addEventListener('click', function(){ goPage(b.dataset.go); });
  });
}

/* ================= 渲染：小卷练习 ================= */
var examCh = 1;
function renderExamNav(){
  var nav = $('#examNav');
  nav.innerHTML = CHAPTERS.map(function(c){
    if(!c.exam) return '';
    var st = examStatus(c);
    var label = st.full ? '🏆 满分' : (st.answered ? '进行中 '+st.answered+'/15' : '未做');
    var col = st.full ? 'var(--green)' : (st.answered ? 'var(--gold)' : 'var(--ink2)');
    var fw = st.full ? 'bold' : 'normal';
    return '<button class="opt" style="border:1.5px solid '+(st.full?'var(--green)':'var(--line)')+';background:'+(examCh===c.id?'rgba(184,134,11,.15)':'transparent')+';color:'+col+';font-weight:'+fw+'" data-c="'+c.id+'">第'+c.id+'章 · '+label+'</button>';
  }).join('');
  nav.querySelectorAll('button').forEach(function(b){
    b.addEventListener('click', function(){ examCh = +b.dataset.c; renderExam(); });
  });
}
function examStatus(c){
  if(!c.exam) return {answered:0, correct:0, full:false};
  var answered = 0, correct = 0;
  c.exam.forEach(function(q, i){
    var st = quizStat['e'+c.id+'_'+i];
    if(st !== undefined){ answered++; if(st === 1) correct++; }
  });
  return {answered: answered, correct: correct, full: answered >= c.exam.length && correct >= c.exam.length};
}
function renderExam(){
  renderExamNav();
  var c = CHAPTERS[examCh-1];
  var el = $('#examList');
  if(!c || !c.exam){
    el.innerHTML = '<div class="card"><p style="color:var(--ink2)">本章小卷制作中。前 7 章的小卷已就位，先刷起来；后续章节卷子陆续补齐。</p></div>';
    return;
  }
  var st = examStatus(c);
  var head = '';
  if(st.full){
    head = '<div class="trap" style="background:#eaf3ec;border-color:var(--green);font-weight:bold;color:var(--green);font-size:15px">🏆 本章小卷满分！15/15 全部正确，卷子已通关。</div>';
  } else if(st.answered){
    head = '<div class="trap" style="background:#f7f2e3;border-color:var(--gold)">📝 已答 '+st.answered+'/15 · 对 '+st.correct+' · 还差 '+(15-st.answered)+' 题。全对即满分通关。答错题已进错题集，可先去订正再回来。</div>';
  } else {
    head = '<div class="trap" style="background:#f2ead4;border-color:var(--line)">📝 15 题小卷 · 做完且全对即通关。错题自动进错题集。</div>';
  }
  var html = '<div class="card"><h3>第'+c.id+'章 小卷 · '+c.title+'</h3>'+head+
    (st.answered ? '<div style="text-align:right;margin-bottom:8px"><button id="examReset" style="border:1px solid var(--line);background:transparent;color:var(--ink2);border-radius:8px;padding:6px 14px;font-family:inherit;font-size:13px;cursor:pointer">🔄 重置本卷（重新做）</button></div>' : '') +
    '<div class="quizwrap">'+
    c.exam.map(function(q, i){
      var key = 'e'+c.id+'_'+i;
      var qh = '<div class="quiz" data-ek="'+key+'"><div class="q"><span class="qn">'+(i+1)+'.</span>'+parseMath(q.q)+'</div>';
      qh += '<div class="opts">'+q.options.map(function(o, oi){ return '<div class="opt" data-o="'+oi+'">'+String.fromCharCode(65+oi)+'. '+parseMath(o)+'</div>'; }).join('')+'</div>';
      qh += '<div class="verdict"></div></div>';
      return qh;
    }).join('')+'</div></div>';
  el.innerHTML = html;
  bindExam(el);
  var rs = document.getElementById('examReset');
  if(rs) rs.addEventListener('click', function(){
    c.exam.forEach(function(q, i){ delete quizStat['e'+c.id+'_'+i]; });
    store('quizStat', quizStat);
    renderExam(); renderExamNav(); renderAll();
  });
}
function bindExam(scope){
  scope.querySelectorAll('.quiz[data-ek]').forEach(function(qz){
    var key = qz.dataset.ek;
    var p = key.split('_'), cid = +p[0].slice(1), idx = +p[1];
    var q = CHAPTERS[cid-1].exam[idx];
    if(!q) return;
    var prev = quizStat[key];
    if(prev !== undefined){
      qz.dataset.lock = '1';
      var pkC = quizPick[key];
      qz.querySelectorAll('.opt').forEach(function(o){ o.classList.add('lock'); if(+o.dataset.o === q.answer) o.classList.add('ok'); if(prev === 0 && pkC !== undefined && +o.dataset.o === pkC) o.classList.add('bad'); });
      var v = qz.querySelector('.verdict');
      v.className = 'verdict show ' + (prev === 1 ? 'right' : 'wrong');
      v.innerHTML = '<div class="cm">'+(prev === 1 ? '✓ 已答对' : '✗ 上次答错（此卷可重置后重做）')+'</div><div class="ex">'+parseMath(q.explain)+'</div>';
    }
    qz.querySelectorAll('.opt').forEach(function(opt){
      opt.addEventListener('click', function(){
        if(qz.dataset.lock) return;
        var oi = +opt.dataset.o, ok = (oi === q.answer);
        qz.dataset.lock = '1';
        opt.classList.add(ok?'ok':'bad');
        if(!ok) qz.querySelectorAll('.opt')[q.answer].classList.add('ok');
        qz.querySelectorAll('.opt').forEach(function(o){o.classList.add('lock')});
        quizStat[key] = ok ? 1 : 0; store('quizStat', quizStat);
        storePick(key, oi);
        sessionLog('exam', CHAPTERS[cid-1], key, ok);
        poolMove(key, ok);
        todayRecord(ok);
        var _ekN = CHAPTERS[cid-1].exam ? CHAPTERS[cid-1].exam.length : 0;
        var _ekDone = Object.keys(quizStat).filter(function(k){ return k.indexOf('e'+cid+'_') === 0; }).length;
        if(_ekN > 0 && _ekDone >= _ekN) dailyGoal('e');
        statRecordQ(ok);
        renderAll(); renderStats(); sbNotify();
        var v = qz.querySelector('.verdict');
        v.className = 'verdict show ' + (ok?'right':'wrong');
        v.innerHTML = '<div class="cm">'+(ok ? pick(RIGHT_CM) : pick(WRONG_CM))+'</div><div class="ex">'+parseMath(q.explain)+'</div>';
        renderExamNav(); renderWrongNav(); renderAll();
      });
    });
  });
}

/* ================= 渲染：进度 ================= */
function renderAll(){
  autoSyncLessons();
  var s = calcStats();
  var pct = s.pct;
  $('#bar i').style.width = pct + '%';
  $('#pctTxt').textContent = pct + '%';
  $('#chCnt').textContent = s.doneC + '/' + s.totalC;
  $('#traceCnt').textContent = s.todayCount ? '今日 '+s.todayCount : '';
  renderWrongNav();
  $('#examCnt').textContent = s.examTotal ? ('满分 '+s.examFull+'/'+s.examTotal) : '';
  // 徽章：侧栏小圆点 + 计数
  // 徽章：侧栏只显示计数（圆点已去掉，详情进荣誉墙）
  var bd = badgeState(s);
  var gotN = bd.filter(function(b){ return b.got; }).length;
  $('#badgeCnt').textContent = gotN + '/' + BADGES.length;
  $('#badges').innerHTML = '';
  // 称号 + 升级进度
  var rank = curRank(pct);
  var rk = $('#rankName'); if(rk) rk.textContent = rank.name;
  var rn = $('#rankNext'); if(rn) rn.textContent = rank.next ? ('距「'+rank.next+'」还差 '+rank.remain+'%') : '已达最高荣誉';
  // 称号升级进度条（当前档内）
  var curLow = RANKS[0][0];
  for(var ri=0; ri<RANKS.length; ri++){ if(pct >= RANKS[ri][0]) curLow = RANKS[ri][0]; }
  var rb = $('#rankBar');
  if(rb){
    if(rank.nextAt !== null){
      var span = rank.nextAt - curLow;
      rb.style.width = Math.round(Math.max(0, Math.min(1, (pct-curLow)/span))*100) + '%';
    } else { rb.style.width = '100%'; }
  }
  // 学习进度四条细分
  var sub = [
    {t:'课程', v:s.doneL, n:s.totalL, tip:'已学课数 / 总课数'},
    {t:'章节', v:s.doneC, n:s.totalC, tip:'已学章数（本章全部练习做完）'},
    {t:'小卷', v:s.examFull, n:s.examTotal, tip:'满分卷数（全对才计入）'},
    {t:'错题订正', v:s.fixedPool, n:s.wrongN, tip:'已订正 / 总错题'}
  ];
  $('#progSub').innerHTML = sub.map(function(x){
    var p, txt;
    if(x.t==='错题订正' && !x.n){ p = 0; txt = '无错题'; }
    else { p = Math.round(x.v/x.n*100); txt = x.v+'/'+x.n; }
    return '<div class="subrow" title="'+x.tip+'"><span class="st">'+x.t+'</span><div class="sbar"><i style="width:'+p+'%"></i></div><span class="sv">'+txt+'</span></div>';
  }).join('');
  renderStats();
  sbNotify();
}

/* ================= 导航（历史栈） ================= */
var navStack = [];
function goPage(name, silent){
  studyTimerLeave();
  if(name === 'lesson' || name === 'hall' || name === 'exam') studyTimerEnter();
  var cur = document.querySelector('.nav button.on');
  var curName = cur ? cur.dataset.page : 'home';
  if(!silent && curName !== name && navStack[navStack.length-1] !== curName){ navStack.push(curName); }
  if(name === 'lesson' && curCh){ closeCh(); }
  document.querySelectorAll('.nav button').forEach(function(x){ x.classList.remove('on'); });
  var btn = document.querySelector('.nav button[data-page="'+name+'"]');
  if(btn) btn.classList.add('on');
  document.querySelectorAll('.page').forEach(function(p){ p.classList.remove('on'); });
  var pg = $('#page-'+name); if(pg) pg.classList.add('on');
  setFabVisible(name !== 'home');
  if(name === 'ask') renderAsk();
  if(name === 'lab') renderLab();
  if(name === 'hall') renderHall();
  if(name === 'trace') renderTrace();
  if(name === 'wrong') renderWrong();
  if(name === 'fixed') renderFixed();
  if(name === 'exam') renderExam();
  if(name === 'home') renderHome();
  if(name === 'honor') renderHonor();
  if(name === 'lesson') renderChSelect();
}
document.querySelectorAll('.nav button').forEach(function(b){
  b.addEventListener('click', function(){ goPage(b.dataset.page); });
});
/* 导航分组折叠 + 侧栏折叠 */
document.querySelectorAll('.nav-sep').forEach(function(sep){
  sep.addEventListener('click', function(){
    var gp = sep.closest('.nav-group');
    gp.classList.toggle('collapsed');
    var folds = load('navfold', {});
    folds[sep.dataset.gp] = gp.classList.contains('collapsed') ? 1 : 0;
    store('navfold', folds);
  });
});
var sideToggle = document.getElementById('sideToggle');
if(sideToggle){
  var sideEl = document.getElementById('side');
  var sideBusy = false, sideT1 = null, sideT2 = null;
  function sideFabSync(){
    var fab = document.getElementById('sideFab');
    var ef = document.getElementById('exitFab');
    var isMobile = window.innerWidth <= 860;
    var show = isMobile && sideEl.classList.contains('collapsed');
    if(fab) fab.style.display = show ? 'flex' : 'none';
    if(ef) ef.style.display = show ? 'flex' : 'none';
  }
  window.addEventListener('resize', sideFabSync);
  function sideClearTimers(){
    if(sideT1) clearTimeout(sideT1);
    if(sideT2) clearTimeout(sideT2);
    sideT1 = sideT2 = null;
  }
  sideToggle.addEventListener('click', function(){
    if(sideBusy) return;
    sideBusy = true;
    sideClearTimers();
    var collapsing = !sideEl.classList.contains('collapsed');
    if(collapsing){
      /* 先淡出文字，再收窄栏宽 */
      sideEl.classList.add('fading-out');
      sideT1 = setTimeout(function(){
        sideEl.classList.add('collapsed');
        sideEl.classList.remove('fading-out');
        sideToggle.textContent = '»';
        store('sidefold', 1);
        sideBusy = false;
        sideFabSync();
      }, 150);
    } else {
      /* 先撑开栏宽，再淡入文字（文字以最终排版状态出现） */
      sideEl.classList.add('hidden');
      sideEl.classList.remove('collapsed');
      void sideEl.offsetWidth; /* 强制重绘，确保隐藏先生效 */
      sideToggle.textContent = '«';
      store('sidefold', 0);
      sideT1 = setTimeout(function(){
        sideEl.classList.remove('hidden');
        void sideEl.offsetWidth; /* 强制重绘，确保 opacity:0 已作为过渡起点被记录 */
        sideEl.classList.add('fading');
        sideT2 = setTimeout(function(){
          sideEl.classList.remove('fading');
          sideBusy = false;
          sideFabSync();
        }, 340);
      }, 360);
    }
  });
}
function toggleSide(){ var t = document.getElementById('sideToggle'); if(t) t.click(); }
/* ===== 关于作者（四院统一弹窗）===== */
var __authorWrap = null;
function openAuthor(){
  if(__authorWrap){ __authorWrap.remove(); __authorWrap=null; }
  var wrap=document.createElement('div');
  wrap.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:99999;display:flex;align-items:center;justify-content:center;padding:18px';
  wrap.onclick=function(e){ if(e.target===wrap) closeAuthor(); };
  var box=document.createElement('div');
  box.style.cssText='background:#FBF7EE;border:1px solid #D8CFBE;border-radius:18px;padding:24px;max-width:540px;width:100%;max-height:86vh;overflow:auto;box-shadow:0 14px 50px rgba(0,0,0,.28);font-family:inherit;color:#2A2622;line-height:1.7';
  box.innerHTML='<div style="display:flex;gap:14px;align-items:center;margin-bottom:14px">' +
    '<div style="width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#537D96,#3F6179);display:flex;align-items:center;justify-content:center;font-size:30px;flex-shrink:0">🐭</div>' +
    '<div><div style="font-weight:700;font-size:19px;letter-spacing:.5px">鼠哥 · 学院发起人</div>' +
    '<div style="font-size:12px;color:#6B6158;margin-top:2px">西安交通大学 准大一新生</div></div></div>' +
    '<p style="font-size:13.5px;color:#4A433C;margin:0 0 12px">打乒乓、敲架子鼓（十级）。开学前想做的事：<b>把同学们聚到一个地方，把大学第一年的硬课一起啃下来</b>。</p>' +
    '<div style="font-size:13.5px;color:#4A433C;line-height:1.9"><b style="color:#2A2622">为什么会有这一座座学院？</b><br>' +
    '高数光看 PDF 学不动，想要一个「做题马上批改、错题自己长记性」的地方 → 第一座 <b>微积分学院</b>诞生。<br>' +
    '同学说也想学编程 → <b>Python 学院</b>：浏览器里直接写代码、即时判题。<br>' +
    '接着 <b>C 语言学院</b>（50 章，浏览器里真编译真运行）、<b>芯片战争学院</b>（选择题读透《芯片战争》）陆续加入。<br>' +
    '最后四院合一，成了现在的 <b>鼠哥学院</b>：一个链接，四门硬课，一群同学。</div>' +
    '<div style="margin-top:12px;font-size:12.5px;color:#6B6158">每座学院的引擎与内容由拉里·佩奇搭建，方向与组织由鼠哥把关。同学们有任何想法，学院里「💬 给作者留言」随时说。</div>' +
    '<button onclick="closeAuthor()" style="margin-top:18px;width:100%;padding:12px;border:none;border-radius:12px;background:linear-gradient(135deg,#537D96,#3F6179);color:#fff;font-size:14.5px;font-weight:600;cursor:pointer;font-family:inherit;letter-spacing:1px">知道了，去学习</button>';
  wrap.appendChild(box);
  __authorWrap = wrap;
  document.body.appendChild(wrap);
}
function closeAuthor(){ if(__authorWrap){ __authorWrap.remove(); __authorWrap=null; } }
/* ===== 打卡日历（月度视图，四院统一）===== */
var __calWrap = null;
function openCalendar(){
  if(__calWrap){ __calWrap.remove(); __calWrap=null; }
  var wrap=document.createElement('div');
  wrap.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:99998;display:flex;align-items:center;justify-content:center;padding:18px';
  wrap.onclick=function(e){ if(e.target===wrap) closeCalendar(); };
  var box=document.createElement('div');
  box.style.cssText='background:#FBF7EE;border:1px solid #D8CFBE;border-radius:18px;padding:20px 22px;max-width:400px;width:100%;font-family:inherit;color:#2A2622;max-height:88vh;overflow:auto';
  wrap.appendChild(box);
  __calWrap=wrap;
  var now=new Date();
  var st={y:now.getFullYear(), m:now.getMonth()};
  function daySet(){ try{ var g=JSON.parse(localStorage.getItem('daily_goal')||'{}'), o={}; Object.keys(g).forEach(function(k){ if(g[k]&&Object.keys(g[k]).length) o[k]=1; }); return o; }catch(e){ return {}; } }
  function tKey(){ var x=new Date(); if(x.getHours()<4) x.setDate(x.getDate()-1); return x.getFullYear()+'-'+(x.getMonth()+1)+'-'+x.getDate(); }
  function paint(){
    var ds=daySet(), tk=tKey();
    var t0=new Date(st.y,st.m,1), first=t0.getDay(), dim=new Date(st.y,st.m+1,0).getDate();
    var cells='';
    for(var i=0;i<first;i++) cells+='<div></div>';
    var litCount=0;
    for(var d=1;d<=dim;d++){
      var key=st.y+'-'+(st.m+1)+'-'+d;
      var lit=!!ds[key]; if(lit) litCount++;
      var isT = key===tk;
      cells+='<div style="height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:13px;'+(lit?'background:rgba(74,107,74,.88);color:#fff;font-weight:600':'background:#EFE9DC;color:#8a8577')+';'+(isT?'box-shadow:0 0 0 2px #B8860B inset;':'')+'">'+d+'</div>';
    }
    box.innerHTML='<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">'+
      '<button onclick="calNav(-1)" style="border:1px solid #D8CFBE;background:transparent;border-radius:50%;width:32px;height:32px;cursor:pointer;font-size:18px;color:#3F6179">‹</button>'+
      '<div style="font-weight:700;font-size:16px">📅 '+st.y+' 年 '+(st.m+1)+' 月</div>'+
      '<button onclick="calNav(1)" style="border:1px solid #D8CFBE;background:transparent;border-radius:50%;width:32px;height:32px;cursor:pointer;font-size:18px;color:#3F6179">›</button></div>'+
      '<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center;font-size:11px;color:#6B6158;margin-bottom:4px">'+['日','一','二','三','四','五','六'].map(function(w){return '<div style="padding:2px 0">'+w+'</div>';}).join('')+'</div>'+
      '<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px">'+cells+'</div>'+
      '<div style="margin-top:10px;font-size:12px;color:#6B6158;line-height:1.6">本月完成 <b style="color:#4A6B4A">'+litCount+'</b> 天 · 绿色=当天学完一节或做完一份卷（四院共通，凌晨 4 点结算）</div>'+
      '<button onclick="closeCalendar()" style="margin-top:14px;width:100%;padding:11px;border:none;border-radius:12px;background:linear-gradient(135deg,#537D96,#3F6179);color:#fff;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit">知道了</button>';
  }
  window.calNav=function(dm){ st.m+=dm; if(st.m<0){st.m=11;st.y--;} if(st.m>11){st.m=0;st.y++;} paint(); };
  window.closeCalendar=function(){ if(__calWrap){ __calWrap.remove(); __calWrap=null; } };
  paint();
  document.body.appendChild(wrap);
}
(function(){
  /* 手机端默认收起（未手动展开过）；桌面按 sidefold 偏好 */
  var sf = load('sidefold', null);
  var shouldFold = (window.innerWidth <= 860 && sf !== 0) || sf === 1;
  if(shouldFold){
    var side = document.getElementById('side');
    if(side){ side.classList.add('collapsed'); if(sideToggle) sideToggle.textContent = '»'; }
    var fab = document.getElementById('sideFab'); if(fab){ fab.style.display = (window.innerWidth <= 860) ? 'flex' : 'none'; }
    var ef = document.getElementById('exitFab'); if(ef){ ef.style.display = (window.innerWidth <= 860) ? 'flex' : 'none'; }
  }
})();

/* ================= 悬浮导航（返回/主页） ================= */
function setFabVisible(v){
  var el = document.getElementById('fabNav');
  if(el) el.style.display = v ? 'flex' : 'none';
}
(function(){
  function bindFab(){
    var back = document.getElementById('fabBack');
    var home = document.getElementById('fabHome');
    if(back && !back.dataset.bound){ back.dataset.bound='1'; back.addEventListener('click', function(){
      if(curCh){ closeCh(); setFabVisible(true); return; }
      var prev = navStack.pop();
      if(prev){ goPage(prev, true); } else { goPage('home'); }
    }); }
    if(home && !home.dataset.bound){ home.dataset.bound='1'; home.addEventListener('click', function(){
      navStack = [];
      if(curCh) closeCh();
      goPage('home');
    }); }
  }
  bindFab();
  // 保险：DOM 完全加载后再绑一次（元素在脚本之后，确保已存在）
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', bindFab);
  } else {
    setTimeout(bindFab, 0);
  }
})();

/* ================= 导入进度 ================= */
function importProgress(){
  var wrap = document.createElement('div');
  wrap.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
  var box = document.createElement('div');
  box.style.cssText = 'background:#fff;border-radius:18px;padding:22px;max-width:720px;width:100%;max-height:80vh;display:flex;flex-direction:column;gap:12px;box-shadow:0 12px 48px rgba(0,0,0,.2)';
  var title = document.createElement('div');
  title.innerHTML = '<b style="color:var(--blue)">导入学习进度</b><span style="color:var(--ink2);font-size:13px"> —— 粘贴之前导出的进度数据，点「导入」。进度只写入<b>本机浏览器</b>，别人看不到。</span>';
  var ta = document.createElement('textarea');
  ta.placeholder = '粘贴 { "chip_lessons": [...] } 格式的进度数据……';
  ta.style.cssText = 'flex:1;border:1px solid var(--line);border-radius:12px;padding:12px;font-family:Consolas,monospace;font-size:12px;min-height:240px;background:#f5f5f7';
  var bar = document.createElement('div');
  bar.style.cssText = 'display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap';
  var msg = document.createElement('span');
  msg.style.cssText = 'margin-right:auto;color:var(--red);font-size:13px;display:none';
  var btnOk = document.createElement('button');
  btnOk.textContent = '✅ 导入';
  btnOk.style.cssText = 'border:none;background:var(--blue);color:#fff;border-radius:980px;padding:9px 20px;font-family:inherit;font-size:14px;cursor:pointer;font-weight:500';
  var btnClose = document.createElement('button');
  btnClose.textContent = '关闭';
  btnClose.style.cssText = 'border:1px solid var(--line);background:transparent;color:var(--ink2);border-radius:980px;padding:8px 18px;font-family:inherit;font-size:14px;cursor:pointer';
  btnOk.addEventListener('click', function(){
    try{
      var data = JSON.parse(ta.value);
      var n = 0;
      Object.keys(data).forEach(function(k){
        if(k.indexOf('chip_') !== 0) return;
        var v = data[k];
        localStorage.setItem(k, typeof v === 'string' ? v : JSON.stringify(v));
        n++;
      });
      if(n === 0){ msg.style.display='inline'; msg.textContent = '没找到 chip_ 开头的进度数据，请检查内容'; return; }
      alert('导入成功，共 '+n+' 项进度。页面将刷新，进度已就位。');
      location.reload();
    }catch(e){
      msg.style.display='inline'; msg.textContent = '数据格式不对：'+e.message;
    }
  });
  btnClose.addEventListener('click', function(){ wrap.remove(); });
  bar.appendChild(msg);
  bar.appendChild(btnClose);
  bar.appendChild(btnOk);
  box.appendChild(title);
  box.appendChild(ta);
  box.appendChild(bar);
  wrap.appendChild(box);
  document.body.appendChild(wrap);
}
document.getElementById('btnImport').addEventListener('click', importProgress);

/* 云端同步清除：登录状态下把本院云端命名空间一并清掉（防清除后同步回灌） */
function sbClearCloud(){
  try{
    var s = sbSession(); if(!s || !s.user) return;
    sbEnsureToken().then(function(ok){
      if(!ok) return;
      var h = sbAuthHeaders(); if(!h) return;
      fetch(SB_URL + '/rest/v1/progress?select=data&user_id=eq.' + s.user.id, { headers:h })
        .then(function(r){ return r.json(); })
        .then(function(rows){
          var data = (rows && rows.length && rows[0].data) ? rows[0].data : {};
          if(data.chip) delete data.chip;
          return fetch(SB_URL + '/rest/v1/progress?user_id=eq.' + s.user.id, { method:'PATCH', headers:h, body: JSON.stringify({ data: data }) });
        }).catch(function(){});
    });
  }catch(e){}
}
/* ================= 清理旧足迹（只删纯浏览记录，保留做题记录） ================= */
document.getElementById('btnClean').addEventListener('click', function(){
  /* 收集全部 chip_ 数据键 */
  var keys = [];
  for(var i=0;i<localStorage.length;i++){
    var k = localStorage.key(i);
    if(k && k.indexOf('chip_') === 0) keys.push(k);
  }
  if(keys.length === 0){
    alert('当前没有任何学习数据。');
    return;
  }
  /* 需输入「清除记录」确认，防止误触 */
  var wrap = document.createElement('div');
  wrap.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
  var box = document.createElement('div');
  box.style.cssText = 'background:#fff;border-radius:18px;padding:22px;max-width:460px;width:100%;box-shadow:0 12px 48px rgba(0,0,0,.2)';
  var title = document.createElement('div');
  title.innerHTML = '<b style="color:var(--red)">⚠ 清除所有记录</b>';
  var desc = document.createElement('div');
  desc.style.cssText = 'color:var(--ink2);font-size:13.5px;line-height:1.8;margin:10px 0';
  desc.innerHTML = '将<b>永久清除全部学习数据</b>：章节进度、徽章、名人堂、错题集、学习足迹，共 '+keys.length+' 项。学院将回到<b>初始状态</b>，此操作不可撤销。<br>输入 <b style="color:var(--red)">清除记录</b> 确认：';
  var ta = document.createElement('input');
  ta.type = 'text';
  ta.placeholder = '请输入「清除记录」';
  ta.style.cssText = 'width:100%;box-sizing:border-box;border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-family:inherit;font-size:14.5px;background:#f5f5f7;outline:none';
  var msg = document.createElement('span');
  msg.style.cssText = 'color:var(--red);font-size:12.5px;display:none';
  var bar = document.createElement('div');
  bar.style.cssText = 'display:flex;gap:10px;justify-content:flex-end;margin-top:14px';
  var btnCancel = document.createElement('button');
  btnCancel.textContent = '取消';
  btnCancel.style.cssText = 'border:1px solid var(--line);background:transparent;color:var(--ink2);border-radius:980px;padding:9px 18px;font-family:inherit;font-size:14px;cursor:pointer';
  var btnOk = document.createElement('button');
  btnOk.textContent = '确认清除';
  btnOk.style.cssText = 'border:none;background:var(--red);color:#fff;border-radius:980px;padding:9px 20px;font-family:inherit;font-size:14px;cursor:pointer;opacity:.4;pointer-events:none;font-weight:500';
  ta.addEventListener('input', function(){
    var ok = ta.value.trim() === '清除记录';
    btnOk.style.opacity = ok ? '1' : '.4';
    btnOk.style.pointerEvents = ok ? 'auto' : 'none';
    msg.style.display = 'none';
  });
  btnOk.addEventListener('click', function(){
    if(ta.value.trim() !== '清除记录'){ msg.style.display='inline'; msg.textContent='输入的文字不对，请重新输入'; return; }
    keys.forEach(function(k){ localStorage.removeItem(k); });
    sbClearCloud();
    wrap.remove();
    alert('已清除全部学习数据，学院回到初始状态。');
    location.reload();
  });
  btnCancel.addEventListener('click', function(){ wrap.remove(); });
  bar.appendChild(btnCancel);
  bar.appendChild(btnOk);
  box.appendChild(title);
  box.appendChild(desc);
  box.appendChild(ta);
  box.appendChild(msg);
  box.appendChild(bar);
  wrap.appendChild(box);
  document.body.appendChild(wrap);
  ta.focus();
});

/* ================= 导出进度 ================= */
function exportProgress(){
  var out = {};
  for(var i=0;i<localStorage.length;i++){
    var key = localStorage.key(i);
    if(key.indexOf('chip_') === 0){
      try{ out[key] = JSON.parse(localStorage.getItem(key)); }catch(e){ out[key] = localStorage.getItem(key); }
    }
  }
  var json = JSON.stringify(out);
  var wrap = document.createElement('div');
  wrap.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px';
  var box = document.createElement('div');
  box.style.cssText = 'background:#fff;border-radius:18px;padding:22px;max-width:720px;width:100%;max-height:80vh;display:flex;flex-direction:column;gap:12px;box-shadow:0 12px 48px rgba(0,0,0,.2)';
  var title = document.createElement('div');
  title.innerHTML = '<b style="color:var(--blue)">你的学习进度</b><span style="color:var(--ink2);font-size:13px"> —— 点下面「复制」后，整段粘贴发给你的助手即可</span>';
  var ta = document.createElement('textarea');
  ta.value = json;
  ta.readOnly = true;
  ta.style.cssText = 'flex:1;border:1px solid var(--line);border-radius:12px;padding:12px;font-family:Consolas,monospace;font-size:12px;min-height:240px;background:#f5f5f7';
  var bar = document.createElement('div');
  bar.style.cssText = 'display:flex;gap:10px;justify-content:flex-end';
  var btnCopy = document.createElement('button');
  btnCopy.textContent = '📋 复制';
  btnCopy.style.cssText = 'border:none;background:var(--blue);color:#fff;border-radius:980px;padding:9px 20px;font-family:inherit;font-size:14px;cursor:pointer;font-weight:500';
  var btnClose = document.createElement('button');
  btnClose.textContent = '关闭';
  btnClose.style.cssText = 'border:1px solid var(--line);background:transparent;color:var(--ink2);border-radius:980px;padding:8px 18px;font-family:inherit;font-size:14px;cursor:pointer';
  btnCopy.addEventListener('click', function(){
    ta.select();
    try{ document.execCommand('copy'); btnCopy.textContent = '✅ 已复制'; }catch(e){ btnCopy.textContent = '请手动 Ctrl+C'; }
  });
  btnClose.addEventListener('click', function(){ wrap.remove(); });
  bar.appendChild(btnClose);
  bar.appendChild(btnCopy);
  box.appendChild(title);
  box.appendChild(ta);
  box.appendChild(bar);
  wrap.appendChild(box);
  document.body.appendChild(wrap);
  ta.focus(); ta.select();
}
document.getElementById('btnExport').addEventListener('click', exportProgress);

/* ================= 芯片史实验室（内置） ================= */

/* ================= 云同步（Supabase，多设备进度对齐） ================= */
var SB_URL = 'https://yycokuphczoxfntcwizi.supabase.co';
var SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl5Y29rdXBoY3pveGZudGN3aXppIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc0MDM3MzgsImV4cCI6MjEwMjk3OTczOH0.1vm61oyqeBmc2lL_q0-rgJT2x6TsOn_DXsQo1GQJbSM';
function sbSession(){
  var s = load('sb_session', null);
  if(s) return s;
  /* 四院联通：从老学院键迁移登录态（同 origin 下 localStorage 共享） */
  var legacy = null;
  try{ legacy = JSON.parse(localStorage.getItem('acad_sb_session')) || JSON.parse(localStorage.getItem('pjc_sb_session')) || JSON.parse(localStorage.getItem('pyc_sb_session')) || JSON.parse(localStorage.getItem('cc_sb_session')); }catch(e){}
  if(legacy && legacy.access_token){ store('sb_session', legacy); return legacy; }
  return null;
}
function sbAuthHeaders(){
  var s = sbSession();
  return s ? { 'Authorization': 'Bearer ' + s.access_token, 'Content-Type': 'application/json', 'apikey': SB_KEY } : null;
}
async function sbEnsureToken(){
  var s = sbSession();
  if(!s) return false;
  var live = true;
  try{
    var payload = JSON.parse(atob(s.access_token.split('.')[1]));
    live = Date.now() < (payload.exp * 1000) - 60000;
  }catch(e){ live = false; }
  if(live) return true;
  if(!s.refresh_token) return false;
  try{
    var r = await fetch(SB_URL + '/auth/v1/token?grant_type=refresh_token', { method:'POST', headers:{'Content-Type':'application/json', 'apikey': SB_KEY}, body: JSON.stringify({refresh_token: s.refresh_token}) });
    var j = await r.json();
    if(j.access_token){ store('sb_session', {access_token: j.access_token, refresh_token: j.refresh_token || s.refresh_token, user: j.user || s.user}); return true; }
  }catch(e){}
  return false;
}
function sbMsg(t, ok){
  var m = document.getElementById('sbMsg');
  if(m){ m.textContent = t; m.style.color = ok ? '#3a6b47' : '#8B2C1F'; }
}
function sbPack(){
  return {
    lessons: load('lessons', []), ch: load('ch', []), hall: load('hall', {}),
    wrong: load('wrong', []), fixed: load('fixed', []), log: load('log', []),
    quizStat: load('quizStat', {}), tstat: load('tstat', {}), quizPick: load('quizPick', {}), settle: load('settle', {})
  };
}
/* ===== 游客模式 ===== */
function enterGuest(){
  store('guest', 1);
  hideLogin();
  showGuestBar();
  sbRefresh();
}
function hintToggle(inp, id){ var el = document.getElementById(id); if(el) el.style.display = (inp.value.trim()) ? 'none' : 'block'; }
function showGuestBar(){
  var b = document.getElementById('guestBar');
  if(b) b.style.display = 'block';
}
function hideGuestBar(){
  var b = document.getElementById('guestBar');
  if(b) b.style.display = 'none';
}
/* 合并两端进度：数组取并集去重，对象取键并集，不互相覆盖 */
var MERGE_ARR = ['lessons','ch','wrong','fixed','log','hall'];
var MERGE_OBJ = ['quizStat','tstat','quizPick','settle'];
/* 类型清洗：把错误类型的数据重置为正确默认，防止污染传播（本地/云端都可能脏） */
function sanitizeProgress(d){
  var out = {};
  if(!d || typeof d !== 'object') return out;
  MERGE_ARR.forEach(function(k){
    var v = d[k];
    if(Array.isArray(v)){ out[k] = v; return; }
    if(v && typeof v === 'object'){
      // 对象污染（如 {'0':'1_0'}）→ 按数字键序转回数组（合法 key 才转，避免误收脏数据）
      var keys = Object.keys(v).filter(function(x){ return /^\d+$/.test(x); }).sort(function(a,b){ return (+a)-(+b); });
      var arr = keys.map(function(key){ return v[key]; });
      if(arr.length && arr.every(function(x){ return typeof x === 'string' && /^\d+_\d+$/.test(x); })){
        out[k] = arr;
      } else { out[k] = []; }
      return;
    }
    out[k] = [];
  });
  MERGE_OBJ.forEach(function(k){ var v = d[k]; out[k] = (v && typeof v === 'object' && !Array.isArray(v)) ? v : {}; });
  return out;
}
/* 数据体检：localStorage 类型异常时重置，防止渲染函数崩溃 */
(function(){
  ['lessons','ch','wrong','fixed','log'].forEach(function(k){
    var v = load(k, null);
    if(v !== null && !Array.isArray(v)) store(k, []);
  });
  // hall 特殊：对象污染时转回数组（能救不丢）
  var hv = load('hall', null);
  if(hv !== null && !Array.isArray(hv)){
    if(hv && typeof hv === 'object'){
      var hkeys = Object.keys(hv).filter(function(x){ return /^\d+$/.test(x); }).sort(function(a,b){ return (+a)-(+b); });
      var harr = hkeys.map(function(x){ return hv[x]; });
      if(harr.length && harr.every(function(x){ return typeof x === 'string' && /^\d+_\d+$/.test(x); })){
        store('hall', harr);
      } else { store('hall', []); }
    } else { store('hall', []); }
  }
  ['quizStat','tstat','quizPick','settle'].forEach(function(k){
    var v = load(k, null);
    if(v !== null && (typeof v !== 'object' || Array.isArray(v))) store(k, {});
  });
})();
function loadAllProgress(){
  var out = {};
  MERGE_ARR.concat(MERGE_OBJ).forEach(function(k){ out[k] = load(k, MERGE_OBJ.indexOf(k) >= 0 ? {} : []); });
  return out;
}
function storeAllProgress(d){
  MERGE_ARR.concat(MERGE_OBJ).forEach(function(k){ if(d[k] !== undefined) store(k, d[k]); });
  /* 同步内存变量：界面/统计用的是内存，不刷新会导致显示旧数据 */
  if(d.lessons !== undefined) lessonsDone = d.lessons;
  if(d.ch !== undefined) chDone = d.ch;
  if(d.hall !== undefined) hallDone = d.hall;
  if(d.quizStat !== undefined) quizStat = d.quizStat;
  if(d.wrong !== undefined) wrongPool = d.wrong;
  if(d.fixed !== undefined) fixedPool = d.fixed;
  if(d.log !== undefined) studyLog = d.log;
  if(d.tstat !== undefined) tstat = d.tstat;
  if(d.quizPick !== undefined) quizPick = d.quizPick;
  if(d.settle !== undefined) settle = d.settle;
}
function mergeProgress(local, cloud){
  local = sanitizeProgress(local);
  cloud = sanitizeProgress(cloud);
  var out = {};
  MERGE_ARR.forEach(function(k){
    var a = local[k] || [], b = cloud[k] || [];
    var seen = {}, arr = [];
    a.concat(b).forEach(function(x){
      var key = (typeof x === 'object' && x !== null) ? JSON.stringify(x) : String(x);
      if(!seen[key]){ seen[key] = 1; arr.push(x); }
    });
    out[k] = arr;
  });
  MERGE_OBJ.forEach(function(k){
    var a = local[k] || {}, b = cloud[k] || {}, m = {};
    Object.keys(a).forEach(function(key){ m[key] = a[key]; });
    Object.keys(b).forEach(function(key){
      // 任一设备做过/做对即保留（1 优先），后写不丢前写
      if(a[key] === 1 || b[key] === 1) m[key] = 1;
      else if(b[key] !== undefined) m[key] = b[key];
      else if(a[key] !== undefined) m[key] = a[key];
    });
    out[k] = m;
  });
  return out;
}
function showLogin(){
  var el = document.getElementById('loginOverlay');
  if(el) el.style.display = 'flex';
}
function hideLogin(){
  var el = document.getElementById('loginOverlay');
  if(el) el.style.display = 'none';
}
function loginDo(){ if(authMode === 'forgot'){ sendRecover(); return; } sbAuth(signupMode); }
function signupDo(){ loginMode(true); }
var AVATARS = ['🦊','🐼','🐸','🐙','🦄','🐯','🐨','🐰','🦁','🐢','🐳','🦉','🐭','🐿️'];
var AV_COLORS = ['#537D96','#5B8C5A','#6D9B7C','#C77B6D','#A67BB8','#D9A441','#8FA3B8','#C75B7A','#B57F5E','#7BA6A0','#A08BD1','#D08159','#9B8579','#C77B3D'];
var signupMode = false, selAvatar = AVATARS[0];
var authMode = 'login';
function loginMode(up){
  authMode = up ? 'signup' : 'login';
  signupMode = up;
  var tl = document.getElementById('tabLogin'), ts = document.getElementById('tabSignup');
  if(tl){ tl.style.display = 'block'; tl.className = 'login-tab' + (up ? '' : ' on'); }
  if(ts){ ts.style.display = 'block'; ts.className = 'login-tab' + (up ? ' on' : ''); }
  var nm = document.getElementById('loginName'), ap = document.getElementById('avatarPick'), ag = document.getElementById('avatarGrid'), mb = document.getElementById('loginBtnMain'), tip = document.getElementById('loginTip'), pw = document.getElementById('loginPass');
  if(nm) nm.style.display = up ? 'block' : 'none';
  if(ap) ap.style.display = up ? 'block' : 'none';
  if(ag) ag.style.display = up ? 'grid' : 'none';
  if(pw) pw.style.display = 'block';
  if(mb) mb.textContent = up ? '注 册' : '登 录';
  if(tip) tip.textContent = up ? '注册后自动登录，进度云端保存，换设备不丢。' : '第一次用点「注册」，之后自动登录。同一账号，手机电脑进度同步。';
  var fg = document.getElementById('loginForgot'), bk = document.getElementById('loginBack');
  if(fg) fg.style.display = 'block';
  if(bk) bk.style.display = 'none';
  var hi = document.getElementById('loginHint'), wa = document.getElementById('loginWarn');
  if(hi) hi.style.display = 'block';
  if(wa) wa.style.display = 'block';
  var msg = document.getElementById('loginMsg'); if(msg){ msg.textContent = ''; msg.style.color = '#8B2C1F'; }
  if(up) buildAvatarGrid();
}
function showForgot(){
  authMode = 'forgot';
  var tl = document.getElementById('tabLogin'), ts = document.getElementById('tabSignup');
  if(tl) tl.style.display = 'none';
  if(ts) ts.style.display = 'none';
  var nm = document.getElementById('loginName'), ap = document.getElementById('avatarPick'), ag = document.getElementById('avatarGrid'), pw = document.getElementById('loginPass'), mb = document.getElementById('loginBtnMain'), tip = document.getElementById('loginTip');
  if(nm) nm.style.display = 'none';
  if(ap) ap.style.display = 'none';
  if(ag) ag.style.display = 'none';
  if(pw) pw.style.display = 'none';
  if(mb) mb.textContent = '发送重置链接';
  if(tip) tip.textContent = '输入注册时用的邮箱，重置链接会发送到该邮箱（记得看垃圾箱）。';
  var fg = document.getElementById('loginForgot'), bk = document.getElementById('loginBack');
  if(fg) fg.style.display = 'none';
  if(bk) bk.style.display = 'block';
  var hi = document.getElementById('loginHint'), wa = document.getElementById('loginWarn');
  if(hi) hi.style.display = 'none';
  if(wa) wa.style.display = 'none';
  var msg = document.getElementById('loginMsg'); if(msg){ msg.textContent = ''; msg.style.color = '#8B2C1F'; }
}
function backToLogin(){ loginMode(false); }
function userCardClick(){ if(sbSession()){ goPage('trace'); } else { showLogin(); } }
/* ===== 找回密码 ===== */
async function sendRecover(){
  var email = $('#loginEmail').value.trim();
  var msg = document.getElementById('loginMsg');
  if(!email || !/\S+@\S+\.\S+/.test(email)){ msg.textContent = '请输入有效的邮箱'; msg.style.color = '#8B2C1F'; return; }
  msg.textContent = '发送中…'; msg.style.color = '#8B2C1F';
  try{
    var redirect = location.origin + location.pathname;
    var r = await fetch(SB_URL + '/auth/v1/recover', { method:'POST', headers:{'Content-Type':'application/json', 'apikey': SB_KEY}, body: JSON.stringify({ email: email, options: { redirect_to: redirect } }) });
    var j = await r.json();
    if(r.ok){
      msg.textContent = '✅ 重置链接已发送到 ' + email + '，请查收邮件（含垃圾箱）';
      msg.style.color = '#3a6b47';
    } else {
      msg.textContent = j.msg || j.error_description || '发送失败，请确认邮箱已注册';
      msg.style.color = '#8B2C1F';
    }
  }catch(e){ msg.textContent = '网络错误：' + e.message; msg.style.color = '#8B2C1F'; }
}
function checkRecoveryHash(){
  var h = location.hash || '';
  if(h.indexOf('access_token') < 0 || h.indexOf('type=recovery') < 0) return false;
  try{
    var params = {};
    h.replace(/^#/, '').split('&').forEach(function(kv){ var p = kv.split('='); if(p[0]) params[decodeURIComponent(p[0])] = decodeURIComponent(p[1]||''); });
    if(!params.access_token || params.type !== 'recovery') return false;
    fetch(SB_URL + '/auth/v1/user', { headers: { 'Authorization': 'Bearer ' + params.access_token, 'apikey': SB_KEY } })
      .then(function(r){ return r.json(); })
      .then(function(u){
        if(u && u.id){
          store('sb_session', { access_token: params.access_token, refresh_token: params.refresh_token || '', user: u });
          try{ history.replaceState(null, '', location.pathname + location.search); }catch(e){}
          sbRefresh();
          showResetUI();
        }
      }).catch(function(){});
    return true;
  }catch(e){ return false; }
}
function showResetUI(){
  showLogin();
  var ids = ['tabLogin','tabSignup','loginName','loginEmail','loginPass','avatarPick','avatarGrid','loginBtnMain','loginForgot','loginBack','loginMsg','loginTip','loginShare','guestEntry'];
  ids.forEach(function(id){ var el = document.getElementById(id); if(el) el.style.display = 'none'; });
  var rb = document.getElementById('resetBlock'); if(rb) rb.style.display = 'flex';
  rb.style.flexDirection = 'column';
  rb.style.gap = '12px';
  var m = document.getElementById('resetMsg'); if(m) m.textContent = '';
}
async function doReset(){
  var p1 = document.getElementById('resetPass').value, p2 = document.getElementById('resetPass2').value;
  var msg = document.getElementById('resetMsg');
  if(p1.length < 6){ msg.textContent = '密码至少 6 位'; msg.style.color = '#8B2C1F'; return; }
  if(p1 !== p2){ msg.textContent = '两次输入的密码不一致'; msg.style.color = '#8B2C1F'; return; }
  msg.textContent = '更新中…'; msg.style.color = '#8B2C1F';
  try{
    var h = sbAuthHeaders();
    if(!h){ msg.textContent = '重置链接已失效，请重新申请'; msg.style.color = '#8B2C1F'; return; }
    var r = await fetch(SB_URL + '/auth/v1/user', { method:'PUT', headers:h, body: JSON.stringify({ password: p1 }) });
    var j = await r.json();
    if(r.ok && j.id){
      msg.textContent = '✅ 密码已更新！请用新密码登录';
      msg.style.color = '#3a6b47';
      setTimeout(function(){ sbLogout(); }, 1200);
    } else {
      msg.textContent = j.msg || '更新失败，请重试';
      msg.style.color = '#8B2C1F';
    }
  }catch(e){ msg.textContent = '网络错误：' + e.message; msg.style.color = '#8B2C1F'; }
}
function buildAvatarGrid(){
  var g = document.getElementById('avatarGrid');
  if(!g || g.childNodes.length) return;
  g.innerHTML = AVATARS.map(function(a,i){
    return '<div class="avatar-opt' + (i===0 ? ' sel' : '') + '" data-i="' + i + '" onclick="pickAvatar(' + i + ')" style="background:' + AV_COLORS[i] + '26">' + a + '</div>';
  }).join('');
}
function pickAvatar(i){
  selAvatar = AVATARS[i];
  document.querySelectorAll('#avatarGrid .avatar-opt').forEach(function(e,ix){ e.classList.toggle('sel', ix===i); });
}
function avColor(a){
  var i = AVATARS.indexOf(a);
  return i >= 0 ? AV_COLORS[i] : '#537D96';
}
function curProfile(){
  var s = sbSession();
  if(!s || !s.user) return null;
  var p = load('profile', null);
  if(p && p.username && p.user_id === s.user.id) return p;
  var u = (s.user.email && s.user.email.split('@')[0]) || '同学';
  return { username: u, avatar: '🦊', user_id: s.user.id };
}
async function sbEnsureProfile(){
  var s = sbSession();
  if(!s || !s.user) return;
  var h = sbAuthHeaders(); if(!h) return;
  try{
    var r = await fetch(SB_URL + '/rest/v1/profiles?select=username,avatar&user_id=eq.' + s.user.id, { headers:h });
    var rows = await r.json();
    if(rows && rows.length && rows[0].username){
      store('profile', { username: rows[0].username, avatar: rows[0].avatar || '🦊', user_id: s.user.id });
    } else {
      var p = curProfile();
      var body = { user_id: s.user.id, username: p.username, avatar: p.avatar };
      var r2 = await fetch(SB_URL + '/rest/v1/profiles', { method:'POST', headers:h, body: JSON.stringify(body) });
      if(!r2.ok){
        await fetch(SB_URL + '/rest/v1/profiles?user_id=eq.' + s.user.id, { method:'PATCH', headers:h, body: JSON.stringify({ username: p.username, avatar: p.avatar }) });
      }
    }
    sbRefresh();
  }catch(e){}
}
async function sbAuth(doSignup){
  var email = $('#loginEmail').value.trim(), pass = $('#loginPass').value;
  var msg = document.getElementById('loginMsg');
  var uname = '', av = selAvatar;
  if(doSignup){
    uname = $('#loginName').value.trim();
    if(!/^[\u4e00-\u9fa5A-Za-z0-9_]{3,16}$/.test(uname)){ msg.textContent = '用户名需 3~16 位：中文/字母/数字/下划线'; return; }
  }
  if(!email || !/\S+@\S+\.\S+/.test(email)){ msg.textContent = '请输入有效的邮箱'; return; }
  if(pass.length < 6){ msg.textContent = '密码至少 6 位'; return; }
  msg.textContent = doSignup ? '注册中…' : '登录中…';
  try{
    if(doSignup){
      var dup = await fetch(SB_URL + '/rest/v1/profiles?select=username&username=eq.' + encodeURIComponent(uname), { headers: { 'apikey': SB_KEY } });
      var dupRows = await dup.json();
      if(dupRows && dupRows.length){ msg.textContent = '这个用户名已被占用，换一个试试'; return; }
    }
    var url = doSignup ? (SB_URL + '/auth/v1/signup') : (SB_URL + '/auth/v1/token?grant_type=password');
    var body = doSignup ? { email: email, password: pass, data: { username: uname, avatar: av } } : { email: email, password: pass };
    var r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json', 'apikey': SB_KEY}, body: JSON.stringify(body) });
    var j = await r.json();
    if(j.access_token){
      // 游客数据不丢弃：保留在本地，登录后由并集合并自动并入账号进度
      if(load('guest', 0)){ store('guest', 0); hideGuestBar(); }
      store('sb_session', {access_token: j.access_token, refresh_token: j.refresh_token, user: j.user});
      if(doSignup) store('profile', { username: uname, avatar: av, user_id: j.user.id });
      msg.textContent = '';
      hideLogin();
      sbRefresh();
      sbEnsureProfile();
      if(doSignup){ sbMsg('注册成功，已自动登录', true); await sbPush(true); }
      else { sbMsg('登录成功，正在同步进度…', true); await sbSyncFromCloud(); sbEnsureProfile(); }
    } else if(doSignup && j.user && !j.error && !j.msg && !j.error_description){
      /* 注册请求已被接受但未直接返回令牌（多为项目开了邮箱验证）。
         自动尝试用刚注册的账号登录：若项目实际允许直接登录则无缝进入；
         若需邮箱验证则给出明确引导，不再误报“注册失败”。 */
      msg.style.color = '#3a6b47';
      msg.textContent = '注册成功，正在自动登录…';
      try{
        var r2 = await fetch(SB_URL + '/auth/v1/token?grant_type=password', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ email: email, password: pass }) });
        var j2 = await r2.json();
        if(j2.access_token){
          store('sb_session', {access_token: j2.access_token, refresh_token: j2.refresh_token, user: j2.user});
          store('profile', { username: uname, avatar: av });
          msg.textContent = '';
          hideLogin();
          sbRefresh();
          sbEnsureProfile();
          sbMsg('注册成功，已自动登录', true);
          await sbPush(true);
          return;
        }
      }catch(e){}
      msg.style.color = '#3a6b47';
      msg.textContent = '注册成功！请去邮箱点击验证链接，验证后回来登录。';
    } else {
      msg.style.color = '';
      msg.textContent = j.msg || j.error_description || (doSignup ? '注册失败，请检查邮箱是否已被注册或稍后再试' : '登录失败（邮箱或密码不对）');
    }
  }catch(e){ msg.textContent = '网络错误：' + e.message; }
}
function sbLogout(){
  localStorage.removeItem('acad_sb_session');
  localStorage.removeItem('chip_profile');
  sbRefresh();
  sbMsg('已退出登录');
  showLogin();
}
async function sbSyncFromCloud(){
  if(!(await sbEnsureToken())){ sbMsg('登录已失效，请重新登录'); return; }
  var h = sbAuthHeaders(); var s = sbSession();
  if(!h || !s){ sbMsg('请先登录'); return; }
  sbMsg('正在同步并合并两端进度…');
  try{
    var r = await fetch(SB_URL + '/rest/v1/progress?select=data&user_id=eq.' + s.user.id, { headers:h });
    var rows = await r.json();
    var d = (rows && rows.length && rows[0].data && rows[0].data.chip) ? rows[0].data.chip : null;
    if(d){
      var merged = mergeProgress(loadAllProgress(), d);
      storeAllProgress(merged);
      migrateLog();
      sbMsg('✅ 已合并两端进度（取并集，不丢数据）', true);
      renderAll(); renderTrace();
      await sbPush(true);
    } else {
      await sbPush(true);
      sbMsg('已把本地进度上传云端', true);
    }
  }catch(e){ sbMsg('同步失败：' + e.message); }
}
var sbTimer = null;
async function sbPush(immediate){
  var s = sbSession();
  if(!s) return;
  if(!immediate){
    clearTimeout(sbTimer);
    sbTimer = setTimeout(function(){ sbPush(true); }, 2000);
    return;
  }
  if(!(await sbEnsureToken())) return;
  try{
    var h = sbAuthHeaders();
    var calc = sbPack();
    var r = await fetch(SB_URL + '/rest/v1/progress?user_id=eq.' + s.user.id, { method:'GET', headers:h });
    var rows = await r.json();
    var data2 = (rows && rows.length && rows[0].data) ? rows[0].data : {};
    if(rows && rows.length && data2.chip){
      // 推送前先与云端最新合并（防止覆盖另一台设备刚推的数据）
      var merged = mergeProgress(calc, data2.chip);
      storeAllProgress(merged);
      data2.chip = merged;
    } else {
      data2.chip = calc;
    }
    var body = { data: data2, updated_at: new Date().toISOString() };
    if(rows && rows.length){
      await fetch(SB_URL + '/rest/v1/progress?user_id=eq.' + s.user.id, { method:'PATCH', headers:h, body: JSON.stringify(body) });
    } else {
      body.user_id = s.user.id;
      await fetch(SB_URL + '/rest/v1/progress', { method:'POST', headers:h, body: JSON.stringify(body) });
    }
    sbPushRank(h, s);
  }catch(e){}
}
function sbPushRank(h, s){
  try{
    var st = calcStats();
    var rank = curRank(st.pct);
    var p = curProfile();
    if(!p) return;
    var rb = { user_id: s.user.id, app: 'calculus', username: p.username, avatar: p.avatar, pct: st.pct, done: Object.keys(quizStat).length, lessons: st.doneL, rank_name: rank.name, updated_at: new Date().toISOString() };
    var hh = Object.assign({}, h, { 'Prefer': 'resolution=merge-duplicates' });
    fetch(SB_URL + '/rest/v1/leaderboard', { method:'POST', headers: hh, body: JSON.stringify(rb) }).catch(function(){});
  }catch(e){}
}
function sbNotify(){ if(sbSession()) sbPush(false); }
/* 切回前台且停留较久时静默同步（覆盖电脑页面长时间挂机的场景） */
var __lastSyncT = Date.now();
document.addEventListener('visibilitychange', function(){
  if(document.visibilityState === 'visible' && sbSession() && Date.now() - __lastSyncT > 180000){
    __lastSyncT = Date.now(); sbSyncFromCloud();
  }
});
function sbRefresh(){
  var box = document.getElementById('sbPanel');
  var s = sbSession();
  var card = document.getElementById('userCard');
  if(card){
    if(s){
      var p = curProfile();
      card.innerHTML = '<div class="uc-ic" style="background:' + avColor(p.avatar) + '2b">' + p.avatar + '</div>'
        + '<div style="min-width:0"><div class="uc-name">' + esc(p.username) + '</div>'
        + '<div class="uc-mail">' + esc(s.user && s.user.email ? s.user.email : '') + '</div></div>';
      card.title = '管理账号与进度';
    } else if(load('guest', 0)){
      card.innerHTML = '<div class="uc-ic">🎮</div><div><div class="uc-name">游客模式</div><div class="uc-hint">点击登录 · 数据仅存本机</div></div>';
      card.title = '登录';
    } else {
      card.innerHTML = '<div class="uc-ic">👤</div><div><div class="uc-name">未登录</div><div class="uc-hint">点击登录 · 管理账号与进度</div></div>';
      card.title = '登录';
    }
  }
  var bars = [document.getElementById('sbStatus'), document.getElementById('sbStatusBar')];
  for(var bi=0; bi<bars.length; bi++){
    var st = bars[bi];
    if(!st) continue;
    if(s){
      var p = curProfile();
      st.className = (st.id === 'sbStatus' ? 'sb-status' : 'sb-statusbar') + ' ok';
      st.innerHTML = '<span class="sb-avatar" style="background:' + avColor(p.avatar) + '">' + p.avatar + '</span>' + esc(p.username);
      st.onclick = function(){ sbSyncFromCloud(); };
    } else {
      st.className = st.id === 'sbStatus' ? 'sb-status' : 'sb-statusbar';
      st.textContent = '☁️ 登录后可多设备同步进度';
      st.onclick = showLogin;
    }
  }
  if(!box) return;
  if(s){
    var p2 = curProfile();
    box.innerHTML = '<div class="sb-user">✅ 已登录：<span class="avatar-circle" style="background:' + avColor(p2.avatar) + '">' + p2.avatar + '</span> <b>' + esc(p2.username) + '</b><span class="sb-email">' + esc(s.user && s.user.email ? s.user.email : '') + '</span></div>'
      + '<div class="sb-actions"><button class="sb-btn primary" onclick="sbSyncFromCloud()">🔄 立即同步</button><button class="sb-btn" onclick="sbLogout()">退出登录</button></div>'
      + '<div class="acc-actions">'
      +   '<button class="acc-btn" onclick="toggleAccForm(\'user\')">✏️ 改用户名</button>'
      +   '<button class="acc-btn" onclick="toggleAccForm(\'avatar\')">🖼 改头像</button>'
      +   '<button class="acc-btn" onclick="toggleAccForm(\'email\')">📧 改邮箱</button>'
      +   '<button class="acc-btn" onclick="toggleAccForm(\'pass\')">🔑 改密码</button>'
      + '</div>'
      + '<div id="accForm"></div>'
      + '<div class="sb-tip">学习进度自动同步到云端，换设备登录即恢复。账号信息（用户名/头像/邮箱/密码）都可在这里修改。</div>';
  } else {
    box.innerHTML = '<div class="sb-tip">未登录。点上方状态条弹出登录窗口；登录后可在此修改用户名、邮箱和密码。</div>';
  }
  var msg = document.getElementById('sbMsg'); if(msg) msg.textContent = '';
}
/* ===== 账号管理 ===== */
var accFormType = null, selAccAvatar = null;
function accMsg2(t, ok){
  var m = document.getElementById('accMsg');
  if(m){ m.textContent = t; m.style.color = ok ? '#3a6b47' : '#8B2C1F'; }
}
function toggleAccForm(t){
  accFormType = (accFormType === t) ? null : t;
  var f = document.getElementById('accForm');
  if(!f) return;
  if(!accFormType){ f.innerHTML = ''; return; }
  var p = curProfile();
  if(t === 'user'){
    f.innerHTML = '<div class="acc-frow"><input id="accName" class="sb-input" maxlength="16" placeholder="新用户名（3~16 位）" onkeydown="if(event.key===\'Enter\') saveUsername()"><button class="sb-btn primary" onclick="saveUsername()">保存</button></div><div class="acc-msg" id="accMsg"></div>';
  } else if(t === 'avatar'){
    selAccAvatar = p.avatar;
    f.innerHTML = '<div class="acc-avgrid">' + AVATARS.map(function(a,i){
      return '<div class="avatar-opt' + (a === p.avatar ? ' sel' : '') + '" onclick="pickAccAvatar(' + i + ')" style="background:' + AV_COLORS[i] + '26">' + a + '</div>';
    }).join('') + '</div><button class="modal-btn fb-send" style="justify-content:center" onclick="saveAvatar()">保存头像</button><div class="acc-msg" id="accMsg"></div>';
  } else if(t === 'email'){
    f.innerHTML = '<div class="acc-frow"><input id="accEmail" class="sb-input" type="email" placeholder="新邮箱" onkeydown="if(event.key===\'Enter\') saveEmail()"><button class="sb-btn primary" onclick="saveEmail()">保存</button></div><div class="acc-tip">修改后请用新邮箱登录；若项目开启了邮箱验证，会先发确认邮件。</div><div class="acc-msg" id="accMsg"></div>';
  } else if(t === 'pass'){
    f.innerHTML = '<div class="acc-frow"><input id="accPass" class="sb-input" type="password" placeholder="新密码（至少 6 位）"><input id="accPass2" class="sb-input" type="password" placeholder="再次输入"></div><button class="modal-btn fb-send" style="justify-content:center" onclick="savePass()">保存新密码</button><div class="acc-msg" id="accMsg"></div>';
  }
}
function pickAccAvatar(i){
  selAccAvatar = AVATARS[i];
  document.querySelectorAll('#accForm .avatar-opt').forEach(function(e,ix){ e.classList.toggle('sel', ix === i); });
}
async function saveUsername(){
  var n = document.getElementById('accName').value.trim();
  if(!/^[\u4e00-\u9fa5A-Za-z0-9_]{3,16}$/.test(n)){ accMsg2('用户名需 3~16 位：中文/字母/数字/下划线', false); return; }
  var s = sbSession(); if(!s){ accMsg2('请先登录', false); return; }
  try{
    var dup = await fetch(SB_URL + '/rest/v1/profiles?select=username&username=eq.' + encodeURIComponent(n), { headers:{ 'apikey': SB_KEY } });
    var rows = await dup.json();
    if(rows && rows.length){ accMsg2('这个用户名已被占用', false); return; }
    var h = sbAuthHeaders();
    var r = await fetch(SB_URL + '/rest/v1/profiles?user_id=eq.' + s.user.id, { method:'PATCH', headers:h, body: JSON.stringify({ username: n }) });
    if(r.ok){
      var p = curProfile();
      store('profile', { username: n, avatar: p.avatar, user_id: s.user.id });
      accMsg2('✅ 用户名已更新', true);
      sbRefresh();
      sbPushRank(sbAuthHeaders(), s);
    } else { accMsg2('更新失败，稍后再试', false); }
  }catch(e){ accMsg2('网络错误：' + e.message, false); }
}
async function saveAvatar(){
  var s = sbSession(); if(!s){ accMsg2('请先登录', false); return; }
  if(!selAccAvatar) return;
  try{
    var h = sbAuthHeaders();
    var r = await fetch(SB_URL + '/rest/v1/profiles?user_id=eq.' + s.user.id, { method:'PATCH', headers:h, body: JSON.stringify({ avatar: selAccAvatar }) });
    if(r.ok){
      var p = curProfile();
      store('profile', { username: p.username, avatar: selAccAvatar, user_id: s.user.id });
      accMsg2('✅ 头像已更新', true);
      sbRefresh();
      sbPushRank(sbAuthHeaders(), s);
    } else { accMsg2('更新失败，稍后再试', false); }
  }catch(e){ accMsg2('网络错误：' + e.message, false); }
}
async function saveEmail(){
  var e = document.getElementById('accEmail').value.trim();
  if(!/\S+@\S+\.\S+/.test(e)){ accMsg2('请输入有效邮箱', false); return; }
  var h = sbAuthHeaders(); if(!h){ accMsg2('请先登录', false); return; }
  try{
    var r = await fetch(SB_URL + '/auth/v1/user', { method:'PUT', headers:h, body: JSON.stringify({ email: e }) });
    var j = await r.json();
    if(r.ok && j.id){
      var s = sbSession();
      if(s && s.user){ s.user.email = e; store('sb_session', s); }
      accMsg2('✅ 邮箱已更新，请用新邮箱登录', true);
      sbRefresh();
    } else { accMsg2(j.msg || '更新失败，邮箱可能已被占用', false); }
  }catch(err){ accMsg2('网络错误：' + err.message, false); }
}
async function savePass(){
  var p1 = document.getElementById('accPass').value, p2 = document.getElementById('accPass2').value;
  if(p1.length < 6){ accMsg2('密码至少 6 位', false); return; }
  if(p1 !== p2){ accMsg2('两次输入的密码不一致', false); return; }
  var h = sbAuthHeaders(); if(!h){ accMsg2('请先登录', false); return; }
  try{
    var r = await fetch(SB_URL + '/auth/v1/user', { method:'PUT', headers:h, body: JSON.stringify({ password: p1 }) });
    var j = await r.json();
    if(r.ok && j.id){
      accMsg2('✅ 密码已更新', true);
      var a1 = document.getElementById('accPass'); if(a1) a1.value = '';
      var a2 = document.getElementById('accPass2'); if(a2) a2.value = '';
    } else { accMsg2(j.msg || '更新失败，请重试', false); }
  }catch(err){ accMsg2('网络错误：' + err.message, false); }
}
/* 启动时静默同步 */
function sbInit(){
  var s = sbSession();
  sbRefresh();
  if(!s){
    if(!load('guest', 0)){ showLogin(); return; }
    showGuestBar();
    return;
  }
  hideGuestBar();
  sbEnsureToken().then(function(ok){
    if(!ok){ sbLogout(); showLogin(); return; }
    hideLogin();
    sbEnsureProfile();
    fetch(SB_URL + '/rest/v1/progress?select=data&user_id=eq.' + sbSession().user.id, { headers: sbAuthHeaders() })
      .then(function(r){ return r.json(); })
      .then(function(rows){
        var d = (rows && rows.length && rows[0].data && rows[0].data.chip) ? rows[0].data.chip : null;
        if(d){
          var merged = mergeProgress(loadAllProgress(), d);
          storeAllProgress(merged);
          migrateLog();
          renderAll();
        }
      }).catch(function(){});
  });
}

/* ================= 排行榜 ================= */
function openRank(){
  document.getElementById('rankModal').style.display = 'flex';
  var w = document.getElementById('rankWrap');
  w.innerHTML = '<div class="rank-empty">加载中…</div>';
  var h = sbAuthHeaders();
  if(!h){ w.innerHTML = '<div class="rank-empty">请先登录再查看排行榜</div>'; return; }
  fetch(SB_URL + '/rest/v1/leaderboard?select=user_id,username,avatar,pct,done,lessons,rank_name&order=pct.desc&app=eq.calculus&limit=100', { headers:h })
    .then(function(r){ return r.json(); })
    .then(function(rows){
      if(!rows || !rows.length){ w.innerHTML = '<div class="rank-empty">还没有人上榜，快去学习成为第一名吧！🧮</div>'; return; }
      var me = sbSession().user.id;
      var medals = ['🥇','🥈','🥉'];
      w.innerHTML = rows.map(function(x,i){
        var isMe = x.user_id === me;
        var no = i < 3 ? '<div class="rank-no top">' + medals[i] + '</div>' : '<div class="rank-no">' + (i+1) + '</div>';
        var name = esc(x.username || '同学'), tag = esc(x.rank_name || '初入书院');
        return '<div class="rank-row' + (isMe ? ' me' : '') + '">' + no
          + '<span class="avatar-circle" style="background:' + avColor(x.avatar) + '">' + x.avatar + '</span>'
          + '<div class="rank-info"><div class="rank-line1"><span class="rn">' + name + '</span><span class="rank-tag">' + tag + '</span>' + (isMe ? '<span class="rank-my">👈 这是你</span>' : '') + '</div>'
          + '<div class="rank-pbar"><i style="width:' + Math.min(100, x.pct || 0) + '%"></i></div>'
          + '<div class="rank-line2">做题 ' + (x.done || 0) + ' 题 · 上课 ' + (x.lessons || 0) + ' 节</div></div>'
          + '<div class="rank-pct">' + (x.pct || 0) + '%</div></div>';
      }).join('');
    })
    .catch(function(){ w.innerHTML = '<div class="rank-empty">加载失败，检查网络后重试</div>'; });
}
function closeRank(){ document.getElementById('rankModal').style.display = 'none'; }

/* ================= 留言 ================= */
var fbPage = 0, fbTotal = 0;
function openFeedback(){
  document.getElementById('fbModal').style.display = 'flex';
  var m = document.getElementById('fbMsg'); if(m) m.textContent = '';
  loadFeedback(true);
}
function closeFeedback(){ document.getElementById('fbModal').style.display = 'none'; }
function loadFeedback(reset){
  if(reset){ fbPage = 0; fbTotal = 0; }
  var list = document.getElementById('fbList');
  var h = sbAuthHeaders();
  if(!h){ list.innerHTML = '<div class="fb-empty">请先登录再留言</div>'; return; }
  if(fbPage === 0) list.innerHTML = '<div class="fb-empty">加载中…</div>';
  fetch(SB_URL + '/rest/v1/feedback?select=username,avatar,content,created_at&order=created_at.desc&app=eq.calculus&offset=' + (fbPage*20) + '&limit=20', { headers:h })
    .then(function(r){
      var cr = r.headers.get('content-range') || '';
      var m = cr.match(/\/(\d+)$/);
      if(m) fbTotal = parseInt(m[1], 10);
      return r.json();
    })
    .then(function(rows){
      var cnt = document.getElementById('fbCount');
      var more = document.getElementById('fbMore');
      if(!rows || !rows.length){
        if(fbPage === 0) list.innerHTML = '<div class="fb-empty">还没有留言，沙发等你来坐 🛋️</div>';
        if(more) more.style.display = 'none';
        if(cnt) cnt.textContent = fbTotal ? ('共 ' + fbTotal + ' 条留言 · 全部实名 · 显示时间') : '';
        return;
      }
      var html = rows.map(function(x){
        return '<div class="fb-item"><span class="avatar-circle" style="background:' + avColor(x.avatar) + '">' + x.avatar + '</span>'
          + '<div class="fb-body"><div class="fb-head">' + esc(x.username || '同学') + '<span class="fb-time">' + fmtTime(x.created_at) + '</span></div>'
          + '<div class="fb-text2">' + esc(x.content) + '</div></div></div>';
      }).join('');
      list.innerHTML = (fbPage === 0 ? '' : list.innerHTML) + html;
      fbPage++;
      if(cnt) cnt.textContent = fbTotal ? ('共 ' + fbTotal + ' 条留言 · 全部实名 · 显示时间') : ('已显示 ' + (fbPage*20) + ' 条');
      if(more) more.style.display = (fbPage*20 < fbTotal) ? 'block' : 'none';
    })
    .catch(function(){ if(fbPage === 0) list.innerHTML = '<div class="fb-empty">加载失败，检查网络后重试</div>'; });
}
async function sendFeedback(){
  var t = document.getElementById('fbText').value.trim();
  var m = document.getElementById('fbMsg');
  if(!t){ if(m){ m.textContent = '写点什么再发送吧'; m.style.color = '#8B2C1F'; } return; }
  var s = sbSession();
  if(!s){ if(m){ m.textContent = '请先登录'; m.style.color = '#8B2C1F'; } return; }
  var p = curProfile();
  if(m){ m.textContent = '发送中…'; m.style.color = '#9a9288'; }
  try{
    var r = await fetch(SB_URL + '/rest/v1/feedback', { method:'POST', headers: sbAuthHeaders(), body: JSON.stringify({ user_id: s.user.id, app: 'calculus', username: p.username, avatar: p.avatar, content: t }) });
    if(r.ok){
      document.getElementById('fbText').value = '';
      if(m){ m.textContent = '已署名送达作者，谢谢你的话 💛'; m.style.color = '#3a6b47'; }
      loadFeedback(true);
    } else if(m){ m.textContent = '发送失败，请确认已登录且网络正常'; m.style.color = '#8B2C1F'; }
  }catch(e){ if(m){ m.textContent = '网络错误：' + e.message; m.style.color = '#8B2C1F'; } }
}
function fmtTime(t){
  if(!t) return '';
  var d = new Date(t), now = new Date();
  var diff = Math.floor((now - d) / 1000);
  var dayStr = (d.getMonth()+1) + '月' + d.getDate() + '日';
  if(diff < 60) return '刚刚 · ' + dayStr;
  if(diff < 3600) return Math.floor(diff/60) + ' 分钟前 · ' + dayStr;
  if(diff < 86400) return Math.floor(diff/3600) + ' 小时前 · ' + dayStr;
  if(diff < 86400*7) return Math.floor(diff/86400) + ' 天前 · ' + dayStr;
  return dayStr;
}
/* ===== 分享 ===== */
function openShare(){
  document.getElementById('shareModal').style.display = 'flex';
  // 学习链接带版本号，绕过浏览器缓存（每次更新学院内容时把 APP_VER +1）
  var pyUrl = 'https://ndshuge.github.io/ndshuge-academy/python.html?v=' + APP_VER;
  var caUrl = 'https://ndshuge.github.io/ndshuge-academy/chip.html?v=' + APP_VER;
  var i1 = document.getElementById('shPySite'), a1 = document.getElementById('shPySiteA');
  var i2 = document.getElementById('shCaSite'), a2 = document.getElementById('shCaSiteA');
  if(i1){ i1.value = pyUrl; }
  if(a1){ a1.href = pyUrl; }
  if(i2){ i2.value = caUrl; }
  if(a2){ a2.href = caUrl; }
}
var APP_VER = 9;
function closeShare(){ document.getElementById('shareModal').style.display = 'none'; }
function copyShare(btn){
  var inp = btn.previousElementSibling;
  if(inp && inp.select) inp.select();
  try{ document.execCommand('copy'); }catch(e){}
  try{ if(inp && inp.value) navigator.clipboard.writeText(inp.value); }catch(e){}
  var old = btn.textContent;
  btn.textContent = '✓ 已复制';
  btn.classList.add('done');
  setTimeout(function(){ btn.textContent = old; btn.classList.remove('done'); }, 1500);
}

