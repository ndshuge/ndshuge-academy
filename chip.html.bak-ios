/* ================= 数学家画像表 ================= */
var PORTRAITS = {};


/* ================= 芯片实验室（与其他学院功能对齐） ================= */
function renderLab(){ drawDope(); drawLitho(); drawYield(); drawMoore(); }
function drawDope(){
  var cv = document.getElementById('cvDope'); if(!cv || !cv.getContext) return;
  var c = cv.getContext('2d'); var d = +document.getElementById('dopeS').value;
  c.clearRect(0,0,cv.width,cv.height);
  var x=40, y=50, w=cv.width-80, h=80; var g=d/10;
  c.fillStyle='rgb('+Math.round(25+200*g)+','+Math.round(70+150*g)+','+Math.round(100+110*g)+')';
  c.fillRect(x,y,w,h); c.strokeStyle='#3fb950'; c.strokeRect(x,y,w,h);
  var n=Math.round(d*9);
  for(var i=0;i<n;i++){ var px=x+22+((i*137)%(w-44)), py=y+14+((i*61)%(h-28));
    c.fillStyle='#8affc1'; c.beginPath(); c.arc(px,py,3,0,7); c.fill(); }
  var label = d===0?'纯硅：绝缘体（电流被挡住）': d<4?'轻掺杂：半导体（电流开始流动）': d<8?'中等掺杂：导电性大增':'重掺杂：接近导体（但失去开关能力）';
  c.fillStyle='#d8e1ea'; c.font='15px sans-serif'; c.fillText(label, x, y-14);
  c.fillStyle='#7d8896'; c.font='12px sans-serif'; c.fillText('掺杂（doping）：向硅里掺入杂质，改变导电性', x, y+h+28);
  var st=document.getElementById('stDope');
  st.textContent = d===0?'硅像玻璃一样堵住电流——半导体平时是「断」的。': d<4?'掺入杂质后电流能流动了：材料从「死」变「可控」。': d<8?'导电性大增——但别太重，太重就变导体了。':'重掺杂让硅几乎成了导体，但也失去了「开关」能力——开关需要可控，不是全通。';
}
function drawLitho(){
  var cv=document.getElementById('cvLitho'); if(!cv || !cv.getContext) return;
  var c=cv.getContext('2d'); var t=+document.getElementById('lithoS').value;
  c.clearRect(0,0,cv.width,cv.height);
  c.fillStyle='#537D96'; c.fillRect(40,30,210,140);
  c.fillStyle='#FBF7EE'; c.fillRect(80,55,55,35); c.fillRect(155,90,60,45);
  c.fillStyle='#d8e1ea'; c.font='13px sans-serif'; c.fillText('掩模（不透光，开窗透光）', 40, 188);
  c.fillStyle='#e3b341';
  for(var i=0;i<6;i++){ var ax=265, ay=45+i*22; c.beginPath(); c.moveTo(ax,ay); c.lineTo(ax+46,ay); c.lineTo(ax+36,ay-5); c.moveTo(ax+46,ay); c.lineTo(ax+36,ay+5); c.fill(); }
  c.fillStyle='#d8e1ea'; c.font='12px sans-serif'; c.fillText('光', 280, 14);
  var x=360,y=30,w=240,h=140;
  c.fillStyle='#1a212b'; c.fillRect(x,y,w,h);
  var ex=t/100;
  c.fillStyle='rgba(227,179,65,'+(0.25+0.65*ex)+')'; c.fillRect(x,y,w*ex,h);
  c.strokeStyle='#3fb950'; c.strokeRect(x,y,w,h);
  c.fillStyle='#d8e1ea'; c.font='13px sans-serif'; c.fillText('晶圆 + 光刻胶（左→右曝光）', x, y+h+22);
  var st=document.getElementById('stLitho');
  st.textContent = t<30?'光刚照上，光刻胶还没反应。': t<70?'曝光区光刻胶开始变性：光正在把掩模的图案「印」上晶圆。':'显影完成！被光照到的胶溶解，掩模图案转移到了晶圆上——photolithography，用光印刷。';
}
function drawYield(){
  var cv=document.getElementById('cvYield'); if(!cv || !cv.getContext) return;
  var c=cv.getContext('2d'); var dust=+document.getElementById('yieldS').value;
  c.clearRect(0,0,cv.width,cv.height);
  var cx=cv.width/2, cy=cv.height/2+5, R=135;
  c.fillStyle='#1a212b'; c.beginPath(); c.arc(cx,cy,R,0,7); c.fill();
  c.strokeStyle='#2b3440'; c.stroke();
  var n=5, cell=R*1.85/n, dead=0, total=n*n;
  for(var i=0;i<n;i++) for(var j=0;j<n;j++){
    var px=cx-R*0.92+i*cell, py=cy-R*0.92+j*cell;
    var hit = Math.random() < (dust/100)*(0.5+0.5*Math.random());
    if(hit) dead++;
    c.fillStyle = hit ? '#f85149' : '#3fb950';
    c.fillRect(px+2,py+2,cell-4,cell-4);
  }
  var yp=Math.round((total-dead)/total*100);
  c.fillStyle='#d8e1ea'; c.font='16px sans-serif'; c.fillText('良率 '+(total-dead)+'/'+total+' = '+yp+'%', cx-80, cy+R+28);
  var st=document.getElementById('stYield');
  st.textContent = dust<20?'晶圆很干净，芯片大多存活。': dust<50?'灰尘开始砸中芯片——一粒灰毁一颗芯。': '看这堆红色坏片：这就是为什么芯片厂的无尘室比手术室还干净，也是良率决定芯片成本的原因。';
}
function drawMoore(){
  var cv=document.getElementById('cvMoore'); if(!cv || !cv.getContext) return;
  var c=cv.getContext('2d'); var yr=+document.getElementById('mooreS').value;
  c.clearRect(0,0,cv.width,cv.height);
  var x0=50,y0=cv.height-36,w=cv.width-70,h=cv.height-66;
  c.strokeStyle='#2b3440'; c.strokeRect(x0,y0-h,w,h);
  c.fillStyle='#7d8896'; c.font='12px sans-serif';
  c.fillText('1965', x0, y0+16); c.fillText('2020', x0+w-30, y0+16);
  c.fillText('晶体管数（对数刻度）', x0, 14);
  var MAXLOG=Math.log10(Math.pow(2,27.5));
  c.strokeStyle='#3fb950'; c.lineWidth=2; c.beginPath();
  for(var x=0;x<=w;x++){
    var yy=1965+x/w*(2020-1965);
    var logv=Math.log10(Math.pow(2,(yy-1965)/2))/MAXLOG;
    var px=x0+x, py=y0-logv*h;
    if(x===0) c.moveTo(px,py); else c.lineTo(px,py);
  }
  c.stroke();
  var v=Math.pow(2,(yr-1965)/2), log2=Math.log10(v)/MAXLOG;
  var px2=x0+(yr-1965)/(2020-1965)*w, py2=y0-log2*h;
  c.fillStyle='#e3b341'; c.beginPath(); c.arc(px2,py2,6,0,7); c.fill();
  c.fillStyle='#d8e1ea'; c.font='14px sans-serif';
  var txt = yr+' 年 ≈ '+ (v>=1e9?(v/1e9).toFixed(1)+'B': v>=1e6?(v/1e6).toFixed(1)+'M': v>=1e3?(v/1e3).toFixed(1)+'K': v.toFixed(0)) +' 个晶体管';
  c.fillText(txt, x0, y0-h-10);
  var st=document.getElementById('stMoore');
  st.textContent = '摩尔定律：元件数约每两年翻一倍。指数增长在头几年不起眼，后来越来越陡——1965 年的预测，跑了半个世纪。';
}
function labBind(id, fn){ var el=document.getElementById(id); if(el){ el.addEventListener('input', fn); try{ fn.call(el); }catch(e){} } }
labBind('dopeS', function(){ var d=document.getElementById('dopeV'); if(d) d.textContent=this.value; drawDope(); });
labBind('lithoS', function(){ var d=document.getElementById('lithoV'); if(d) d.textContent=this.value; drawLitho(); });
labBind('yieldS', function(){ var d=document.getElementById('yieldV'); if(d) d.textContent=this.value; drawYield(); });
labBind('mooreS', function(){ var d=document.getElementById('mooreV'); if(d) d.textContent=this.value; drawMoore(); });
renderLab();
</script>

<!-- 强制登录层 -->
<div id="loginOverlay" class="login-overlay" style="display:none">
  <div class="login-card">
    <div class="login-logo">💾</div>
    <div class="login-title">🐭 鼠哥的芯片战争读书学院 🧠</div>
    <div class="login-sub">登录后开始学习 · 进度多设备自动同步</div>
    <div class="login-share">🔗 所有学院账号互通：注册一个账号，所有学院通用，进度各自独立</div>
    <div class="login-tabs">
      <button class="login-tab on" id="tabLogin" onclick="loginMode(false)">登 录</button>
      <button class="login-tab" id="tabSignup" onclick="loginMode(true)">注 册</button>
    </div>
    <input id="loginName" class="sb-input" style="display:none" type="text" maxlength="16" placeholder="用户名（3~16 位，中文/字母/数字/下划线）" onkeydown="if(event.key==='Enter') loginDo()">
    <input id="loginEmail" class="sb-input" type="email" placeholder="邮箱" onkeydown="if(event.key==='Enter') loginDo()" oninput="hintToggle(this,'loginHint')">
    <div class="login-hint" id="loginHint">📧 选一个常用邮箱，另外想一个好记的密码</div>
    <input id="loginPass" class="sb-input" type="password" placeholder="密码（至少 6 位）" onkeydown="if(event.key==='Enter') loginDo()" oninput="hintToggle(this,'loginWarn')">
    <div class="login-warn" id="loginWarn">⚠️ 密码不要设置和其他平台一样哦</div>
    <div class="avatar-pick" id="avatarPick" style="display:none">选一个头像</div>
    <div class="avatar-grid" id="avatarGrid" style="display:none"></div>
    <div class="login-actions">
      <button class="login-btn primary" id="loginBtnMain" onclick="loginDo()">登 录</button>
    </div>
    <div class="login-forgot-row">
      <button class="login-btn link" id="loginForgot" onclick="showForgot()">忘记密码？</button>
      <button class="login-btn link" id="loginBack" style="display:none" onclick="backToLogin()">← 返回登录</button>
    </div>
    <div id="loginMsg" class="login-msg"></div>
    <div class="login-tip" id="loginTip">第一次用点「注册」，之后自动登录。同一账号，手机电脑进度同步。</div>
    <div class="guest-entry" id="guestEntry">
      <button class="guest-btn" onclick="enterGuest()">🎮 先体验一下（游客模式）</button>
      <div class="guest-note">游客数据保存在这台设备的浏览器里；登录或注册账号后会自动并入云端进度。未登录期间不跨设备同步，清理浏览器数据可能丢失。</div>
    </div>
    <div id="resetBlock" style="display:none">
      <div class="login-title" style="font-size:16px; margin-top:2px">🔑 设置新密码</div>
      <div class="login-sub">为你的账号设置一个新密码</div>
      <input id="resetPass" class="sb-input" type="password" placeholder="新密码（至少 6 位）" onkeydown="if(event.key==='Enter') doReset()">
      <input id="resetPass2" class="sb-input" type="password" placeholder="再次输入新密码" onkeydown="if(event.key==='Enter') doReset()">
      <button class="login-btn primary" onclick="doReset()">更新密码</button>
      <div id="resetMsg" class="login-msg"></div>
    </div>
  </div>
</div>

<!-- 排行榜弹窗 -->
<div class="modal-mask" id="rankModal" style="display:none" onclick="closeRank()">
  <div class="modal-card wide" onclick="event.stopPropagation()">
    <div class="modal-head">🏆 学习排行榜<button class="modal-x" onclick="closeRank()">✕</button></div>
    <div class="modal-body">
      <div class="rank-wrap" id="rankWrap"><div class="rank-empty">加载中…</div></div>
    </div>
  </div>
</div>
<!-- 留言弹窗 -->
<div class="modal-mask" id="fbModal" style="display:none" onclick="closeFeedback()">
  <div class="modal-card wide" onclick="event.stopPropagation()">
    <div class="modal-head">💬 给作者留言<button class="modal-x" onclick="closeFeedback()">✕</button></div>
    <div class="modal-body">
      <textarea id="fbText" class="fb-text" maxlength="300" placeholder="建议、想说的话、遇到的坑…（300 字以内）"></textarea>
      <button class="modal-btn fb-send" onclick="sendFeedback()">发送留言</button>
      <div id="fbMsg" class="sb-msg"></div>
      <div class="fb-count" id="fbCount"></div>
      <div class="fb-list" id="fbList"><div class="fb-empty">加载中…</div></div>
      <button class="modal-btn fb-more" id="fbMore" style="display:none" onclick="loadFeedback(false)">加载更多留言</button>
    </div>
  </div>
</div>
<!-- 分享弹窗 -->
<div class="modal-mask" id="shareModal" style="display:none" onclick="closeShare()">
  <div class="modal-card wide" onclick="event.stopPropagation()">
    <div class="modal-head">📤 分享学院<button class="modal-x" onclick="closeShare()">✕</button></div>
    <div class="modal-body">
      <div class="share-intro">把学院分享给同学，一起学 🐭🧠</div>
      <div class="share-item">
        <div class="share-name">🐍 Python 学院</div>
        <div class="share-row"><span class="share-label">📖 学习链接</span><input class="share-inp" id="shPySite" readonly onclick="this.select()"><button class="share-copy" onclick="copyShare(this)">复制</button><a class="share-open" id="shPySiteA" target="_blank" rel="noopener">打开 ↗</a></div>
        <div class="share-row"><span class="share-label">📦 仓库</span><input class="share-inp" readonly value="https://github.com/ndshuge/ndshuge-academy" onclick="this.select()"><button class="share-copy" onclick="copyShare(this)">复制</button><a class="share-open" href="https://github.com/ndshuge/ndshuge-academy" target="_blank" rel="noopener">打开 ↗</a></div>
      </div>
      <div class="share-item">
        <div class="share-name">🧮 芯片战争学院</div>
        <div class="share-row"><span class="share-label">📖 学习链接</span><input class="share-inp" id="shCaSite" readonly onclick="this.select()"><button class="share-copy" onclick="copyShare(this)">复制</button><a class="share-open" id="shCaSiteA" target="_blank" rel="noopener">打开 ↗</a></div>
        <div class="share-row"><span class="share-label">📦 仓库</span><input class="share-inp" readonly value="https://github.com/ndshuge/ndshuge-academy" onclick="this.select()"><button class="share-copy" onclick="copyShare(this)">复制</button><a class="share-open" href="https://github.com/ndshuge/ndshuge-academy" target="_blank" rel="noopener">打开 ↗</a></div>
      </div>
      <div class="share-tip">所有学院账号互通：注册一个账号，所有学院都能用，进度各自独立。</div>
    </div>
  </div>
</div>

</body>
</html>
